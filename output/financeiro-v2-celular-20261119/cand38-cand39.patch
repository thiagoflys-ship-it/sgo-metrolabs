+/* =====================================================================
+   19/11/2026 (noite): Financeiro no celular, depois das fotos do iPhone do dono (texto em pé letra por letra, valores uns sobre os
+   outros, rótulo espremido ao lado do campo). Causa: três camadas de regras se somavam dentro de #omieTela no modo celular:
+   (1) UI_Estilos põe "overflow-wrap: anywhere" em todo o #conteudo do modo celular; isso deixa a largura mínima de cada palavra em
+       UMA letra, e toda coluna de tabela, item de grade ou de linha flexível que se ajusta ao conteúdo encolhe até uma letra;
+   (2) JS_Omie.html transforma toda tabela de #omieTela em cartão (td em bloco) e todo rótulo em linha (rótulo | campo | explicação);
+   (3) o cartão compacto da etapa (a) (tr em grade com !important) pegava também as tabelas de números (fv-rolar), que deviam rolar.
+   Aqui, só dentro do Financeiro (#omieTela) e só no modo celular do SGO+ (#app.modo-mobile, o mesmo critério do JS_Core: até 900 px
+   ou celular deitado), vale UMA regra por tipo:
+   (a) tabela de números (fv-rolar: DRE, "Ver em tabela" dos gráficos): continua tabela, rola para o lado DENTRO da caixa, 1ª coluna
+       fixa com 120 a 170 px e quebra por palavra, valores à direita numa linha só;
+   (b) lista operacional (fv-cartoes: contas de Empresas e bancos, regras, histórico): cartão com título, pares rótulo/valor e
+       controles na largura toda, com 44 px de toque;
+   (c) rótulo de campo com caixa de texto ou lista: o nome em cima, o campo embaixo, a explicação embaixo do campo.
+   Nada aqui parte palavra em letras: overflow-wrap volta a "break-word" (só parte o que não cabe na linha, sem encolher colunas).
+   ===================================================================== */
+#app.modo-mobile #omieTela { overflow-wrap: break-word; word-break: normal; }
+#app.modo-mobile #omieTela td, #app.modo-mobile #omieTela th { overflow-wrap: break-word; word-break: normal; }
+/* (c) rótulos: em cima do campo */
+#app.modo-mobile #omieTela label:has(> input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]), > select, > textarea) {
+  display: flex; flex-direction: column; align-items: stretch; gap: 4px; flex: 1 1 100%; min-width: 0; max-width: 100%; white-space: normal; }
+#app.modo-mobile #omieTela label:has(> input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]), > select, > textarea) > :is(input, select, textarea) { width: 100%; min-width: 0; box-sizing: border-box; }
+#app.modo-mobile #omieTela label > .omie-dica { margin-top: 0; }
+#app.modo-mobile #omieTela label.omie-check { white-space: normal; }
+/* (a) tabela de números: rola dentro da caixa */
+#app.modo-mobile #omieTela .fv-rolar { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
+#app.modo-mobile #omieTela .fv-rolar > table { display: table; width: max-content; min-width: 100%; max-width: none; border-collapse: separate; border-spacing: 0; table-layout: auto; }
+#app.modo-mobile #omieTela .fv-rolar thead { display: table-header-group; }
+#app.modo-mobile #omieTela .fv-rolar tbody { display: table-row-group; }
+#app.modo-mobile #omieTela .fv-rolar tfoot { display: table-footer-group; }
+#app.modo-mobile #omieTela .fv-rolar tr { display: table-row !important; border: 0; border-radius: 0; margin: 0; padding: 0; background: transparent; position: static; }
+#app.modo-mobile #omieTela .fv-rolar th, #app.modo-mobile #omieTela .fv-rolar td { display: table-cell; width: auto; min-width: 0; padding: 7px 10px; border: 0; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; vertical-align: top; font-size: 12.5px; }
+#app.modo-mobile #omieTela .fv-rolar td.n, #app.modo-mobile #omieTela .fv-rolar th.n { text-align: right !important; white-space: nowrap; font-variant-numeric: tabular-nums; }
+#app.modo-mobile #omieTela .fv-rolar td::before, #app.modo-mobile #omieTela .fv-rolar td[data-r]::before { content: none !important; display: none !important; }
+#app.modo-mobile #omieTela .fv-rolar th:first-child, #app.modo-mobile #omieTela .fv-rolar td:first-child { position: sticky; left: 0; z-index: 1; background: var(--card); min-width: 120px; max-width: 170px; white-space: normal; box-shadow: 1px 0 0 var(--border); }
+#app.modo-mobile #omieTela .fv-rolar thead th:first-child { z-index: 2; background: var(--bc-surface-2); }
+/* (b) lista operacional: cartão */
+#app.modo-mobile #omieTela .fv-cartoes { border: 0; background: transparent; overflow: visible; }
+#app.modo-mobile #omieTela .fv-cartoes > table, #app.modo-mobile #omieTela .fv-cartoes tbody { display: block; width: 100%; }
+#app.modo-mobile #omieTela .fv-cartoes thead { display: none; }
+#app.modo-mobile #omieTela .fv-cartoes tbody tr { display: grid !important; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px 12px; position: relative; margin: 0 0 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
+#app.modo-mobile #omieTela .fv-cartoes tbody td { display: block; width: auto; min-width: 0; padding: 0; border: 0; text-align: left !important; white-space: normal; font-size: 13px; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td[data-r]::before { display: block; content: attr(data-r); margin: 0 0 2px; font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
+#app.modo-mobile #omieTela .fv-cartoes tbody td.m-titulo, #app.modo-mobile #omieTela .fv-cartoes tbody td.m-valor, #app.modo-mobile #omieTela .fv-cartoes tbody td.m-largo { grid-column: 1 / -1; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td.m-titulo { font-size: 14px; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td.m-titulo::before, #app.modo-mobile #omieTela .fv-cartoes tbody td.m-valor::before { content: none; display: none; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td :is(select, input[type="text"], input:not([type]), textarea) { display: block; width: 100%; min-width: 0; min-height: 44px; box-sizing: border-box; font-size: 16px; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td label.omie-check { display: flex; align-items: center; gap: 10px; min-height: 44px; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td label.omie-check input { width: 22px; height: 22px; flex: 0 0 auto; }
+#app.modo-mobile #omieTela .fv-cartoes tbody td .fv-sugestao, #app.modo-mobile #omieTela .fv-cartoes tbody td .cm-selo { display: inline-block; margin-top: 4px; white-space: normal; }
+/* lista de contas (Painel e Bancos): o saldo vai para baixo do nome, sem cobrir o selo do conector */
+#app.modo-mobile #omieTela .fv-conta { grid-template-columns: 34px minmax(0, 1fr); align-items: start; }
+#app.modo-mobile #omieTela .fv-conta .s { grid-column: 2; text-align: left; white-space: normal; }
+#app.modo-mobile #omieTela .fv-conta .s small { display: inline; margin-left: 6px; }
+#app.modo-mobile #omieTela .fv-conta .n, #app.modo-mobile #omieTela .fv-conta .m { overflow-wrap: break-word; }
+/* lista de nomes de chaves (Empresas e bancos): não é texto corrido; justificada, os nomes longos abriam buracos na linha */
+#app.modo-mobile #omieTela .fv-integ-item :is(ul, li) { text-align: left; }
 </style>
