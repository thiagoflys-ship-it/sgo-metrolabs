         (OMIE_OPS_UI.aba === 'cobrancas' ? '<button class="cadx-btn" type="button" onclick="OmieOps_boleto_(' + id + ')">Ver boleto</button> <button class="cadx-btn" type="button" onclick="OmieOps_form_(\'gerarBoleto\',' + id + ')">Gerar</button> <button class="cadx-btn" type="button" onclick="OmieOps_form_(\'prorrogarBoleto\',' + id + ')">Prorrogar</button>' : (i.fechado ? '<span class="cadx-sub">Sem ação: título ' + OmieOps_esc_(String(i.situacao || '').toLowerCase()) + '</span>' : (i.rateio ? '<span class="cadx-sub">Com rateio: altere no Omie</span> ' : '<button class="cadx-btn" type="button" onclick="OmieOps_form_(\'editar\',' + id + ')">Editar</button> ') + '<button class="cadx-btn" type="button" onclick="OmieOps_form_(\'baixar\',' + id + ')">Registrar baixa</button>')) + (i.aprovacao && !i.fechado && OMIE_OPS_UI.aba !== 'cobrancas' ? '<br><span class="cadx-sub omie-aprov' + (i.aprovacao.liberado ? ' is-ok' : '') + '">' + OmieOps_esc_(i.aprovacao.texto) + '</span>' : '') + '</td></tr>';
