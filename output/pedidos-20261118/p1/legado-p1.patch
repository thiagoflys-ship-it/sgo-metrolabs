+    lista.innerHTML = resumoPer + (!r.itens.length ? '<div class="cadx-vazio bc-vazio">' + (r.periodo ? OmieOps_esc_('Nenhum título desta situação vence no período (' + r.periodo.texto + '). Mude as datas ou a situação.') : 'Nenhum título nesta situação.') + '</div>' : '<div style="overflow-x:auto"><table class="cadx-tabela"><thead><tr><th>Documento</th><th>Cliente ou fornecedor</th><th>Vencimento</th><th>Valor</th><th>Situação</th><th>Ações</th></tr></thead><tbody>' + r.itens.map(function (i) {
