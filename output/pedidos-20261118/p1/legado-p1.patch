@@ -633,6 +633,7 @@
         { situacao: "Aviso da gestão com \"WhatsApp aguardando modelo\"", oQueFazer: "O modelo sgo_gestao_acao ainda não foi aprovado pela Meta. O e-mail já saiu. Cadastre em Chaves e senhas > Cadastrar modelos na Meta e acompanhe em Situação dos modelos." },
         { situacao: "Qual modelo do WhatsApp a fila da gestão usa", oQueFazer: "Desde 11/11/2026: o sgo_gestao_item (Utilidade) quando a Meta o aprovou e o manteve na categoria Utilidade; senão o sgo_gestao_acao (que a Meta classificou como Marketing e pode não entregar). Confira em Chaves e senhas > Situação dos modelos; o registro de cada aviso diz o modelo usado." },
         { situacao: "A Diretoria não recebe mais GS03 (escalada) item a item", oQueFazer: "Decisão do dono de 11/11/2026: a Diretoria é informada, não cobrada. Com o resumo diário da Diretoria ligado (Caixa de decisões > Regras e responsáveis, padrão 08:30), a escalada, a decisão nova e o prazo vencido em que a Diretoria aparece e as escaladas da SEDNA vão num resumo por dia útil (evento GS07: e-mail com a lista e o link do relatório diário da empresa, WhatsApp curto pelo modelo de utilidade e alerta na tela). GS04, GS05, GS06 e os atos irreversíveis continuam na hora." },
+        { situacao: "Compras e preço do Comercial a qualquer hora (GS08 a GS11)", oQueFazer: "Decisão do dono de 18/11/2026: cada nova solicitação de compra (GS08), o prazo do dono e da Diretoria vencido com o aprovador delegado já podendo decidir (GS09), a decisão do aprovador delegado (GS10) e cada pedido de aprovação de preço do Comercial (GS11) vão na hora, a qualquer hora, inclusive fora do expediente, só para o dono, a Diretoria e o aprovador delegado (Matheus), por WhatsApp e e-mail e no alerta na tela. É a única exceção à regra do WhatsApp no expediente. Para desligar o WhatsApp a qualquer hora, use Compras > Regras de compras ou Comercial > Metodologia (quadro do aprovador delegado); desligar a linha na matriz deixa o aviso só no sistema e no e-mail." },
         { situacao: "Pedido que depende da Diretoria (GS06)", oQueFazer: "Preço do catálogo, preço abaixo do mínimo, compra a aprovar e proposta enviada sem a aprovação de preço chegam na hora aos dois da Diretoria (e-mail, WhatsApp e alerta na tela), menos quem pediu. Para desligar, use a linha GS06 da matriz: o alerta na tela e o e-mail pela regra comum continuam." },
         { situacao: "Aviso da gestão com \"Sem celular no cadastro\"", oQueFazer: "Complete o celular da pessoa em Administração > Usuários. O e-mail já saiu." },
         { situacao: "Uma pessoa diz que não recebeu o WhatsApp de resumo", oQueFazer: "Em \"Resumos do dia\", veja o motivo: PJ ou vínculo não informado, já abriu o sistema, nada para hoje, fora do piloto ou desligado por ela em Meus avisos." },
diff -ruN cand25/SGO_Ajuda_Comercial.js cand26/SGO_Ajuda_Comercial.js
--- cand25/SGO_Ajuda_Comercial.js	2026-11-18 11:51:13.664195500 -0300
+++ cand26/SGO_Ajuda_Comercial.js	2026-11-18 13:38:31.705921400 -0300
@@ -126,6 +126,7 @@
         { titulo: 'Legendas e cenários prontos da viagem (desde 13/11/2026)', itens: ['Cada linha de "Ver a conta linha por linha e ajustar" tem a legenda com o "i": a primeira frase diz a conta da linha (por exemplo, "Km rodado = valor por km da regra do estado de origem × km de ida e volta"). Toque nela para abrir o "Como preencher": o que é, de onde vem o valor, quando mudar, quando marcar "Não se aplica" e um exemplo com os valores da política em vigor.', 'Transporte, Viagens e O.S. previstas também têm legenda: toque em "Ver" para saber o que muda em cada transporte (para não cobrar o combustível junto com o km) e a diferença entre viagens e O.S.', 'Em "Como o custo entra no preço", toque em "Ver o exemplo e quando usar cada um": a conta dos dois modos com o caso real da PROP-2026-0071.', 'Para começar de um caso comum, informe o destino e o km (botão "Calcular km e pedágio") e toque em "Aplicar um cenário pronto".', 'Escolha o cenário: a) cidade próxima, sem pernoite; b) viagem com pernoite, 1 técnico; c) 2 técnicos, vários dias, acima de 200 km; d) contrato com várias visitas; e) Rio de Janeiro; f) transporte aéreo.', 'Ajuste as quantidades que aparecem (técnicos, engenheiros, dias, noites, viagens e O.S. previstas). No avião, informe também as passagens e as horas de viagem.', 'Toque em "Aplicar e calcular". O cenário preenche as quantidades e o transporte, devolve as linhas à regra e salva o rascunho. Confira cada linha e mude o que for diferente: tudo continua editável.', 'O cenário não muda nenhuma regra nem o preço dos serviços: a conta é a mesma que você faria preenchendo à mão.', 'No fim do bloco da viagem fica a aba "Guia da viagem: o que significa cada linha e o que fazer": toque nela para ver o passo a passo, cada linha da conta (o que significa, a conta, o que fazer e um exemplo) e os erros comuns. É o mesmo guia da equipe, dentro da tela.'] },
         { titulo: 'Deslocamento (passo 2)', itens: ['Diga se há viagem. Não: escreva o motivo.', 'Sim: escolha a cidade de destino (a lista vem da tabela de distâncias do Programa de conduta e já traz o km), os dias, as noites, quantos técnicos e engenheiros vão e o pedágio (0 se não há).', 'Escolha a unidade que emite a nota: Goiânia (padrão) ou Rio de Janeiro. Ela muda os impostos e a sede de onde a distância é medida (no Rio, digite o km a partir da sede do Rio).', 'O sistema calcula o km rodado, o Incentivo de Missão (R$ 300 por executante em trecho de 200 km ou mais a partir da sede), a alimentação, o hotel e as horas de estrada, e o custo vira o item "Despesas de deslocamento e estadia" (custo mais impostos, sem margem e sem desconto). A antiga taxa por viagem de R$ 300 foi removida pelo dono (era o Incentivo de Missão). Toque em "Calcular (salva o rascunho)".', 'Se precisar digitar outro preço para o deslocamento, use "Preço do deslocamento na proposta". Abaixo do custo da viagem a tela avisa em vermelho: a empresa estaria pagando para ir.', 'Transporte diferente do veículo da empresa, várias viagens ou um valor diferente: abra "Ver a conta linha por linha e ajustar".'] },
         { titulo: 'Preço mínimo, preço sugerido e as opções (passo 4)', itens: ['No passo 4 aparece cada item com o seu preço, o preço mínimo (o que garante a sobra mínima da política) e o preço sugerido (o da margem alvo), e onde o seu preço está: abaixo do mínimo, entre o mínimo e o sugerido, ou no sugerido ou acima. A equipe comercial vê o mínimo e o sugerido em reais; a gestão vê também o custo e a sobra.', 'Abaixo aparecem o total, a situação da sobra, o desconto sobre a tabela e a sua alçada, e o efeito do desconto geral na sobra.', 'As opções: "Usar preço sugerido" (sobe ao sugerido os itens abaixo dele e mostra o novo total), "Ajustar para o mínimo" (só os itens abaixo do mínimo), "Manter meu preço e pedir autorização" (você escreve o motivo; a faixa mostra quem aprova e o que será aprovado) e, no item sem custo válido, "Pedir atualização do custo".', 'Os botões nunca baixam preço e só mudam o rascunho; o histórico da proposta registra o que mudou.'] },
+        { titulo: 'Preço fora da política: o aprovador delegado (decisão do dono de 18/11/2026)', itens: ['Proposta que só a Diretoria aprova (sobra abaixo da mínima, item sem custo válido, custo sem cotação, preço do catálogo não aprovado) chega na hora ao dono, à Diretoria e ao Matheus, por WhatsApp e e-mail, a qualquer hora.', 'Na proposta, o quadro "Prazo do dono e da Diretoria" mostra até quando vai o prazo (padrão: 15 minutos desde o pedido), quanto falta e o critério de preço, cumprido ou o que falta.', 'Vencido o prazo sem decisão, o Matheus toca em "Autorizar (aprovador delegado)" se nenhum item estiver abaixo do preço mínimo do catálogo e o custo de todos os itens for conferível (sem desconto máximo definido pelo dono; com ele, o desconto sobre a tabela até esse percentual).', 'Ele não autoriza proposta da qual é o responsável nem o pedido que ele mesmo fez. A autorização fica no histórico com o critério e avisa o dono e a Diretoria.'] },
         { titulo: 'Montar e concluir', itens: ['Toque em "Acrescentar item" e comece a digitar o nome ou o código no campo "Produto ou serviço": aparecem os itens ativos do catálogo (Produtos e serviços). Escolha um (toque, ou setas e Enter): código, tipo, descrição, unidade e preço de tabela entram sozinhos. O botão "Do catálogo" abre a mesma busca numa janela.', 'Item que não está no catálogo fica "Avulso (fora do catálogo)": escreva a descrição e o preço. Para desligar um item do catálogo, toque em "Tornar avulso".', 'O preço pode ser ajustado. Diferente da tabela, o item mostra "Abaixo da tabela" (conta como desconto na política) ou "Acima da tabela", e o preço de tabela e o praticado ficam no histórico da proposta.', 'A descrição (escopo) é opcional: escreva só o que for específico desta proposta. Os termos e condições da contratação já vão fixos no documento.', 'Confira o "Tipo de orçamento": Serviço, Produto ou Serviço e produto (misto). Sem escolha, vale o automático pelos itens. O tipo muda os dizeres do documento (apresentação, prazo e local, responsabilidades e aceite); ao trocar, o rascunho é salvo e os textos padrão passam para o modelo escolhido, e o que você escreveu fica.', 'Confira as condições (pagamento, prazo, garantia) e a validade.', 'Preencha "Custos da viagem e do frete" (próximo passo). Sem esse checklist a proposta não conclui.', 'Toque em "Revisão da gestora" para ver o que impede o envio e os alertas.', 'Toque em "Concluir". Dentro da política, a proposta fica pronta; acima do limite de desconto, informe o motivo e ela vai para a aprovação do gestor comercial (Caixa de decisões); abaixo da margem mínima da política de precificação, ela vai para a Diretoria.', 'Item sem custo (item do catálogo sem custo cadastrado ou item avulso) e item com o preço do catálogo ainda não aprovado também levam a proposta para a Diretoria: sem o custo o sistema não confere o preço mínimo que garante a sobra. O passo 4 avisa antes de concluir ("Vai para a Caixa de decisões ao concluir"). Para não depender da aprovação, peça à gestão comercial ou ao Financeiro o custo do item em Produtos e serviços e conclua de novo.', 'A conta usa o custo de hoje no catálogo. A aprovação vale para o que foi aprovado: se depois o custo sobe e a sobra fica abaixo da mínima, ou se os itens mudam, o envio é barrado com a faixa "Preço a conferir antes do envio": toque em "Voltar para rascunho" e conclua de novo.'] },
         { titulo: 'Custos da viagem e do frete (checklist obrigatório)', itens: ['Em "Há viagem para executar o serviço?", escolha Sim ou Não. Não: escreva o motivo (por exemplo "serviço no laboratório da Metrolabs").', 'Sim: informe quantos técnicos e quantos engenheiros vão, o transporte, o destino (a cidade da unidade já vem preenchida) e o km do trecho, só a ida. Quando o destino está na tabela de distâncias do Programa de conduta, o km vem sozinho.', 'Informe viagens (mais de uma para contrato com visitas), dias e noites por viagem.', 'Informe as "O.S. previstas" (visitas que o contrato prevê). Desde 13/11/2026 o Incentivo de Missão conta uma vez por O.S. e por executante, não por viagem nem por dia: contrato com 3 visitas = 3 missões; uma O.S. com duas idas = 1 missão; duas O.S. na mesma viagem = 1 missão. Com mais de uma viagem o campo é obrigatório. A frase abaixo do campo do preço mostra a conta (valor x executantes x missões) e a distância usada.', 'A distância que vale para o incentivo é a cadastral do cliente (tabela do Programa de conduta, medida da sede), quando existe: o km digitado da viagem serve para o km rodado. A 200 km ou mais a linha do incentivo é obrigatória, não aceita "não se aplica" e não aceita valor abaixo do programa, nem com motivo (MAN-VIA-001; proposta sem a linha é a ocorrência COM-02).', 'A Metrolabs não paga diária a colaboradores (Diretoria, 13/11/2026): a linha "Diárias" fica sempre "não se aplica", sem campo de valor, e a estadia entra pela alimentação e pelo hotel. Diária digitada antes em rascunho sai da conta ao calcular de novo.', 'Em cada linha (km rodado, pedágios, alimentação, hospedagem, Incentivo de Missão, combustível adicional ou passagem), deixe o valor da política (em branco, aparece a dica cinza), digite o valor desta viagem ou marque "Não se aplica" com o motivo. O sistema marca sozinho o que os fatos mandam: 0 km, sem pernoite, trecho abaixo do mínimo da Conduta (200 km), veículo da empresa (o km já cobre o combustível).', 'Item separado ou diluído: escolha como o custo entra no preço. Os dois modos cobram o mesmo valor (custo da viagem mais impostos, sem margem, sem comissão e sem desconto, fora da conta da sobra) e dão o mesmo total. Item separado: o cliente vê a linha "Despesas de deslocamento e estadia". Diluído: o cliente não vê essa linha; o valor é distribuído no preço dos serviços (proporcional ao valor de cada um), e o documento e o link mostram cada serviço já com a sua parte. O resumo junto ao campo mostra o custo, os impostos, quanto foi para o preço e o total ao cliente; no diluído, também a tabela com o preço digitado, a parte da viagem e o preço que o cliente vê. Trocar o modo nunca baixa o total nem cria desconto.', 'Proposta com produto: informe o custo do frete e da entrega ou marque "Não se aplica" com o motivo (por exemplo "cliente retira").', 'Toque em "Calcular (salva o rascunho)": aparecem o custo de cada linha, o total, o item da proposta e o que falta no checklist.'] },
         { titulo: 'Nova proposta guiada (passo a passo)', itens: ['Em Propostas, toque em "Nova proposta guiada" (ou em Hoje > Novo orçamento > Proposta guiada). São seis passos; a trilha no topo mostra onde você está e o "Voltar" não perde o que foi feito.', '1. Cliente: se o cliente mandou e-mail ou mensagem, abra "Colar o e-mail" e toque em "Ler o texto": o CNPJ, os contatos e os equipamentos escritos no texto ficam prontos para usar (o que não estava escrito é descartado). Procure pelo CNPJ: cliente existente aparece com o que falta no cadastro, as propostas e os serviços dele e os possíveis cadastros repetidos; cliente novo vem com os dados da consulta às bases públicas para você conferir com o cliente, completar (e-mail para nota, responsável, telefone), marcar "Ciente" e cadastrar.', '2. Unidade de execução: onde ficam os equipamentos e onde o serviço é feito (pode ser outro hospital, atendido pela empresa que contrata). Escolha ou cadastre (nome, endereço, cidade, UF e "Ciente"). A unidade mostra as propostas e os serviços já feitos nela.', '3. Responsáveis: o responsável técnico (engenharia clínica) recebe o orçamento e precisa de nome completo, cargo, e-mail e telefone; o financeiro precisa do e-mail para nota e cobrança; o intermediário ou indicador é opcional, só interno, com a comissão pedida e o motivo (a Diretoria decide). Contatos repetidos aparecem com o aviso: a gestão comercial toca em "Juntar" (escolhe qual fica; as propostas passam para ele); o vendedor toca em "Pedir para juntar".', '4. Equipamentos: marque os da unidade ou cadastre. "Ler a foto da plaqueta" preenche tipo, marca, modelo, série, capacidade e ano para você conferir (os campos lidos ficam destacados). Sem o número de série agora, o equipamento entra no cadastro como "série a confirmar"; a proposta pede a série antes de emitir.', '5. Serviços: para cada equipamento, o serviço (qualificação completa ou só QI, QO ou QD; NR-13; calibração), os ciclos ou programas (botões com os mais comuns) e a carga. "Sugerir serviços e insumos" aponta o serviço da tabela oficial e os insumos do catálogo (Bowie-Dick, indicadores); confirme ou troque. Serviço que não está no catálogo: "Pedir o cadastro do serviço" (código, nome, preço proposto e descrição); a proposta pode ser montada, mas só é emitida depois da aprovação da gestão comercial.', '6. Montar: confira o resumo, escolha a origem e toque em "Montar a proposta". Ela abre em rascunho, ligada ao cliente, à unidade, ao responsável técnico e aos equipamentos. Depois: deslocamento, escopo com a especialista e o quadro "Faltam dados para emitir".', 'Sem a chave da IA, a leitura da plaqueta e do e-mail ficam desligadas (o e-mail ainda é lido pelas regras: CNPJ, e-mails, telefones e CEP) e a sugestão de serviço segue as regras do catálogo. Tudo funciona à mão.'] },
@@ -398,6 +399,7 @@
       passos: [
         { titulo: 'Mudar uma regra (tabelas)', itens: ['Escolha a página no topo.', 'Funis, cadência, estratégias, objeções e listas são tabelas: uma linha por item. Toque em "+ adicionar" para uma linha nova e em "Remover" para tirar.', 'Escreva o que mudou e por quê e toque em "Salvar". A versão anterior fica em "Versões" e a gestora passa a usar a nova.'] },
         { titulo: 'Preço e desconto (Diretoria e Administrador)', itens: ['Cada campo diz o que é. Os marcados "valor provisório" ainda dependem do dono; o sistema já funciona com eles.', 'Ao lado aparece a regra do preço em linguagem simples, com o exemplo da qualificação de autoclave refeito na hora a cada número que você muda.', 'Sobra mínima: uma só (35%, decisão do dono), depois de impostos, comissão e custos diretos, antes de IR e CSLL. Abaixo dela a proposta vai para a Caixa de decisões e só a Diretoria aprova.', 'Impostos por unidade que emite a nota (Goiânia e Rio, Lucro Real): PIS, COFINS e ISS para serviço; PIS, COFINS, ICMS e FECP para produto, menos os créditos sobre o custo de compra. ISS e ICMS da compra são provisórios até o contador confirmar.', 'Bônus Coletivo diluído na hora: a página mostra a conta (bônus x colaboradores ativos ÷ horas faturáveis = R$ por hora). Deixe as horas em branco para o sistema usar 140 h por colaborador de campo ou informe o número real.', 'Quadro "Decisão do dono de 01/11/2026": veja a prévia da política e aplique (versão nova, campo a campo; o que a Diretoria gravou de diferente fica); depois veja a prévia dos preços e aplique (lote de reajuste, só sobe, com "Desfazer o último reajuste").', 'Faixas de prazo: prazo em dias úteis e acréscimo de cada faixa; a Prioritária fica desligada até o dono aprovar. Escolha se o prazo conta até a entrega do relatório (padrão) ou até a execução.', 'Quando o dono confirmar um valor, marque em "O que o dono já confirmou".'] },
+        { titulo: 'Aprovador delegado do preço (só o dono e a Diretoria alteram)', itens: ['No topo da Metodologia, abra o quadro "Aprovador delegado do preço fora da política".', 'Escolha se fica ligado, quem autoriza depois do prazo (padrão: a conta interna "MATHEUS GODOI", da gestão comercial), o prazo em minutos (padrão 15) e o desconto máximo sobre a tabela que ele autoriza (vazio, o padrão: ele não autoriza abaixo do preço mínimo do catálogo).', 'Escolha se os três recebem WhatsApp a qualquer hora e confira o celular de cada um em "Quem recebe estes avisos".', 'Escreva o que mudou e por quê e toque em "Salvar a regra do aprovador delegado": cada versão fica com o motivo.'] },
         { titulo: 'Critérios para avançar de etapa', itens: ['Em "Como vendemos", marque o que o sistema exige para uma oportunidade avançar: confirmar a lista da etapa, decisor mapeado, contato registrado, proposta enviada e aceite para a etapa de 100%.', 'A lista de cada etapa é a coluna "Lista da etapa" da tabela do funil (um item por linha).'] }
       ],
       cores: [{ nome: 'Selo laranja "valor provisório"', significado: 'Valor inicial da tabela de preços que o dono ainda vai confirmar.' }],
diff -ruN cand25/SGO_Ajuda_Compras.js cand26/SGO_Ajuda_Compras.js
--- cand25/SGO_Ajuda_Compras.js	2026-11-18 12:12:30.752431800 -0300
+++ cand26/SGO_Ajuda_Compras.js	2026-11-18 13:38:16.085529900 -0300
@@ -78,6 +78,7 @@
         { titulo: 'Lançar os orçamentos', itens: ['Na ficha de um pedido "Em cotação", toque em "Lançar orçamento".', 'Escolha o fornecedor.', 'Digite o preço unitário de cada item, o frete e os impostos que não estão no preço. O total é calculado pelo sistema.', 'Informe o prazo de entrega, a validade, o número do orçamento e a condição de pagamento.', 'Para peça, diga se é original, equivalente ou a confirmar.', 'Anexe o arquivo do orçamento (obrigatório) e toque em "Salvar o orçamento".', 'Repita para cada fornecedor. Para trocar algo, toque em "Corrigir"; para tirar da comparação, "Retirar" com o motivo.'] },
         { titulo: 'Escolher o orçamento', itens: ['Toque em "Escolher este orçamento" no orçamento vencedor.', 'Se não for o mais barato, escreva o motivo.', 'Se a faixa pede mais cotações do que há, escreva a justificativa (por exemplo, fornecedor único).', 'Na faixa do comprador (até R$ 1.000 no padrão), a sua escolha já é a aprovação registrada.', 'Nas outras faixas, a compra vai para a Caixa de decisões de quem aprova.'] },
         { titulo: 'Aprovar ou reprovar (quem tem a alçada)', itens: ['Decisão do dono (16/11/2026): no começo, só o dono do sistema e a Diretoria aprovam compras, em qualquer faixa (Chaves e senhas > Regras do Financeiro > Aprovação só do dono e da Diretoria). Gestores e comprador acompanham, mas não aprovam; nem a faixa do comprador é aprovada na escolha do orçamento. Quem pediu nunca aprova a própria compra: se o pedido for do dono, aprova a Diretoria, e vice-versa.', 'Abra a compra pela Caixa de decisões ou pela fila (aba "Aguardando aprovação").', 'Confira os orçamentos, os arquivos e as justificativas.', 'Toque em "Aprovar" (observação opcional) ou em "Reprovar" e escreva o motivo.', 'Aprovada: o comprador recebe a atividade para fazer o pedido. Reprovada: volta para cotação com o motivo.'] },
+        { titulo: 'Aprovador delegado depois do prazo (decisão do dono de 18/11/2026)', itens: ['O pedido vai à aprovação com 3 orçamentos de fornecedores diferentes, cada um com o arquivo. Com menos, o comprador justifica e só o dono e a Diretoria decidem.', 'Na ficha, o quadro "Prazo do dono e da Diretoria" mostra até quando vai o prazo (padrão: 30 minutos desde a postagem do pedido), quanto falta e cada critério cumprido ou o que falta.', 'Vencido o prazo sem decisão, o Matheus (aprovador delegado) aprova, reprova ou toca em "Pedir novo orçamento", se houver 3 orçamentos válidos, o escolhido for o mais em conta ou justificado, ele não tiver pedido nem cotado e o valor couber no teto (vazio = sem teto).', '"Pedir novo orçamento": escolha o fornecedor do cadastro ou escreva o contato e o que pedir. A compra volta para cotação e o comprador recebe a atividade.', 'Toda decisão do aprovador delegado fica no histórico com o critério e avisa o dono e a Diretoria na hora.'] },
         { titulo: 'Fazer o pedido ao fornecedor', itens: ['Na ficha de uma compra "Aprovada", toque em "Emitir o pedido de compra".', 'Informe a previsão de entrega combinada e a forma de pagamento (cartão com os 4 últimos números e as parcelas, PIX, boleto com vencimento, transferência, faturado com a condição ou reembolso).', 'Toque em "Emitir o pedido". Sai a folha A4 numerada (PC-ano-número) na pasta Compras - Pedidos de compra.', 'Toque em "Enviar ao fornecedor": o e-mail para pedidos do fornecedor já vem sugerido.', 'Depois de enviar, toque em "Já enviei: atualizar".'] },
         { titulo: 'Mudar a previsão ou o pedido', itens: ['Toque em "Mudar previsão ou rastreio", informe a data nova e o motivo. Quem pediu vê a data nova.', 'Para mudar o próprio pedido (quantidade, forma de pagamento), toque em "Nova revisão do pedido" e escreva o que mudou. Sai a revisão 01, 02...'] },
         { titulo: 'Receber e conferir', itens: ['Quando a compra chegar, toque em "Registrar o recebimento".', 'Conte e informe a quantidade recebida de cada item.', 'Marque se a especificação confere e se chegou sem dano.', 'Informe o número da nota fiscal (ou o motivo de vir sem nota).', 'Com dano, anexe a foto. Com qualquer divergência, descreva o que aconteceu.', 'Sem divergência, a peça fica "Disponível" e quem pediu é avisado. Com divergência, fica segura até você tocar em "Divergência resolvida".'] },
@@ -99,6 +100,8 @@
         { situacao: 'Aparece "Você não tem a permissão «Cotar e comprar»" (ou «Ver a fila e o painel de compras», «Ver valores de compras e fornecedores», «Gestão de Compras», «Alterar as regras de compras», «Dar ciência de compra fora do fluxo»).', oQueFazer: 'Essa caixa foi tirada da sua conta em Administração > Acessos, mesmo que o seu nome esteja na lista de compradores. Se você precisa fazer isso, peça ao responsável pelo sistema para rever a caixa. Sem alteração gravada vale a lista de compradores e substitutos de Regras de compras, como sempre.' },
         { situacao: 'Aparece "Você não tem a permissão «Aprovar compra até o limite do comprador»" (ou «… da própria área», «… acima de todas as faixas»).', oQueFazer: 'A compra é da faixa indicada (o valor escolhido define a faixa, pelas Regras de compras) e a caixa daquela faixa foi tirada da sua conta em Administração > Acessos. A mensagem diz quem aprova. A caixa diz se a pessoa aprova; o valor máximo de cada faixa continua nas Regras de compras.' },
         { situacao: 'A lista está vazia (Fila, Conferência do Financeiro, A pagar).', oQueFazer: 'A mensagem da lista diz o que trocar: outra situação nas abas do alto (ou «Todas»), outro mês, o final do cartão apagado ou, em A pagar, «Pagos nos últimos 60 dias» em Mostrar.' },
+        { situacao: 'Aparece "O prazo do dono e da Diretoria vai até ... (faltam ...)".', oQueFazer: 'Você é o aprovador delegado e o prazo do dono e da Diretoria ainda corre. A contagem na ficha mostra quanto falta. Vencido o prazo sem decisão, você recebe o WhatsApp e pode decidir.' },
+        { situacao: 'Aparece "O prazo do dono e da Diretoria venceu, mas falta cumprir: ...".', oQueFazer: 'Faltam orçamentos válidos (fornecedor, valor e arquivo), a justificativa da escolha ou o valor passa do teto. O comprador lança o que falta; até lá, só o dono e a Diretoria decidem.' },
         { situacao: 'O botão "iniciar cotação" não aparece.', oQueFazer: 'A especificação está incompleta ou foi devolvida. Complete pelo botão "Editar a especificação" ou espere quem pediu completar.' },
         { situacao: 'Aparece "anexe o arquivo do orçamento".', oQueFazer: 'Só conta orçamento com a prova do preço. Salve o e-mail ou o PDF do fornecedor (ou tire foto) e anexe.' },
         { situacao: 'Aparece "Você não aprova esta compra: por decisão do dono, no começo só o dono do sistema e a Diretoria aprovam".', oQueFazer: 'Nada foi alterado. A compra está na Caixa de decisões do dono e da Diretoria; acompanhe pela ficha. As faixas de aprovação voltam a valer quando a configuração mudar para "Não".' },
@@ -163,6 +166,7 @@
         { situacao: 'Aparece "tire a foto do comprovante".', oQueFazer: 'O comprovante é obrigatório. Toque no campo, tire a foto ou escolha o PDF e envie de novo.' },
         { situacao: 'Aparece "cada pessoa informa as próprias compras".', oQueFazer: 'Peça a quem comprou para informar pelo celular. O comprador, o Financeiro e a gestão podem informar em nome de outra pessoa.' },
         { situacao: 'Aparece "a compra é de ... mais de 90 dias atrás".', oQueFazer: 'Compra tão antiga é informada pelo Financeiro. Envie o comprovante a ele.' },
+        { situacao: 'Aparecem as duas perguntas: por que só agora e a compra parecida (por exemplo, uma para a matriz e outra para a filial).', oQueFazer: 'Responda as duas, com pelo menos 10 letras cada, e toque de novo em "Enviar ao Financeiro". As respostas ficam na tela até o envio; a compra grava e as respostas vão para o Financeiro e para o histórico. Para não ser perguntado de novo, escolha "Para onde vai a compra" (matriz ou filial): compras iguais para destinos diferentes não são acusadas.' },
         { situacao: 'O cartão não aparece na lista.', oQueFazer: 'Digite os 4 últimos números assim mesmo. Quando o cartão for cadastrado, a compra se liga a ele sozinha.' }
       ],
       quemPode: [
@@ -242,9 +246,11 @@
       passos: [
         { titulo: 'Escolher o comprador e o substituto', itens: ['Marque o comprador na primeira lista.', 'Marque o substituto na segunda lista.', 'Escreva o motivo e toque em "Salvar as regras".'] },
         { titulo: 'Mudar uma faixa', itens: ['Altere o valor "até", quem aprova ou as cotações mínimas.', 'Escreva o motivo e toque em "Salvar as regras".', 'Vale para as próximas escolhas de orçamento.'] },
+        { titulo: 'Aprovador delegado (só o dono e a Diretoria alteram)', itens: ['No quadro "Aprovador delegado", escolha se fica ligado, quem decide depois do prazo (padrão: a conta interna "MATHEUS GODOI"), o prazo em minutos (padrão 30) e de onde ele conta (postagem do pedido, padrão).', 'Ajuste o mínimo de orçamentos para ir à aprovação (padrão 3) e o teto de valor do delegado (vazio = sem teto).', 'Escolha se o dono, a Diretoria e o delegado recebem WhatsApp a qualquer hora (cada nova solicitação, o prazo vencido e a decisão do delegado).', 'Confira, em "Quem recebe estes avisos", o celular de cada um: quem está "sem telefone" recebe só pelo sistema e pelo e-mail.', 'Escreva o motivo e toque em "Salvar as regras".'] },
         { titulo: 'Compra informada depois de feita', itens: ['No quadro "Compra informada depois de feita", ajuste o limite da compra direta (acima dele, ciência da gestão), o prazo para informar, o prazo do reembolso e quando a cobrança do não informado vai por e-mail e à Caixa de decisões.', 'Escreva o motivo e salve.'] }
       ],
-      problemas: [{ situacao: 'Aparece "os valores das faixas precisam crescer".', oQueFazer: 'Cada faixa precisa ter o valor maior que a anterior. A última faixa não tem teto.' }],
+      problemas: [{ situacao: 'Aparece "os valores das faixas precisam crescer".', oQueFazer: 'Cada faixa precisa ter o valor maior que a anterior. A última faixa não tem teto.' },
+        { situacao: 'Aparece "as regras do aprovador delegado ... só o dono e a Diretoria alteram".', oQueFazer: 'Desfaça a mudança no quadro "Aprovador delegado" e salve as demais regras, ou peça ao dono ou ao Charles para fazer a mudança.' }],
       quemPode: quem,
       perguntas: [{ p: 'Quem aprova quando o próprio comprador pediu a compra?', r: 'Quem pediu não aprova a própria compra. Na faixa do comprador, aprova o substituto; sem ele, o gestor da área.' }]
