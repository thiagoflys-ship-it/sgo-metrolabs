+++ cand29/SGO_RecargaCaju_Semanal.js	2026-11-18 17:20:53.713621300 -0300
@@ -0,0 +1,160 @@
+/****************************************************
+ * RECARGA CAJU DA ROTINA — RECARGA SEMANAL COM A PROGRAMAÇÃO DA SEMANA (18/11/2026, pacote 4, item 13)
+ *
+ * Pedido do Matheus (17/11/2026, 22:50): "Preciso que implemente o modo de recarga semanal do flash e que ele precise declarar a
+ * possível programação da semana." O "flash" é a recarga do cartão de benefício (Caju) da rotina. Fica DENTRO da Recarga Caju (bloco C)
+ * como um tipo de pedido, sem módulo novo: o mesmo portador, termo, aprovação, carga, prestação gasto a gasto, conferência, período e
+ * devolução da sobra.
+ *
+ *  - O técnico (ou o coordenador por ele, que ainda é o portador do cartão) escolhe a semana (segunda a domingo) e declara a programação
+ *    prevista: para cada dia, a cidade, o cliente, a O.S. ou atividade, a finalidade e o valor previsto. "Puxar da agenda" traz as O.S.
+ *    do SGO+ e os atendimentos do Auvo já agendados para a pessoa na semana (só leitura; nada é gravado na agenda).
+ *  - O valor NÃO é digitado: é a soma do previsto, menos o saldo da rotina que já está no cartão (política semanalDescontarSaldo, ligada
+ *    por padrão: "economizar nas recargas"). Se o saldo cobre a semana, o pedido é recusado com a explicação.
+ *  - Aprovação: SEMPRE do dono e da Diretoria (regra do Financeiro), qualquer que seja o limite; quem pede não aprova.
+ *  - Política (RCJ_POLITICA, com versão e motivo): semanalLigado (sim), semanalTeto e semanalValorDia VAZIOS (decisão do dono: "é
+ *    solicitado e devolvemos"; nenhum valor inventado), semanalDescontarSaldo (sim).
+ *  - Fim da semana: previsto × realizado (gastos lançados com data na semana, por dia e por finalidade, e o que ainda falta comprovar do
+ *    extrato), na tela do portador e na gestão. A sobra volta no fechamento do período, como em toda recarga.
+ *
+ * Ordem de carga: só funções e constantes literais; usa Rcj_* e Via_* na hora da chamada. Nenhuma função devolve Date cru.
+ ****************************************************/
+
+var RCJ_SEMANAL_MAX_ITENS = 60;
+var RCJ_SEMANAL_SEMANAS_A_FRENTE = 6;
+var RCJ_DIAS_SEMANA = ['domingo', 'segunda', 'terça', 'quarta', 'quinta', 'sexta', 'sábado'];
+var RCJ_MOTIVO_SEMANAL = 'recarga semanal: só o dono e a Diretoria aprovam (regra do Financeiro)';
+
+/** { de (segunda), ate (domingo), nome } da semana em que o dia cai. */
+function Rcj_semanaDe_(dia) {
+  dia = Via_dia_(dia);
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(dia)) return null;
+  var p = dia.split('-').map(Number), dow = new Date(Date.UTC(p[0], p[1] - 1, p[2])).getUTCDay(), de = Via_somarDias_(dia, -((dow + 6) % 7)), ate = Via_somarDias_(de, 6);
+  return { de: de, ate: ate, nome: 'semana de ' + Via_brDia_(de) + ' a ' + Via_brDia_(ate) };
+}
+function Rcj_diaSemanaNome_(dia) { var p = Via_dia_(dia).split('-').map(Number); return RCJ_DIAS_SEMANA[new Date(Date.UTC(p[0], p[1] - 1, p[2])).getUTCDay()]; }
+
+/**
+ * O.S. do SGO+ e atendimentos do Auvo agendados para a pessoa na semana (só leitura). [{ dia, cliente, ref, atividade, endereco, fonte }].
+ * Usa a fonte única da Assistência (SGO_Atendimentos_linhas_) quando existe; senão, lê ATEC_OS direto. Nunca lança.
+ */
+function Rcj_agendaSemana_(uid, de, ate) {
+  var out = [];
+  try {
+    var linhas = typeof SGO_Atendimentos_linhas_ === 'function' ? SGO_Atendimentos_linhas_({}) : Via_ler_('ATEC_OS').filter(function (o) { return !Via_s_(o.EXCLUIDO_EM); }).map(function (o) {
+      return { ORIGEM: 'SGO', TECNICO_ID_SGO: o.TECNICO_ID, DATA_TAREFA: o.AGENDADO_PARA, CLIENTE_NOME_AUVO: o.CLIENTE_NOME, TIPO_TAREFA: o.TIPO_NOME, AUVO_TASK_ID: o.NUMERO, ENDERECO: o.ENDERECO, CANCELADA: Via_up_(o.SITUACAO) === 'CANCELADA' ? 'SIM' : '' };
+    });
+    linhas.forEach(function (t) {
+      var dia = Via_dia_(t.DATA_TAREFA);
+      if (Via_s_(t.TECNICO_ID_SGO) !== Via_s_(uid) || !dia || dia < de || dia > ate || Via_up_(t.CANCELADA) === 'SIM') return;
+      out.push({ dia: dia, diaTxt: Via_brDia_(dia) + ' (' + Rcj_diaSemanaNome_(dia) + ')', cliente: Via_s_(t.CLIENTE_NOME_AUVO), ref: (Via_up_(t.ORIGEM) === 'AUVO' ? 'Auvo ' : 'O.S. ') + Via_s_(t.AUVO_TASK_ID),
+        atividade: Via_s_(t.TIPO_TAREFA) || 'Atendimento', endereco: Via_s_(t.ENDERECO), fonte: Via_up_(t.ORIGEM) === 'AUVO' ? 'AUVO' : 'SGO' });
+    });
+  } catch (e) { out = []; }
+  return out.sort(function (a, b) { return a.dia.localeCompare(b.dia) || a.ref.localeCompare(b.ref); }).slice(0, RCJ_SEMANAL_MAX_ITENS);
+}
+/** Tela do portador: a agenda da semana escolhida (sempre a da própria pessoa, pela sessão). */
+function Rcj_agendaSemanaApi_(eu, d) {
+  Via_exigir_(eu, 'RECARGA_USAR', 'ver a agenda da semana', 'Peça ao Financeiro para habilitar o seu cartão Caju na rotina (Painel financeiro > Recarga Caju > Portadores).');
+  var sem = Rcj_semanaDe_(d && d.semana) || Rcj_semanaDe_(Via_hoje_());
+  var itens = Rcj_agendaSemana_(eu.id, sem.de, sem.ate);
+  return { semana: sem, itens: itens, mensagem: itens.length ? Via_plural_(itens.length, 'atendimento agendado', 'atendimentos agendados') + ' para você na ' + sem.nome + '. Confira, diga a cidade e o valor previsto de cada um.' : 'Nenhuma O.S. ou atendimento do Auvo agendado para você na ' + sem.nome + '. Declare a programação prevista à mão.' };
+}
+
+/** Programação da tela -> itens limpos e as faltas (o quê e o que fazer). */
+function Rcj_programacaoLimpa_(lista, sem, pol) {
+  var faltas = [], itens = [];
+  (Array.isArray(lista) ? lista : []).slice(0, RCJ_SEMANAL_MAX_ITENS + 1).forEach(function (x, i) {
+    x = x || {};
+    var n = i + 1, dia = Via_dia_(x.dia), fin = Via_up_(x.finalidade), v = Via_num_(x.valor);
+    var it = { dia: dia, cidade: Via_texto_(x.cidade, 80), uf: Via_up_(x.uf).slice(0, 2), cliente: Via_texto_(x.cliente, 120), ref: Via_texto_(x.ref, 60), atividade: Via_texto_(x.atividade, 200),
+      finalidade: fin, valor: v !== null ? Via_r2_(v) : null, origem: Via_up_(x.origem) === 'AGENDA' ? 'AGENDA' : 'DECLARADO' };
+    if (!dia || dia < sem.de || dia > sem.ate) faltas.push('Item ' + n + ': escolha um dia da ' + sem.nome + '.');
+    if (Via_letras_(it.cidade) < 2) faltas.push('Item ' + n + ': escreva a cidade.');
+    if (Via_letras_(it.cliente + it.atividade) < 5) faltas.push('Item ' + n + ': diga o cliente ou a atividade prevista (5 letras ou mais).');
+    if (pol.finalidades.indexOf(fin) < 0) faltas.push('Item ' + n + ': escolha a finalidade do gasto previsto.');
+    if (v === null || v < 0) faltas.push('Item ' + n + ': informe o valor previsto em reais (zero, se o item não tem gasto).');
+    itens.push(it);
+  });
+  if (!itens.length) faltas.push('Declare a programação prevista da semana: pelo menos um dia, com a cidade, o cliente ou a atividade e o valor previsto. "Puxar da minha agenda" traz as O.S. já agendadas.');
+  if (itens.length > RCJ_SEMANAL_MAX_ITENS) faltas.push('A programação passa de ' + RCJ_SEMANAL_MAX_ITENS + ' itens. Junte os itens do mesmo dia e da mesma cidade.');
+  return { itens: itens.slice(0, RCJ_SEMANAL_MAX_ITENS), faltas: faltas };
+}
+/** Saldo da rotina que já está no cartão (pelo extrato importado; sem extrato, pelo que foi lançado no SGO+). */
+function Rcj_saldoRotina_(uid) {
+  var sx = Rcj_saldoExtrato_(uid);
+  if (sx) return { valor: Via_r2_(sx.saldo), base: 'extrato do Caju importado até ' + Via_brDia_(sx.ate) };
+  return { valor: Via_r2_(Rcj_contas_(uid).saldoSgo), base: 'o que foi lançado no SGO+ (o extrato do Caju ainda não foi importado)' };
+}
+/**
+ * Monta o pedido semanal: { semana, itens, previsto, saldo, valor, justificativa, finalidades, motivos }. Recusa com o quê, por quê e o
+ * que fazer. d: { semana (qualquer dia da semana), programacao: [...], observacao }.
+ */
+function Rcj_semanalMontar_(eu, d, pol) {
+  if (!pol.semanalLigado) throw new Error('Não foi possível pedir a recarga semanal: a política da recarga está com a recarga semanal desligada. Use o pedido avulso ou peça ao Financeiro para ligar em Painel financeiro > Recarga Caju > Política.');
+  var sem = Rcj_semanaDe_(d.semana);
+  if (!sem) throw new Error('Não foi possível pedir a recarga semanal: escolha a semana (qualquer dia dela).');
+  var atual = Rcj_semanaDe_(Via_hoje_());
+  if (sem.de < atual.de) throw new Error('Não foi possível pedir a recarga semanal: a ' + sem.nome + ' já passou. Escolha a semana atual ou uma das próximas.');
+  if (sem.de > Via_somarDias_(atual.de, 7 * RCJ_SEMANAL_SEMANAS_A_FRENTE)) throw new Error('Não foi possível pedir a recarga semanal: a ' + sem.nome + ' está a mais de ' + RCJ_SEMANAL_SEMANAS_A_FRENTE + ' semanas. Peça mais perto da semana, com a programação já definida.');
+  var prog = Rcj_programacaoLimpa_(d.programacao, sem, pol);
+  if (prog.faltas.length) throw new Error('Não foi possível pedir a recarga semanal: ' + prog.faltas.slice(0, 6).join(' ') + (prog.faltas.length > 6 ? ' E mais ' + (prog.faltas.length - 6) + ' item(ns).' : ''));
+  var previsto = Via_r2_(prog.itens.reduce(function (s, x) { return s + (x.valor || 0); }, 0));
+  if (!(previsto > 0)) throw new Error('Não foi possível pedir a recarga semanal: a programação não prevê nenhum gasto (soma R$ 0,00). Sem gasto previsto, não há recarga a pedir.');
+  var obs = Via_texto_(d.observacao, 600), motivos = [RCJ_MOTIVO_SEMANAL];
+  if (pol.semanalTeto && Via_cent_(previsto) > Via_cent_(pol.semanalTeto)) {
+    if (Via_letras_(obs) < RCJ_JUSTIFICATIVA_MIN) throw new Error('Não foi possível pedir a recarga semanal: o previsto (' + Rcj_m_(previsto) + ') passa do teto semanal da política (' + Rcj_m_(pol.semanalTeto) + '). Escreva na observação por que (' + RCJ_JUSTIFICATIVA_MIN + ' letras ou mais) ou ajuste a programação.');
+    motivos.push('previsto acima do teto semanal (' + Rcj_m_(pol.semanalTeto) + ')');
+  }
+  var saldo = pol.semanalDescontarSaldo ? Rcj_saldoRotina_(eu.id) : { valor: 0, base: '' }, desc = Math.max(0, saldo.valor);
+  var valor = Via_r2_(previsto - desc);
+  if (!(valor > 0)) throw new Error('Não é preciso recarga nesta semana: o saldo da rotina no seu cartão (' + Rcj_m_(desc) + ', pelo ' + saldo.base + ') já cobre a programação de ' + Rcj_m_(previsto) + '. Use o saldo; se a programação crescer, peça de novo com os itens novos.');
+  var dias = {}; prog.itens.forEach(function (x) { dias[x.dia] = true; });
+  var fins = prog.itens.map(function (x) { return x.finalidade; }).filter(function (c, i, l) { return l.indexOf(c) === i; });
+  var just = 'Recarga semanal da ' + sem.nome + ': ' + Via_plural_(prog.itens.length, 'item', 'itens') + ' em ' + Via_plural_(Object.keys(dias).length, 'dia', 'dias') + ' (' +
+    prog.itens.slice(0, 4).map(function (x) { return Via_brDia_(x.dia).slice(0, 5) + ' ' + x.cidade + (x.cliente ? ', ' + x.cliente : '') + (x.ref ? ' (' + x.ref + ')' : ''); }).join('; ') + (prog.itens.length > 4 ? '; e mais ' + (prog.itens.length - 4) : '') +
+    '). Previsto ' + Rcj_m_(previsto) + (desc > 0 ? ', menos o saldo de ' + Rcj_m_(desc) + ' já no cartão' : '') + ' = ' + Rcj_m_(valor) + '.' + (obs ? ' Observação: ' + obs : '');
+  return { semana: sem, itens: prog.itens, previsto: previsto, saldo: desc, saldoBase: saldo.base, valor: valor, justificativa: just.slice(0, 800), finalidades: fins, motivos: motivos, observacao: obs };
+}
+/** Um pedido semanal por semana (menos os negados e cancelados). Chamar dentro da trava. */
+function Rcj_semanalSemRepetir_(uid, sem, reenvioId) {
+  var outro = Rcj_solicitacoes_().filter(function (r) {
+    return Via_s_(r.USUARIO_ID) === Via_s_(uid) && Via_up_(r.TIPO) === 'SEMANAL' && Via_dia_(r.SEMANA_DE) === sem.de && Via_s_(r.ID) !== Via_s_(reenvioId) && ['NEGADA', 'CANCELADA'].indexOf(Via_up_(r.SITUACAO)) < 0;
+  })[0];
+  if (outro) throw new Error('Não foi possível pedir: já existe a recarga semanal ' + Via_s_(outro.NUMERO) + ' para a ' + sem.nome + ' (' + (RCJ_SITUACOES[Via_up_(outro.SITUACAO)] || outro.SITUACAO).toLowerCase() + '). Se a programação mudou, faça um pedido avulso com a justificativa da diferença.');
+}
+
