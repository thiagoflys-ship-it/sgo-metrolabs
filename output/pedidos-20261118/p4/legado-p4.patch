+    itens: prog.map(function (x) { var ref = Via_up_(x.ref).replace(/^(O\.S\.|AUVO)\s*/, ''); return { diaTxt: Via_brDia_(x.dia), cidade: Via_s_(x.cidade), cliente: Via_s_(x.cliente), ref: Via_s_(x.ref), atividade: Via_s_(x.atividade), valorTxt: Rcj_m_(x.valor), comGasto: !!ref && refs.indexOf(ref) >= 0 }; }),
+    texto: (ate < hoje ? 'Semana encerrada: ' : de <= hoje ? 'Semana em andamento: ' : 'Semana ainda não começou: ') + 'previsto ' + M(previsto) + ', realizado ' + M(realizado) + ' em ' + Via_plural_(gs.length, 'gasto lançado', 'gastos lançados') +
