+    porDia: Object.keys(porDia).sort().map(function (k) { return { dia: k, diaTxt: Via_brDia_(k) + ' (' + Rcj_diaSemanaNome_(k) + ')', previstoTxt: M(porDia[k].previsto), realizadoTxt: M(porDia[k].realizado) }; }),
