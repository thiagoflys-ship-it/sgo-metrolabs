@@ -67,6 +67,7 @@ function SGO_ajudaTelas_Comercial_() {
         { titulo: 'Escolher como ver: Lista, Quadro (Kanban) ou Gantt', itens: ['No topo da tela, toque em "Lista", "Quadro (Kanban)" ou "Gantt". A frase embaixo dos botões explica cada modo.', 'Lista: uma oportunidade embaixo da outra, as que pedem ação primeiro, com busca e filtros de situação (abertas, ganhas, perdidas).', 'Quadro (Kanban): uma coluna por etapa do funil; arraste o cartão (ou toque em "Mover para") para mudar de etapa. O sistema confere os critérios da metodologia antes de mover.', 'Gantt: a linha do tempo de cada oportunidade, da criação à previsão de fechamento, com proposta, validade, retornos e pedido.', 'Trocar de modo é um passo do voltar: o voltar devolve o modo de antes. Os endereços antigos "Quadro do funil" e "Gantt comercial" abrem esta tela no modo certo.'] },
         { titulo: 'Buscar uma oportunidade', itens: ['Escreva no campo "Buscar" parte do cliente, da unidade, do título, do código ou do contato. A busca ignora acentos e maiúsculas e aceita as palavras em qualquer ordem.', 'Ela respeita o filtro "Situação" (o padrão é "Abertas"). Se achar oportunidades ganhas ou perdidas, a tela avisa quantas são; toque em "Ver em todas as situações".'] },
         { titulo: 'Criar uma oportunidade', itens: ['Toque em "Nova oportunidade".', 'Busque o cliente pelo nome, pela razão social, pelo CNPJ ou pelo nome da unidade (sem precisar de acento) e escolha a unidade e o contato.', 'Escreva o título (o que o cliente precisa), escolha funil, etapa, origem e informe o valor estimado.', 'Preencha a próxima ação (o que fazer e quando) e toque em "Criar oportunidade". A atividade aparece em Minhas atividades.'] },
+        { titulo: 'Contato repetido do cliente (desde 18/11/2026)', itens: ['Ao cadastrar um contato com o mesmo nome (sem acento e sem maiúsculas), o mesmo e-mail ou o mesmo celular de outro contato ativo do mesmo cliente, o sistema não grava e mostra o contato que já existe. Toque em "Usar o contato existente": o que você digitou completa só os campos em branco dele; nada preenchido é trocado. Se for outra pessoa, corrija o nome, o e-mail ou o celular.', 'O telefone fixo sozinho não conta (a central do hospital é de muita gente). Contato de outro cliente com o mesmo nome também não.', 'Na oportunidade, o aviso "Este cliente tem contatos repetidos" mostra os grupos. A gestão comercial toca em "Unificar"; a equipe comercial toca em "Pedir para unificar" e a gestão recebe o aviso.'] },
         { titulo: 'Registrar um contato com o cliente', itens: ['Abra a oportunidade e toque em "Registrar contato".', 'Diga como foi, se o cliente respondeu e o que aconteceu.', 'Marque a próxima ação. A atividade anterior é concluída e a nova é criada.'] },
         { titulo: 'Mudar de etapa', itens: ['Toque em "Mudar etapa", escolha a etapa e toque em "Continuar".', 'Marque os itens da lista da etapa que foram feitos de verdade. Para voltar de etapa, escreva o motivo.', 'Se faltar algo exigido pela metodologia, a janela diz o quê e onde resolver; a oportunidade fica onde estava. O mesmo vale no Quadro do funil.'] },
         { titulo: 'Pedir o próximo passo à gestora', itens: ['Toque em "Próximo passo da gestora".', 'Ela sugere o passo, o porquê, perguntas para o cliente e os textos de WhatsApp e e-mail.', 'Copie, revise e envie você mesmo. Depois registre o contato.'] },
@@ -127,10 +128,12 @@ function SGO_ajudaTelas_Comercial_() {
         { titulo: 'Deslocamento (passo 2)', itens: ['Diga se há viagem. Não: escreva o motivo.', 'Sim: escolha a cidade de destino (a lista vem da tabela de distâncias do Programa de conduta e já traz o km), os dias, as noites, quantos técnicos e engenheiros vão e o pedágio (0 se não há).', 'Escolha a unidade que emite a nota: Goiânia (padrão) ou Rio de Janeiro. Ela muda os impostos e a sede de onde a distância é medida (no Rio, digite o km a partir da sede do Rio).', 'O sistema calcula o km rodado, o Incentivo de Missão (R$ 300 por executante em trecho de 200 km ou mais a partir da sede), a alimentação, o hotel e as horas de estrada, e o custo vira o item "Despesas de deslocamento e estadia" (custo mais impostos, sem margem e sem desconto). A antiga taxa por viagem de R$ 300 foi removida pelo dono (era o Incentivo de Missão). Toque em "Calcular (salva o rascunho)".', 'Se precisar digitar outro preço para o deslocamento, use "Preço do deslocamento na proposta". Abaixo do custo da viagem a tela avisa em vermelho: a empresa estaria pagando para ir.', 'Transporte diferente do veículo da empresa, várias viagens ou um valor diferente: abra "Ver a conta linha por linha e ajustar".'] },
         { titulo: 'Preço mínimo, preço sugerido e as opções (passo 4)', itens: ['No passo 4 aparece cada item com o seu preço, o preço mínimo (o que garante a sobra mínima da política) e o preço sugerido (o da margem alvo), e onde o seu preço está: abaixo do mínimo, entre o mínimo e o sugerido, ou no sugerido ou acima. A equipe comercial vê o mínimo e o sugerido em reais; a gestão vê também o custo e a sobra.', 'Abaixo aparecem o total, a situação da sobra, o desconto sobre a tabela e a sua alçada, e o efeito do desconto geral na sobra.', 'As opções: "Usar preço sugerido" (sobe ao sugerido os itens abaixo dele e mostra o novo total), "Ajustar para o mínimo" (só os itens abaixo do mínimo), "Manter meu preço e pedir autorização" (você escreve o motivo; a faixa mostra quem aprova e o que será aprovado) e, no item sem custo válido, "Pedir atualização do custo".', 'Os botões nunca baixam preço e só mudam o rascunho; o histórico da proposta registra o que mudou.'] },
         { titulo: 'Preço fora da política: o aprovador delegado (decisão do dono de 18/11/2026)', itens: ['Proposta que só a Diretoria aprova (sobra abaixo da mínima, item sem custo válido, custo sem cotação, preço do catálogo não aprovado) chega na hora ao dono, à Diretoria e ao Matheus, por WhatsApp e e-mail, a qualquer hora.', 'Na proposta, o quadro "Prazo do dono e da Diretoria" mostra até quando vai o prazo (padrão: 15 minutos desde o pedido), quanto falta e o critério de preço, cumprido ou o que falta.', 'Vencido o prazo sem decisão, o Matheus toca em "Autorizar (aprovador delegado)" se nenhum item estiver abaixo do preço mínimo do catálogo e o custo de todos os itens for conferível (sem desconto máximo definido pelo dono; com ele, o desconto sobre a tabela até esse percentual).', 'Ele não autoriza proposta da qual é o responsável nem o pedido que ele mesmo fez. A autorização fica no histórico com o critério e avisa o dono e a Diretoria.'] },
+        { titulo: 'Orçamento rápido: vários itens de uma vez, mais usados e copiar (desde 18/11/2026)', itens: ['Na oportunidade, "Nova proposta" abre duas saídas: "Em branco" (o contato principal do cliente e as condições de pagamento, garantia e frete da última proposta dele já vêm preenchidos; confira) ou "Copiar esta" numa proposta anterior do cliente.', 'Na proposta aberta, "Duplicar proposta" cria uma oportunidade nova do mesmo cliente com um rascunho igual: itens, quantidades, parâmetros técnicos, tipo de equipamento, equipamentos ainda ativos, condições, escopo e viagem. Os preços vêm da tabela de hoje; o desconto, as aprovações e a validação do escopo não são copiados, porque a proposta nova passa por todas as regras de novo. Item que saiu do catálogo vem como avulso, com aviso.', 'No passo 1, "Do catálogo" marca vários itens de uma vez: toque no item (ou na caixa) e ajuste a quantidade de cada um; a busca pode mudar à vontade e o que foi marcado continua marcado. No topo aparecem os mais usados (os seus, ou os da equipe enquanto você tem menos de 5 propostas no ano). "Acrescentar N itens" põe todos no rascunho; item igual que já estava na proposta soma na quantidade.', 'Para colar o pedido do cliente (lista de e-mail ou WhatsApp), use o botão "Orçamentista" do passo 1: ele separa os itens e as quantidades.', 'O editor guarda neste aparelho o que você mudou e ainda não salvou. Se a página fechar, ao abrir a proposta aparece "Há alterações desta proposta feitas neste aparelho": toque em "Recuperar e salvar" ou em "Descartar". Ao salvar, a cópia do aparelho é apagada.'] },
+        { titulo: 'Equipamento na calibração e na qualificação: o vínculo é opcional (desde 18/11/2026)', itens: ['Nos itens de calibração e de qualificação (QI, QO e QD), vincular cada equipamento é opcional. A proposta é emitida com a quantidade e o "Tipo de equipamento" do item (por exemplo "termômetro digital"). Em branco, vale o tipo da descrição do catálogo ("Calibração de termômetro digital" dá "termômetro digital"); se a descrição não diz o tipo, o quadro "Faltam dados para emitir" pede o tipo.', 'Se você já sabe os equipamentos, "Identificar equipamentos" continua igual; com parte deles, o documento lista os identificados e diz que os demais são identificados na execução.', 'O documento A4, o escopo da especialista e a passagem aos setores dizem que cada equipamento é identificado na execução. A Área técnica liga o equipamento do cadastro na triagem do chamado ("Ligar ao equipamento do cadastro") e o certificado identifica cada um.', 'Preço, parâmetros técnicos do catálogo oficial e quantidade não dependem do vínculo. Manutenção, NR-13, ensaio e inspeção continuam exigindo o equipamento identificado.', 'A Diretoria pode voltar a exigir o vínculo em Metodologia comercial > "Equipamento na calibração e na qualificação".'] },
         { titulo: 'Montar e concluir', itens: ['Toque em "Acrescentar item" e comece a digitar o nome ou o código no campo "Produto ou serviço": aparecem os itens ativos do catálogo (Produtos e serviços). Escolha um (toque, ou setas e Enter): código, tipo, descrição, unidade e preço de tabela entram sozinhos. O botão "Do catálogo" abre a mesma busca numa janela.', 'Item que não está no catálogo fica "Avulso (fora do catálogo)": escreva a descrição e o preço. Para desligar um item do catálogo, toque em "Tornar avulso".', 'O preço pode ser ajustado. Diferente da tabela, o item mostra "Abaixo da tabela" (conta como desconto na política) ou "Acima da tabela", e o preço de tabela e o praticado ficam no histórico da proposta.', 'A descrição (escopo) é opcional: escreva só o que for específico desta proposta. Os termos e condições da contratação já vão fixos no documento.', 'Confira o "Tipo de orçamento": Serviço, Produto ou Serviço e produto (misto). Sem escolha, vale o automático pelos itens. O tipo muda os dizeres do documento (apresentação, prazo e local, responsabilidades e aceite); ao trocar, o rascunho é salvo e os textos padrão passam para o modelo escolhido, e o que você escreveu fica.', 'Confira as condições (pagamento, prazo, garantia) e a validade.', 'Preencha "Custos da viagem e do frete" (próximo passo). Sem esse checklist a proposta não conclui.', 'Toque em "Revisão da gestora" para ver o que impede o envio e os alertas.', 'Toque em "Concluir". Dentro da política, a proposta fica pronta; acima do limite de desconto, informe o motivo e ela vai para a aprovação do gestor comercial (Caixa de decisões); abaixo da margem mínima da política de precificação, ela vai para a Diretoria.', 'Item sem custo (item do catálogo sem custo cadastrado ou item avulso) e item com o preço do catálogo ainda não aprovado também levam a proposta para a Diretoria: sem o custo o sistema não confere o preço mínimo que garante a sobra. O passo 4 avisa antes de concluir ("Vai para a Caixa de decisões ao concluir"). Para não depender da aprovação, peça à gestão comercial ou ao Financeiro o custo do item em Produtos e serviços e conclua de novo.', 'A conta usa o custo de hoje no catálogo. A aprovação vale para o que foi aprovado: se depois o custo sobe e a sobra fica abaixo da mínima, ou se os itens mudam, o envio é barrado com a faixa "Preço a conferir antes do envio": toque em "Voltar para rascunho" e conclua de novo.'] },
         { titulo: 'Custos da viagem e do frete (checklist obrigatório)', itens: ['Em "Há viagem para executar o serviço?", escolha Sim ou Não. Não: escreva o motivo (por exemplo "serviço no laboratório da Metrolabs").', 'Sim: informe quantos técnicos e quantos engenheiros vão, o transporte, o destino (a cidade da unidade já vem preenchida) e o km do trecho, só a ida. Quando o destino está na tabela de distâncias do Programa de conduta, o km vem sozinho.', 'Informe viagens (mais de uma para contrato com visitas), dias e noites por viagem.', 'Informe as "O.S. previstas" (visitas que o contrato prevê). Desde 13/11/2026 o Incentivo de Missão conta uma vez por O.S. e por executante, não por viagem nem por dia: contrato com 3 visitas = 3 missões; uma O.S. com duas idas = 1 missão; duas O.S. na mesma viagem = 1 missão. Com mais de uma viagem o campo é obrigatório. A frase abaixo do campo do preço mostra a conta (valor x executantes x missões) e a distância usada.', 'A distância que vale para o incentivo é a cadastral do cliente (tabela do Programa de conduta, medida da sede), quando existe: o km digitado da viagem serve para o km rodado. A 200 km ou mais a linha do incentivo é obrigatória, não aceita "não se aplica" e não aceita valor abaixo do programa, nem com motivo (MAN-VIA-001; proposta sem a linha é a ocorrência COM-02).', 'A Metrolabs não paga diária a colaboradores (Diretoria, 13/11/2026): a linha "Diárias" fica sempre "não se aplica", sem campo de valor, e a estadia entra pela alimentação e pelo hotel. Diária digitada antes em rascunho sai da conta ao calcular de novo.', 'Em cada linha (km rodado, pedágios, alimentação, hospedagem, Incentivo de Missão, combustível adicional ou passagem), deixe o valor da política (em branco, aparece a dica cinza), digite o valor desta viagem ou marque "Não se aplica" com o motivo. O sistema marca sozinho o que os fatos mandam: 0 km, sem pernoite, trecho abaixo do mínimo da Conduta (200 km), veículo da empresa (o km já cobre o combustível).', 'Item separado ou diluído: escolha como o custo entra no preço. Os dois modos cobram o mesmo valor (custo da viagem mais impostos, sem margem, sem comissão e sem desconto, fora da conta da sobra) e dão o mesmo total. Item separado: o cliente vê a linha "Despesas de deslocamento e estadia". Diluído: o cliente não vê essa linha; o valor é distribuído no preço dos serviços (proporcional ao valor de cada um), e o documento e o link mostram cada serviço já com a sua parte. O resumo junto ao campo mostra o custo, os impostos, quanto foi para o preço e o total ao cliente; no diluído, também a tabela com o preço digitado, a parte da viagem e o preço que o cliente vê. Trocar o modo nunca baixa o total nem cria desconto.', 'Proposta com produto: informe o custo do frete e da entrega ou marque "Não se aplica" com o motivo (por exemplo "cliente retira").', 'Toque em "Calcular (salva o rascunho)": aparecem o custo de cada linha, o total, o item da proposta e o que falta no checklist.'] },
-        { titulo: 'Nova proposta guiada (passo a passo)', itens: ['Em Propostas, toque em "Nova proposta guiada" (ou em Hoje > Novo orçamento > Proposta guiada). São seis passos; a trilha no topo mostra onde você está e o "Voltar" não perde o que foi feito.', '1. Cliente: se o cliente mandou e-mail ou mensagem, abra "Colar o e-mail" e toque em "Ler o texto": o CNPJ, os contatos e os equipamentos escritos no texto ficam prontos para usar (o que não estava escrito é descartado). Procure pelo CNPJ: cliente existente aparece com o que falta no cadastro, as propostas e os serviços dele e os possíveis cadastros repetidos; cliente novo vem com os dados da consulta às bases públicas para você conferir com o cliente, completar (e-mail para nota, responsável, telefone), marcar "Ciente" e cadastrar.', '2. Unidade de execução: onde ficam os equipamentos e onde o serviço é feito (pode ser outro hospital, atendido pela empresa que contrata). Escolha ou cadastre (nome, endereço, cidade, UF e "Ciente"). A unidade mostra as propostas e os serviços já feitos nela.', '3. Responsáveis: o responsável técnico (engenharia clínica) recebe o orçamento e precisa de nome completo, cargo, e-mail e telefone; o financeiro precisa do e-mail para nota e cobrança; o intermediário ou indicador é opcional, só interno, com a comissão pedida e o motivo (a Diretoria decide). Contatos repetidos aparecem com o aviso: a gestão comercial toca em "Juntar" (escolhe qual fica; as propostas passam para ele); o vendedor toca em "Pedir para juntar".', '4. Equipamentos: marque os da unidade ou cadastre. "Ler a foto da plaqueta" preenche tipo, marca, modelo, série, capacidade e ano para você conferir (os campos lidos ficam destacados). Sem o número de série agora, o equipamento entra no cadastro como "série a confirmar"; a proposta pede a série antes de emitir.', '5. Serviços: para cada equipamento, o serviço (qualificação completa ou só QI, QO ou QD; NR-13; calibração), os ciclos ou programas (botões com os mais comuns) e a carga. "Sugerir serviços e insumos" aponta o serviço da tabela oficial e os insumos do catálogo (Bowie-Dick, indicadores); confirme ou troque. Serviço que não está no catálogo: "Pedir o cadastro do serviço" (código, nome, preço proposto e descrição); a proposta pode ser montada, mas só é emitida depois da aprovação da gestão comercial.', '6. Montar: confira o resumo, escolha a origem e toque em "Montar a proposta". Ela abre em rascunho, ligada ao cliente, à unidade, ao responsável técnico e aos equipamentos. Depois: deslocamento, escopo com a especialista e o quadro "Faltam dados para emitir".', 'Sem a chave da IA, a leitura da plaqueta e do e-mail ficam desligadas (o e-mail ainda é lido pelas regras: CNPJ, e-mails, telefones e CEP) e a sugestão de serviço segue as regras do catálogo. Tudo funciona à mão.'] },
-        { titulo: 'Faltam dados para emitir (desde 11/11/2026)', itens: ['Na proposta em rascunho, aguardando aprovação ou pronta, o quadro "Faltam N dados para emitir" lista cada dado que falta, com o porquê e o que fazer. O rascunho continua livre para salvar e concluir; o documento A4 (e com ele o envio, o link de assinatura e o "Entregue por outro meio") só sai com os dados completos.', 'Obrigatórios para emitir: o cadastro do cliente completo (CNPJ ou CPF válido, razão social, endereço de faturamento com CEP, logradouro, número, bairro, cidade e UF, e-mail para nota fiscal e cobrança, responsável e telefone); a cidade e a UF da unidade (local de execução); o contato da proposta com e-mail e telefone; o equipamento de cada serviço técnico identificado, um por unidade do item (do cadastro do cliente ou com tipo, marca, modelo, número de série, setor e, para autoclave, lavadora, termodesinfectora, secadora, estufa e câmaras, a capacidade); e o escopo escrito e validado por você.', 'Produto e peça não pedem equipamento. Serviço sem equipamento (treinamento, consultoria, elaboração de documentos, taxa) também não.', '"Preencher agora": use quando o cliente já informou o dado (e-mail, ficha cadastral, nota anterior). Marque "Ciente — os dados foram informados pelo cliente" e grave. Nunca use dado buscado na internet. No equipamento do cadastro só os campos em branco são preenchidos.', '"Identificar equipamentos" no item (passo 1 do rascunho): para cada unidade do serviço, escolha o equipamento do cadastro do cliente ou informe os dados. Toque em "Usar estes equipamentos" e salve o rascunho.'] },
+        { titulo: 'Nova proposta guiada (passo a passo)', itens: ['Em Propostas, toque em "Nova proposta guiada" (ou em Hoje > Novo orçamento > Proposta guiada). São seis passos; a trilha no topo mostra onde você está e o "Voltar" não perde o que foi feito.', '1. Cliente: se o cliente mandou e-mail ou mensagem, abra "Colar o e-mail" e toque em "Ler o texto": o CNPJ, os contatos e os equipamentos escritos no texto ficam prontos para usar (o que não estava escrito é descartado). Procure pelo CNPJ: cliente existente aparece com o que falta no cadastro, as propostas e os serviços dele e os possíveis cadastros repetidos; cliente novo vem com os dados da consulta às bases públicas para você conferir com o cliente, completar (e-mail para nota, responsável, telefone), marcar "Ciente" e cadastrar.', '2. Unidade de execução: onde ficam os equipamentos e onde o serviço é feito (pode ser outro hospital, atendido pela empresa que contrata). Escolha ou cadastre (nome, endereço, cidade, UF e "Ciente"). A unidade mostra as propostas e os serviços já feitos nela.', '3. Responsáveis: o responsável técnico (engenharia clínica) recebe o orçamento e precisa de nome completo, cargo, e-mail e telefone; o financeiro precisa do e-mail para nota e cobrança; o intermediário ou indicador é opcional, só interno, com a comissão pedida e o motivo (a Diretoria decide). Contatos repetidos aparecem com o aviso: a gestão comercial toca em "Juntar" (escolhe qual fica; as propostas passam para ele); o vendedor toca em "Pedir para juntar".', '4. Equipamentos: marque os da unidade ou cadastre. "Ler a foto da plaqueta" preenche tipo, marca, modelo, série, capacidade e ano para você conferir (os campos lidos ficam destacados). Sem o número de série agora, o equipamento entra no cadastro como "série a confirmar"; a proposta pede a série antes de emitir. Calibração e qualificação de muitos instrumentos sem cadastrar um por um: abra "Sem vincular equipamentos", escreva o tipo, a quantidade e o serviço de cada linha; no passo 5 cada linha recebe o serviço do catálogo como os equipamentos, e cada equipamento é identificado na execução.', '5. Serviços: para cada equipamento, o serviço (qualificação completa ou só QI, QO ou QD; NR-13; calibração), os ciclos ou programas (botões com os mais comuns) e a carga. "Sugerir serviços e insumos" aponta o serviço da tabela oficial e os insumos do catálogo (Bowie-Dick, indicadores); confirme ou troque. Serviço que não está no catálogo: "Pedir o cadastro do serviço" (código, nome, preço proposto e descrição); a proposta pode ser montada, mas só é emitida depois da aprovação da gestão comercial.', '6. Montar: confira o resumo, escolha a origem e toque em "Montar a proposta". Ela abre em rascunho, ligada ao cliente, à unidade, ao responsável técnico e aos equipamentos. Depois: deslocamento, escopo com a especialista e o quadro "Faltam dados para emitir".', 'Sem a chave da IA, a leitura da plaqueta e do e-mail ficam desligadas (o e-mail ainda é lido pelas regras: CNPJ, e-mails, telefones e CEP) e a sugestão de serviço segue as regras do catálogo. Tudo funciona à mão.'] },
+        { titulo: 'Faltam dados para emitir (desde 11/11/2026)', itens: ['Na proposta em rascunho, aguardando aprovação ou pronta, o quadro "Faltam N dados para emitir" lista cada dado que falta, com o porquê e o que fazer. O rascunho continua livre para salvar e concluir; o documento A4 (e com ele o envio, o link de assinatura e o "Entregue por outro meio") só sai com os dados completos.', 'Obrigatórios para emitir: o cadastro do cliente completo (CNPJ ou CPF válido, razão social, endereço de faturamento com CEP, logradouro, número, bairro, cidade e UF, e-mail para nota fiscal e cobrança, responsável e telefone); a cidade e a UF da unidade (local de execução); o contato da proposta com e-mail e telefone; o equipamento de cada serviço técnico identificado, um por unidade do item (na calibração e na qualificação, desde 18/11/2026, bastam o tipo de equipamento e a quantidade: o vínculo é opcional e cada equipamento é identificado na execução) (do cadastro do cliente ou com tipo, marca, modelo, número de série, setor e, para autoclave, lavadora, termodesinfectora, secadora, estufa e câmaras, a capacidade); e o escopo escrito e validado por você.', 'Produto e peça não pedem equipamento. Serviço sem equipamento (treinamento, consultoria, elaboração de documentos, taxa) também não.', '"Preencher agora": use quando o cliente já informou o dado (e-mail, ficha cadastral, nota anterior). Marque "Ciente — os dados foram informados pelo cliente" e grave. Nunca use dado buscado na internet. No equipamento do cadastro só os campos em branco são preenchidos.', '"Identificar equipamentos" no item (passo 1 do rascunho): para cada unidade do serviço, escolha o equipamento do cadastro do cliente ou informe os dados. Toque em "Usar estes equipamentos" e salve o rascunho.'] },
         { titulo: 'Pedir os dados ao cliente', itens: ['No quadro, toque em "Pedir ao cliente". A janela mostra a lista exata do que será pedido.', 'Para mandar por e-mail na hora, informe o endereço (o e-mail sai com o seu nome e a resposta volta para você). Em branco, o sistema só prepara o texto.', 'Toque em "Gerar o pedido". Aparecem o texto do e-mail, a mensagem de WhatsApp (com "Abrir no WhatsApp" quando o contato tem celular) e o link seguro do cliente, cada um com o botão de copiar.', 'A proposta fica "Aguardando dados do cliente" e a cobrança entra em Minhas atividades (2 dias úteis). Na lista do dia, a gestora lembra do pedido parado há 2 dias úteis ou mais.', 'O link vale 30 dias e aceita uma resposta. Gerar outro pedido cancela o link anterior; "Cancelar o pedido" também.'] },
         { titulo: 'Conferir o que o cliente enviou', itens: ['Quando o cliente responde, você recebe o aviso no sistema (e por e-mail no expediente) e a atividade "Conferir os dados enviados pelo cliente". A proposta fica "Dados do cliente a conferir".', 'Abra a proposta e toque em "Conferir os dados do cliente". Cada dado aparece com o que está no cadastro hoje.', 'Marque "Aceitar" no que confere e "Recusar" com o motivo no que não confere. Toque em "Aplicar a conferência".', 'Só o que você aceitar entra no cadastro do cliente (com o histórico de quem conferiu), no contato e nos equipamentos dos itens. O que o cliente deixou em branco ou você recusou continua faltando: peça de novo ou preencha.'] },
         { titulo: 'Escopo da proposta: a especialista escreve, você lê e valida', itens: ['Com os equipamentos identificados e o local completo, toque em "Gerar o escopo com a especialista" (rascunho). O texto vem do catálogo, dos parâmetros técnicos, dos equipamentos e das condições: o que é feito em cada equipamento, as normas que o catálogo cita, a entrega dos relatórios e certificados e o que não está incluso.', 'Sem a chave da IA, ou se o texto da IA não passar na conferência (norma que o catálogo não cita, número que não está nos dados, preço), o escopo vem do modelo a partir do catálogo. Nos dois casos você valida igual.', 'Leia o texto no quadro "Escopo da proposta". Para ajustar, edite o campo "Descrição (escopo)" no passo 3 e salve.', 'Marque "Li o escopo inteiro e ele descreve o que será feito" e toque em "Li e valido o escopo". Fica registrado quem validou e quando.', 'Mudou o texto, um item, a quantidade, um equipamento ou o local depois da validação: ela cai. Gere de novo (o texto anterior fica no histórico) e valide.'] },
@@ -274,7 +277,7 @@ function SGO_ajudaTelas_Comercial_() {
       titulo: 'Painel comercial',
       paraQueServe: 'Indicadores do mês: valor ganho, perdas por motivo, conversão, funil em aberto por etapa (com o valor ponderado pela probabilidade), propostas enviadas, aprovadas e recusadas, próximas ações em dia e pedidos sem passagem. A gestão vê também o quadro "Precificação e estratégia" (margem média, propostas abaixo da mínima, custo de viagem repassado e não repassado, benefício da Conduta previsto, itens sem reajuste e o que a especialista recomenda), vê a equipe e gera o relatório mensal em A4.',
       antesDeComecar: ['O vendedor vê os próprios números; a gestão escolhe o vendedor ou a equipe toda.'],
-      passos: [{ titulo: 'Preço proposto × ganho ou perdido, por serviço', itens: ['O quadro mostra, para cada serviço com propostas ganhas ou perdidas: quantas foram decididas, a taxa de ganho, o preço médio ganho e o perdido, quanto cobrou quem ganhou de nós (quando foi informado na perda), o preço de tabela (catálogo ou tabela C1) e a faixa de mercado (licitações, concorrentes e internet do Banco de preços, ou as compras públicas da C1).', 'Embaixo do nome do serviço vem a leitura em palavras simples (por exemplo: "Perdemos com preço acima da tabela", "Ganhamos mesmo com preço maior: o preço não é o que decide").', 'Escolha o período (6, 12 ou 24 meses ou todo o histórico), de onde vêm as propostas (SGO+ e CRM antigo, ou só SGO+) e o tipo (serviços ou produtos). A gestão usa o filtro "Vendedor" do Painel; o vendedor pode marcar "Só as minhas propostas".', 'Toque em "Ver as propostas" para a lista de cada serviço: data, resultado, nosso preço, quem ganhou e o cliente.', 'Custo e preço de compra não entram neste quadro. O vendedor vê os números da empresa, mas o cliente e o número da proposta só das propostas dele.'] }, { titulo: 'Banco de preços (gestão)', itens: ['No fim do painel, o quadro "Banco de preços" mostra a taxa de ganho por serviço, o preço médio ganho e perdido, os principais concorrentes (de quem perdemos e quem mais vence as licitações) e os itens do catálogo sem preço de referência.', 'Proposta perdida sem dizer quem ganhou aparece contada: peça ao vendedor.'] }, { titulo: 'Relatório mensal (gestão)', itens: ['Escolha o mês e toque em "Relatório mensal A4".', 'O relatório abre em outra aba, com a análise da gestora (conferida contra os números), e fica salvo na pasta "Comercial - Relatórios". No celular, o documento abre dentro do SGO+, com Voltar e Imprimir.', 'No 1º dia útil de cada mês ele é gerado sozinho e vai à Diretoria com os relatórios da gestão.'] }],
