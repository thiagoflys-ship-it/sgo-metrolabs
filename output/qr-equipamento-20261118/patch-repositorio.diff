+test('ficha do cliente: versão anterior nunca é de outro equipamento, de outra unidade ou de outro cliente (chave com o vínculo)', () => {
+  const a = amb();
+  const r = a.docs(a.sAdm, 'cliente', 'cA', 'ficha');
