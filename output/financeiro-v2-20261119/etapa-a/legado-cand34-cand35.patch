+  if (aba === "v2_diretoria" || aba === "v2_dia") { if (typeof FinV2Painel_carregar_ === "function") FinV2Painel_carregar_(false); return; }
+  if (aba === "contas" && typeof FinConTela_consultar_ === "function" && document.getElementById("finConCorpo")) { FinConTela_consultar_(false); return; }
+  // Empresas e bancos mostra as três empresas (e pode ter vínculos sendo editados): só a lista de Bancos e saldos é redesenhada
+  if (aba === "v2_bancos" && typeof FinEmp_render_ === "function") FinEmp_render_(aba);
+}
+/** Abas novas desta etapa (as antigas continuam em OmieTela_abrirAba_). Devolve true se desenhou. */
+function FinV2_abrirAbaNova_(aba) {
+  var alvo = document.getElementById("omieCorpo"); if (!alvo) return false;
+  if (aba === "v2_diretoria" || aba === "v2_dia") { if (typeof FinV2Painel_render_ === "function") FinV2Painel_render_(aba === "v2_dia" ? "dia" : "diretoria"); return true; }
+  if (aba === "v2_empresas" || aba === "v2_bancos") { if (typeof FinEmp_render_ === "function") FinEmp_render_(aba); return true; }
+  if (aba === "v2_transferencias" || aba === "v2_impostos") { FinV2_construcao_(alvo, FinV2_pagina_(FIN_V2.pagina)); return true; }
+  return false;
+}
+/** Estado "em construção" de uma página das próximas etapas: o quê, quando e o que fazer enquanto isso, com os atalhos. */
+function FinV2_construcao_(alvo, pag, depois) {
+  var c = pag && pag[7]; if (!c) { alvo.innerHTML = ""; return; }
+  var acoes = (c.acoes || []).map(function (a, i) { return Fin_btn_(a[0], "fa-arrow-right", i ? "btn-secondary" : "btn-primary", 'data-fv-cons="' + i + '"'); }).join("");
+  alvo.innerHTML = '<div class="fv-v2"><div class="fv-estado construcao fv-construcao" role="status"><span class="ic"><i class="fas fa-helmet-safety" aria-hidden="true"></i></span><h4>Esta página está em construção</h4>' +
+    '<dl><dt>O que vai ter aqui</dt><dd>' + Fin_esc_(c.oque) + '</dd><dt>Quando</dt><dd>' + Fin_esc_(c.quando) + '</dd><dt>Enquanto isso</dt><dd>' + Fin_esc_(c.enquanto) + "</dd></dl>" + (acoes ? '<div class="cm-acoes">' + acoes + "</div>" : "") + '</div><div id="fvConsExtra"></div></div>';
+  alvo.querySelectorAll("[data-fv-cons]").forEach(function (b) {
+    b.onclick = function () {
+      var a = c.acoes[+b.getAttribute("data-fv-cons")];
+      FinV2_irPara_(a[1], a[2]);
+      if (a[3] && typeof window[a[3]] === "function") setTimeout(function () { try { window[a[3]](); } catch (e) {} }, 60);
+    };
+  });
+  if (depois) depois(document.getElementById("fvConsExtra"));
+}
+/** Menu: os 17 botões aparecem para quem está na lista de sigilo (o servidor confere de novo em toda chamada). */
+function FinV2_mostrarMenu_(ver) {
+  FIN_V2_PAGINAS.forEach(function (p) { var b = document.getElementById("menu-btn-" + p[0]) || document.querySelector('#menu .menu-btn[data-mod="' + p[0] + '"]'); if (b) b.style.display = ver ? "" : "none"; });
+  var omie = document.getElementById("menu-btn-omie"); if (omie) omie.style.display = ver ? "" : "none";
+  var badge = document.getElementById("menuBadgeFinAprov"), n = ver && OMIE_INI ? (Number(OMIE_INI.aprovacoesPendentes) || 0) + (Number(OMIE_INI.pagamentosPendentes) || 0) : 0;
+  if (badge) badge.textContent = n ? String(n) : "";
+}
+</script>
diff -ruN cand34/JS_Financeiro_V2_Componentes.html cand35/JS_Financeiro_V2_Componentes.html
