+</script>
+<style>
+/* =====================================================================
+   FINANCEIRO v2 — extensão do padrão do Comercial (prefixo fv-)
+   Base: tokens --bc-* de UI_Estilos.html e classes cm-* de JS_Comercial.html.
+   Nada aqui troca cor, fonte ou raio do sistema; só acrescenta o que o
+   Financeiro precisa (empresa, valores, gráficos, conciliação, aprovação).
+   Copiado do protótipo (design/prototipo/css/financeiro-v2.css, 19/11/2026) sem mudança; o encaixe no legado vem no fim.
+   ===================================================================== */
+
+:root {
+  /* Empresas: identidade (categórica). Ordem fixa, validada para daltonismo
