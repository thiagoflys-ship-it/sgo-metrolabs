+++ cand35/JS_Financeiro_V2_Componentes.html	2026-11-19 10:34:13.769251100 -0300
@@ -0,0 +1,791 @@
+<script>
+/*
+ * Financeiro v2 (19/11/2026, etapa a): componentes reutilizáveis das páginas novas do Financeiro.
+ * Origem: output/financeiro-v2-20261119/design/prototipo/js/fv-base.js e fv-graficos.js (COMPONENTES.md), adaptados ao legado:
+ *  - sem dados fictícios: tudo o que aparece vem do servidor (Fin_apiPainel, Fin_apiEmpresas);
+ *  - planilha CSV sempre pelo registro do sigilo (OmieGest_csv_), nunca baixada direto;
+ *  - a marca d'água continua a de JS_Financeiro_Marca.html (FinMarca_aplicar_);
+ *  - datas chegam como texto aaaa-mm-dd (nenhum Date cru passa por google.script.run).
+ * Funções: Fin_* (formatação, empresa, período, cartão, selos, estados, trava, caixa, janela) e Graf_* (SVG próprio, sem biblioteca).
+ */
+var FV = { emp: "TODAS", periodo: {} };
+try { var fvEmpGuardada = localStorage.getItem("fv_emp"); if (/^(TODAS|MATRIZ|FILIAL|PRESTADORA)$/.test(fvEmpGuardada || "")) FV.emp = fvEmpGuardada; } catch (e) {}
+var FV_EMP_NOME = { TODAS: "Todas (consolidado)", MATRIZ: "Matriz", FILIAL: "Filial", PRESTADORA: "Prestadora" };
+var FV_EMPRESAS_LISTA = ["TODAS", "MATRIZ", "FILIAL", "PRESTADORA"];
+
+function Fin_esc_(t) { return String(t == null ? "" : t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
+function Fin_$_(id) { return document.getElementById(id); }
+
+/* ---------- números e datas em pt-BR ---------- */
+var FV_FMT_MOEDA = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
+var FV_FMT_NUM = new Intl.NumberFormat("pt-BR", { maximumFractionDigits: 1 });
+/** R$ 1.234,56. null ou indefinido vira "—" (nunca zero inventado). */
+function Fin_moeda_(v) { return v === null || v === undefined || v === "" || !isFinite(Number(v)) ? "—" : FV_FMT_MOEDA.format(Number(v)); }
+/** Para eixos, legendas e trios: R$ 412 mil · R$ 1,2 mi. Nunca em tabela (lá vai o valor inteiro). */
+function Fin_moedaCurta_(v) {
+  if (v === null || v === undefined || !isFinite(Number(v))) return "—";
+  v = Number(v); var a = Math.abs(v), s = v < 0 ? "−" : "";
+  if (a >= 1e6) return s + "R$ " + FV_FMT_NUM.format(a / 1e6) + " mi";
+  if (a >= 1e3) return s + "R$ " + Math.round(a / 1e3).toLocaleString("pt-BR") + " mil";
+  return s + "R$ " + Math.round(a);
+}
+function Fin_pct_(v, casas) { if (v === null || v === undefined || !isFinite(Number(v))) return "—"; return Number(v).toLocaleString("pt-BR", { minimumFractionDigits: casas || 0, maximumFractionDigits: casas == null ? 1 : casas }) + " %"; }
+/** "2026-11-19" → "19/11" (curta) ou "19/11/2026" (longa). */
+function Fin_data_(iso, longa) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || "")); if (!m) return "—"; return m[3] + "/" + m[2] + (longa ? "/" + m[1] : ""); }
+var FV_SEMANA = ["dom", "seg", "ter", "qua", "qui", "sex", "sáb"];
+function Fin_diaSemana_(iso) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || "")); return m ? FV_SEMANA[new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])).getUTCDay()] : ""; }
+function Fin_somarDias_(iso, n) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || "")); return m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]) + n * 864e5).toISOString().slice(0, 10) : ""; }
+function Fin_hojeIso_() { var p = {}; new Intl.DateTimeFormat("en-CA", { timeZone: "America/Sao_Paulo", year: "numeric", month: "2-digit", day: "2-digit" }).formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; }); return p.year + "-" + p.month + "-" + p.day; }
+function Fin_soma_(l, k) { return l.reduce(function (s, x) { return s + (Number(x[k]) || 0); }, 0); }
+
+/* ---------- empresa ---------- */
+function Fin_emp_(id) { var c = String(id || "").toLowerCase(); return id ? '<span class="fv-emp ' + Fin_esc_(c) + '">' + Fin_esc_(FV_EMP_NOME[id] || id) + "</span>" : '<span class="fv-emp">Sem empresa</span>'; }
+/** Seletor de empresa: segmentado no computador, lista no celular. A escolha fica no aparelho (fv_emp). */
+function Fin_seletorEmpresa_() {
+  return '<div class="fv-empresas" role="group" aria-label="Empresa">' + FV_EMPRESAS_LISTA.map(function (o) {
+    return '<button type="button" data-fv-emp="' + o + '" aria-pressed="' + (FV.emp === o) + '"><span class="fv-pt ' + o.toLowerCase() + '" aria-hidden="true"></span>' + (o === "TODAS" ? "Todas" : FV_EMP_NOME[o]) + "</button>";
+  }).join("") + '</div><div class="fv-empresas-sel"><label class="sr-only" for="fvEmpSel">Empresa</label><select id="fvEmpSel" class="cadx-input">' + FV_EMPRESAS_LISTA.map(function (o) {
+    return '<option value="' + o + '"' + (FV.emp === o ? " selected" : "") + ">" + (o === "TODAS" ? "Empresa: todas (consolidado)" : "Empresa: " + FV_EMP_NOME[o]) + "</option>";
+  }).join("") + "</select></div>";
+}
+function Fin_ligarSeletorEmpresa_(raiz, aoMudar) {
+  var muda = function (v) {
+    if (FV_EMPRESAS_LISTA.indexOf(v) < 0 || v === FV.emp) return;
+    FV.emp = v; try { localStorage.setItem("fv_emp", v); } catch (e) {}
+    raiz.querySelectorAll("[data-fv-emp]").forEach(function (b) { b.setAttribute("aria-pressed", b.getAttribute("data-fv-emp") === v ? "true" : "false"); });
+    var s = raiz.querySelector("#fvEmpSel"); if (s && s.value !== v) s.value = v;
+    aoMudar(v);
+  };
+  raiz.querySelectorAll("[data-fv-emp]").forEach(function (b) { b.onclick = function () { muda(b.getAttribute("data-fv-emp")); }; });
+  var s = raiz.querySelector("#fvEmpSel"); if (s) s.onchange = function () { muda(s.value); };
+}
+
+/* ---------- período ---------- */
+/**
+ * Seletor de período (botões). opcoes: [[chave, rótulo]]; "outro" abre os campos De e Até (dd/mm/aaaa) na mesma linha.
+ * A escolha fica no aparelho por página (FV.periodo[chavePagina]). Devolve HTML; Fin_ligarSeletorPeriodo_ liga os toques.
+ */
+var FV_PERIODOS_PADRAO = [["hoje", "Hoje"], ["semana", "Esta semana"], ["mes", "Este mês"], ["passado", "Mês passado"], ["proximo", "Próximo mês"], ["ano", "Este ano"], ["outro", "Outro…"]];
+function Fin_seletorPeriodo_(atual, opcoes, id) {
+  opcoes = opcoes || FV_PERIODOS_PADRAO; id = id || "fvPer";
+  return '<div class="fv-periodo" role="group" aria-label="Período" id="' + id + '">' + opcoes.map(function (o) {
+    return '<button type="button" data-fv-per="' + o[0] + '" aria-pressed="' + (atual === o[0]) + '">' + Fin_esc_(o[1]) + "</button>";
+  }).join("") + "</div>";
+}
+/** Datas (dd/mm/aaaa) de um atalho de período, no dia de Brasília. */
+function Fin_periodoDatas_(tipo) {
+  var h = Fin_hojeIso_(), a = +h.slice(0, 4), m = +h.slice(5, 7) - 1, d = +h.slice(8, 10), z = function (n) { return ("0" + n).slice(-2); };
+  var br = function (dt) { return z(dt.getUTCDate()) + "/" + z(dt.getUTCMonth() + 1) + "/" + dt.getUTCFullYear(); }, U = function (y, mm, dd) { return new Date(Date.UTC(y, mm, dd)); };
+  var hoje = U(a, m, d), de, ate;
+  if (tipo === "hoje") { de = ate = hoje; }
+  else if (tipo === "semana") { var dow = (hoje.getUTCDay() + 6) % 7; de = U(a, m, d - dow); ate = U(a, m, d - dow + 6); }
+  else if (tipo === "passado") { de = U(a, m - 1, 1); ate = U(a, m, 0); }
+  else if (tipo === "proximo") { de = U(a, m + 1, 1); ate = U(a, m + 2, 0); }
+  else if (tipo === "ano") { de = U(a, 0, 1); ate = U(a, 11, 31); }
+  else if (tipo === "30" || tipo === "60" || tipo === "90") { de = hoje; ate = U(a, m, d + Number(tipo)); }
+  else { de = U(a, m, 1); ate = U(a, m + 1, 0); }
+  return { de: br(de), ate: br(ate) };
+}
+function Fin_ligarSeletorPeriodo_(raiz, aoMudar, chave) {
+  raiz.querySelectorAll("[data-fv-per]").forEach(function (b) {
+    b.onclick = function () {
+      var v = b.getAttribute("data-fv-per");
+      raiz.querySelectorAll("[data-fv-per]").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
+      if (chave) { FV.periodo[chave] = v; try { localStorage.setItem("fv_per_" + chave, v); } catch (e) {} }
+      aoMudar(v, v === "outro" ? null : Fin_periodoDatas_(v));
+    };
+  });
+}
+function Fin_periodoGuardado_(chave, padrao) { if (FV.periodo[chave]) return FV.periodo[chave]; try { var v = localStorage.getItem("fv_per_" + chave); if (v) return v; } catch (e) {} return padrao; }
+
+/** Barra fixa da página: empresa + período (opcional) + "atualizado às". */
+function Fin_barra_(opc) {
+  opc = opc || {};
+  return '<div class="fv-barra"><div class="fv-barra-esq">' + Fin_seletorEmpresa_() + (opc.periodoHtml || "") + "</div>" +
+    '<div class="fv-barra-dir"><span class="fv-atualizado" id="fvAtualizado" role="status" aria-live="polite">' + (opc.atualizado ? '<i class="fas fa-rotate" aria-hidden="true"></i>' + Fin_esc_(opc.atualizado) : "") + "</span></div></div>";
+}
+function Fin_atualizado_(texto) { var e = Fin_$_("fvAtualizado"); if (e) e.innerHTML = texto ? '<i class="fas fa-rotate" aria-hidden="true"></i>' + Fin_esc_(texto) : ""; }
+
+/* ---------- cabeçalho de página (igual Comercial_cabecalho_) ---------- */
+function Fin_cabecalho_(titulo, sub, botoes) {
+  return '<div class="module-header"><div class="module-header-left"><h2 class="content-title">' + Fin_esc_(titulo) + '</h2><p class="content-subtitle fv-just">' + Fin_esc_(sub) + "</p></div>" +
+    '<div class="module-header-right" style="display:flex;gap:8px;flex-wrap:wrap">' + (botoes || "") + "</div></div>";
+}
+function Fin_btn_(texto, icone, classe, attrs) { return '<button type="button" class="' + (classe || "btn-secondary") + '" ' + (attrs || "") + ">" + (icone ? '<i class="fas ' + icone + '" aria-hidden="true"></i>&nbsp;' : "") + Fin_esc_(texto) + "</button>"; }
+
+/* ---------- cartão de indicador ---------- */
+/**
+ * Fin_kpi_({ rotulo, valor, detalhe (HTML já escapado), sit: ok|aviso|critico|neutro, trio: [[rot, val]], ir: "fin_pagina", aba, selo })
+ * O cartão é um botão: abre a página (e a aba) de onde veio o número. A situação nunca vem só pela cor: ícone e texto.
+ */
+function Fin_kpi_(k) {
+  var ic = k.sit === "critico" ? "fa-circle-exclamation" : k.sit === "aviso" ? "fa-triangle-exclamation" : k.sit === "ok" ? "fa-circle-check" : "";
+  return '<button type="button" class="fv-kpi ' + (k.sit || "") + '"' + (k.ir ? ' data-fv-ir="' + Fin_esc_(k.ir) + '"' : "") + (k.aba ? ' data-fv-aba="' + Fin_esc_(k.aba) + '"' : "") + ">" +
+    '<span class="r"><span>' + Fin_esc_(k.rotulo) + "</span>" + (ic ? '<i class="fas ' + ic + " ic-sit " + k.sit + '" aria-label="' + (k.sit === "critico" ? "crítico" : k.sit === "aviso" ? "atenção" : "em dia") + '"></i>' : "") + "</span>" +
+    (k.valor != null ? '<span class="v">' + Fin_esc_(k.valor) + "</span>" : "") +
+    (k.trio ? '<span class="fv-trio">' + k.trio.map(function (t) { return "<div><span>" + Fin_esc_(t[0]) + "</span><b>" + Fin_esc_(t[1]) + "</b></div>"; }).join("") + "</span>" : "") +
+    (k.detalhe ? '<span class="d">' + k.detalhe + "</span>" : "") + (k.selo || "") + "</button>";
+}
+
+/* ---------- selos ---------- */
+function Fin_selo_(texto, cor) { return '<span class="cm-selo ' + (cor || "cinza") + '">' + Fin_esc_(texto) + "</span>"; }
+/** Estado de um banco ou de uma conta: ligado | falta | gravada | manual | erro | homolog | semEmpresa | compartilhado. title = NOME das chaves (nunca valor). */
+var FV_CON_TEXTO = { ligado: "Ligado", falta: "Falta credencial", gravada: "Credencial gravada", manual: "Sem API · arquivo OFX", erro: "Erro na última leitura", homolog: "Homologação", semEmpresa: "Sem empresa", compartilhado: "No Omie da matriz", adefinir: "Modo a definir", parcial: "Parte gravada", naoUsa: "Não usa" };
+var FV_CON_CLASSE = { ligado: "ligado", falta: "falta", gravada: "homolog", manual: "manual", erro: "erro", homolog: "homolog", semEmpresa: "manual", compartilhado: "manual", adefinir: "falta", parcial: "homolog", naoUsa: "manual" };
+function Fin_conector_(estado, extra) { return '<span class="fv-con ' + (FV_CON_CLASSE[estado] || "manual") + '" title="' + Fin_esc_(extra || "") + '">' + Fin_esc_(FV_CON_TEXTO[estado] || estado) + "</span>"; }
+
+/* ---------- faixas, travas e estados ---------- */
+function Fin_faixa_(tipo, html) { return '<div class="cm-faixa ' + (tipo || "") + '">' + html + "</div>"; }
+/** Toda trava diz o quê, por quê e o que fazer. */
+function Fin_trava_(oque, porque, fazer, erro) {
+  return '<div class="fv-trava' + (erro ? " erro" : "") + '" role="alert"><dl><dt>O que houve</dt><dd>' + oque + "</dd><dt>Por quê</dt><dd>" + porque + "</dd><dt>O que fazer</dt><dd>" + fazer + "</dd></dl></div>";
+}
+/** tipo: vazio | carregando | erro | credencial | permissao | construcao. texto em HTML já escapado. */
+function Fin_estado_(tipo, titulo, texto, acoes) {
+  if (tipo === "carregando") return '<div class="fv-esqueleto" aria-busy="true" aria-label="' + Fin_esc_(titulo || "Carregando") + '"><i style="width:40%"></i><i class="alto"></i><i></i><i style="width:75%"></i><i style="width:60%"></i></div>';
+  var ic = { vazio: "fa-inbox", erro: "fa-plug-circle-xmark", credencial: "fa-key", permissao: "fa-lock", construcao: "fa-helmet-safety", consolidado: "fa-layer-group" }[tipo] || "fa-circle-info";
+  return '<div class="fv-estado ' + tipo + '" role="' + (tipo === "erro" ? "alert" : "status") + '"><span class="ic"><i class="fas ' + ic + '" aria-hidden="true"></i></span><h4>' + Fin_esc_(titulo) + "</h4><p>" + texto + "</p>" + (acoes ? '<div class="cm-acoes">' + acoes + "</div>" : "") + "</div>";
+}
+/** Selo pequeno para bloco sem fonte (no lugar do número). */
+function Fin_semFonte_(texto, tipo) { return '<p class="fv-semfonte ' + (tipo || "") + '"><i class="fas ' + (tipo === "credencial" ? "fa-key" : tipo === "consolidado" ? "fa-layer-group" : "fa-circle-info") + '" aria-hidden="true"></i> ' + Fin_esc_(texto) + "</p>"; }
+
+/* ---------- caixa com cabeçalho ---------- */
+function Fin_caixa_(titulo, sub, corpo, link, classe) {
+  return '<section class="fv-caixa ' + (classe || "") + '"><div class="fv-caixa-cab"><h3>' + Fin_esc_(titulo) + (sub ? '<span class="s">' + sub + "</span>" : "") + "</h3>" +
+    (link ? '<button type="button" class="fv-link" data-fv-ir="' + Fin_esc_(link[1]) + '"' + (link[2] ? ' data-fv-aba="' + Fin_esc_(link[2]) + '"' : "") + ">" + Fin_esc_(link[0]) + ' <i class="fas fa-arrow-right" aria-hidden="true"></i></button>' : "") + "</div>" + corpo + "</section>";
+}
+
+/* ---------- janela (classes atv-* do legado) ---------- */
+function Fin_modal_(titulo, corpo, rodape, largura) {
+  var ov = document.createElement("div");
