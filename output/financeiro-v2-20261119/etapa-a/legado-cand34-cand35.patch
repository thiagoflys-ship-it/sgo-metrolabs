diff -ruN cand34/JS_Financeiro_V2_Empresas.html cand35/JS_Financeiro_V2_Empresas.html
--- cand34/JS_Financeiro_V2_Empresas.html	1969-12-31 21:00:00.000000000 -0300
+++ cand35/JS_Financeiro_V2_Empresas.html	2026-11-19 10:34:13.766001500 -0300
@@ -0,0 +1,180 @@
+<script>
+/*
+ * Financeiro v2, etapa (a) (19/11/2026): página "Empresas e bancos" (design/PAGINAS.md 3.16) e a lista de contas de "Bancos e saldos".
+ * Servidor: Fin_apiEmpresas (SGO_Financeiro_V2.js). Cadastro das 3 empresas (os campos do dono ficam vazios até ele preencher; o
+ * que o Omie da matriz já sabe aparece como sugestão "conferir"), vínculo de cada conta corrente do Omie a uma empresa, estado de
+ * cada banco (só o NOME das chaves que faltam; o valor nunca vem para a tela) e as regras em vigor. Só o dono e o Charles alteram;
+ * a Wanessa consulta, com a trava explicando. Toda alteração pede o motivo e fica no histórico (antes e depois).
+ */
+var FINEMP = { geracao: 0, dados: null, aba: "v2_empresas", edicao: {} };
+function FinEmp_render_(aba) {
+  FINEMP.aba = aba === "v2_bancos" ? "v2_bancos" : "v2_empresas";
+  var alvo = Fin_$_("omieCorpo"); if (!alvo) return;
+  if (FINEMP.aba === "v2_bancos") {
+    FinV2_construcao_(alvo, FinV2_pagina_("fin_bancos"), function (extra) { if (extra) { extra.innerHTML = '<div id="fvEmp">' + Fin_estado_("carregando", "Carregando as contas") + "</div>"; FinEmp_carregar_({ acao: "ler" }); } });
+    return;
+  }
+  alvo.innerHTML = '<div class="fv-v2" id="fvEmp">' + Fin_estado_("carregando", "Carregando as empresas") + "</div>";
+  FinEmp_carregar_({ acao: "ler" });
+}
+function FinEmp_carregar_(payload, depois) {
+  var corpo = Fin_$_("fvEmp"); if (!corpo) return;
+  var g = ++FINEMP.geracao, sessao = SGO_getSessionId();
+  var atual = function () { return g === FINEMP.geracao && sessao === SGO_getSessionId() && Fin_$_("fvEmp") === corpo; };
+  Fin_atualizado_(payload.acao === "ler" ? "Lendo as empresas e as contas…" : "Gravando…");
+  google.script.run.withSuccessHandler(function (r) {
+    if (!atual()) return;
+    if (!r || !r.ok) { if (depois) depois(r); else corpo.innerHTML = Fin_estado_("erro", "A página não abriu", Fin_esc_((r && r.mensagem) || "O servidor não respondeu.") + " <b>Nada foi gravado.</b>", Fin_btn_("Tentar de novo", "fa-rotate", "btn-primary", 'onclick="FinEmp_render_(FINEMP.aba)"')); Fin_atualizado_(""); return; }
+    FINEMP.dados = r;
+    Fin_atualizado_("Contas do Omie lidas às " + (r.contasLidoEm || "—").slice(11) + " (guardadas 6 horas)");
+    FinEmp_desenhar_();
+    if (depois) depois(r);
+  }).withFailureHandler(function (e) {
+    if (!atual()) return;
+    var m = "A comunicação com o servidor foi interrompida (" + String((e && e.message) || "sem resposta").slice(0, 120) + ").";
+    if (depois) depois({ ok: false, mensagem: m }); else corpo.innerHTML = Fin_estado_("erro", "A página não abriu", Fin_esc_(m) + " <b>Nada foi gravado.</b>", Fin_btn_("Tentar de novo", "fa-rotate", "btn-primary", 'onclick="FinEmp_render_(FINEMP.aba)"'));
+  }).Fin_apiEmpresas(sessao, payload);
