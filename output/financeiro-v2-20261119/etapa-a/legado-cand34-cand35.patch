+}
+
+/** Atalhos dos cartões e caixas (data-fv-ir="fin_pagina" e data-fv-aba="aba"): abre a página e a aba de onde veio o número. */
+function Fin_ligarAtalhos_(raiz) {
+  raiz.querySelectorAll("[data-fv-ir]").forEach(function (b) {
+    if (b._fvLigado) return; b._fvLigado = true;
+    b.addEventListener("click", function () { var p = b.getAttribute("data-fv-ir"), a = b.getAttribute("data-fv-aba") || ""; if (typeof FinV2_irPara_ === "function") FinV2_irPara_(p, a); });
+  });
+}
+
+/* ---------- planilha ---------- */
+/** CSV pelo registro do sigilo (OmieGest_csv_: a planilha só baixa depois de registrada no servidor). */
+function Fin_csv_(chave, nome, cab, linhas) {
+  if (typeof OMIE_CSV === "undefined" || typeof OmieGest_csv_ !== "function") return;
+  OMIE_CSV[chave] = { cab: cab, linhas: linhas };
+  OmieGest_csv_(chave, nome);
+}
+function Fin_csvNum_(v) { return v === null || v === undefined || !isFinite(Number(v)) ? "" : (Math.round(Number(v) * 100) / 100).toFixed(2).replace(".", ","); }
+
