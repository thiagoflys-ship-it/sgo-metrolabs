+/**
+ * Base de regras financeiras do especialista financeiro (Onda 3 do Financeiro, etapas E10 e E11, 18/11/2026).
+ * Especificação: output/financeiro-20261116/especialistas/ESPEC_ONDA2_FINANCEIRO.md, seções 2.1, 2.7 e 2.9.
+ *
+ * Texto padrão profissional, escrito para a rotina da Metrolabs e MARCADO "revisar com a contabilidade" até a Diretoria gravar uma
+ * versão revisada (decisão do dono de 18/11/2026). O modo "Regra financeira" do especialista responde a partir destas regras e cita a
+ * regra usada; quando a pergunta é tributária, fiscal, trabalhista ou jurídica, ou a regra usada tem a marca "confirmar", a resposta
+ * avisa que a decisão é do contador (ou do jurídico).
+ *
+ * Configurável: a tabela FIN_BASE_REGRAS guarda versões (nada é sobrescrito; cada gravação vira uma versão nova, com motivo, quem e
+ * quando). Só o dono do sistema e a Diretoria da lista de sigilo gravam. Sem versão gravada, vale o texto padrão abaixo.
+ * Nenhuma função daqui chama a IA, o Omie ou o Caju.
+ */
+var FIN_REGRAS_ABA = 'FIN_BASE_REGRAS';
+var FIN_REGRAS_COLUNAS = ['ID', 'VERSAO', 'REGRAS_JSON', 'REVISADA', 'MOTIVO', 'POR_ID', 'POR_NOME', 'EM'];
+var FIN_REGRAS_MAX = 30;
+var FIN_REGRAS_CONFIRMAR = { contador: 'confirmar com o contador', juridico: 'confirmar com o jurídico' };
+var FIN_REGRAS_AVISO_PADRAO = 'Texto padrão do SGO+, ainda não revisado com a contabilidade. Use como orientação geral e confirme com o contador antes de decidir.';
+
+/** Texto padrão (versão 0). confirmar: '' | 'contador' | 'juridico'. */
+var FIN_BASE_REGRAS_PADRAO = [
+  { codigo: 'R01', titulo: 'Regime de caixa e regime de competência', confirmar: 'contador',
+    texto: 'Regime de caixa considera a receita e a despesa na data em que o dinheiro entra ou sai da conta. Regime de competência considera a receita no mês em que o serviço foi prestado ou a nota foi emitida, e a despesa no mês a que ela se refere, mesmo que o pagamento aconteça em outro mês. No SGO+, o Resultado do mês, o fluxo de caixa, os indicadores e o relatório semanal usam o regime de caixa (data do pagamento). O resultado por competência, usado na contabilidade e na apuração de impostos, é feito pelo contador a partir do Omie; os dois números podem ser diferentes no mesmo mês sem que haja erro.' },
+  { codigo: 'R02', titulo: 'Juros, multa e desconto na baixa de um título', confirmar: 'contador',
+    texto: 'Juros e multa por atraso recebidos de cliente aumentam o valor recebido e são receita financeira; juros e multa pagos a fornecedor são despesa financeira. Desconto concedido ao cliente reduz a receita; desconto obtido do fornecedor reduz a despesa. Na baixa, o valor do título continua o original e a diferença é registrada nos campos próprios de juros, multa ou desconto, nunca alterando o valor do documento. No SGO+, a baixa com juros, multa ou desconto fica travada até a primeira baixa acompanhada confirmar como o Omie soma esses valores no saldo do banco; até lá, baixa com acréscimo ou desconto é feita direto no Omie. A cobrança de juros e multa do cliente depende do que está no contrato ou no boleto.' },
