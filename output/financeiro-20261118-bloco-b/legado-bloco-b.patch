+  else premissas.push('Do que venceu de 91 a 365 dias atrás sem ser pago no dia, ' + pct(rec) + ' acabou sendo recebido depois: a curva realista aplica essa taxa ao que venceu há até 90 dias.');
+  premissas.push(atraso > 0 ? 'Os clientes pagam, em média, ' + atraso + ' dia(s) depois do vencimento (atraso médio dos últimos 90 dias): a curva realista desloca cada recebimento esse tanto; o que já venceu entra daqui a ' + Math.max(1, atraso) + ' dia(s).'
+    : 'O atraso médio dos clientes é zero ou não foi calculado: a curva realista não desloca os recebimentos; o que já venceu entra amanhã.');
+  premissas.push('O que venceu há mais de 90 dias fica fora das duas curvas (o risco de não receber é alto). A pagar entra no vencimento; o que já venceu a pagar entra hoje.');
+  var z = function () { var a = []; for (var i = 0; i < N; i++) a.push(0); return a; };
+  var entOt = z(), entRe = z(), sai = z(), prov = z(), antigos = 0, pagarVencido = 0, receberVencido90 = 0;
+  var idx = function (dia) { var i = FinFoto_diasEntre_(hoje, dia); return i === null || i < 0 || i >= N ? -1 : i; };
+  (o.lista || []).forEach(function (x) {
+    var nat = x[0], venc = x[3], ab = Number(x[4]) || 0, prev = x[10] || '';
+    if (!(ab > 0) || !venc) return;
+    if (nat === 'R') {
+      if (venc >= hoje) {
+        var d = prev && prev >= hoje ? prev : venc, i = idx(d);
+        if (i >= 0) entOt[i] += ab;
+        var iR = idx(FinFoto_somarDias_(d, atraso));
+        if (iR >= 0) entRe[iR] += Math.round(ab * t15);
+      } else if (FinFoto_diasEntre_(venc, hoje) <= 90) {
+        receberVencido90 += ab;
+        entOt[0] += ab;
+        var iV = idx(FinFoto_somarDias_(hoje, Math.max(1, atraso)));
+        if (iV >= 0) entRe[iV] += Math.round(ab * rec);
+      } else antigos += ab;
+    } else if (nat === 'P') {
+      if (venc < hoje) { pagarVencido += ab; sai[0] += ab; } else { var iP = idx(venc); if (iP >= 0) sai[iP] += ab; }
+    }
+  });
+  var nProv = 0;
+  (o.provisoes || []).forEach(function (p) { var i = idx(p.dia); if (i < 0 || !(Number(p.valor) > 0)) return; prov[i] += (p.tipo === 'R' ? 1 : -1) * Math.round(Number(p.valor) * 100); nProv++; });
