+}
+
+// ------------------------------------------------------------ etapa (função pura, testável)
+/**
+ * Etapa da cobrança de um título. t: { venc, aberto (R$), pago (R$), pagoEm }; acoes: [{ acao, dia, em, dataPrometida, valorPrometido,
+ * decisao }] (qualquer ordem); hoje: 'aaaa-mm-dd'; cfg: FinCob_cfg_(); diaUtil(dia) opcional. Devolve { etapa, desde, motivo,
