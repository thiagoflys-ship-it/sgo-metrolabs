+
+// ------------------------------------------------------------ tabelas
+function FinCob_garantir_() {
+  if (typeof CertCal_garantirTabela_ === 'function') {
+    CertCal_garantirTabela_(FIN_COB_ABA, FIN_COB_COLUNAS);
