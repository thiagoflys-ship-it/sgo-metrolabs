+/**
+ * Painel financeiro > Agenda financeira (Bloco B da onda 3 do Financeiro, etapa E7, 18/11/2026).
+ * Especificação: output/financeiro-20261116/especialistas/ESPEC_ONDA2_FINANCEIRO.md, seções 1.6, 1.7 e 1.8 (teste 5).
+ *
+ * 1. GANTT DA AGENDA: o que vence nos próximos 30, 60 ou 90 dias (padrão 60), com a semana anterior à vista para os vencidos
+ *    recentes. Linhas: a receber por cliente (10 maiores; os demais em "Outros clientes"), a pagar por categoria do Omie (10 maiores
+ *    e "Outras categorias"), provisões internas (aba Provisões) e prazos de prestação de contas de viagem (Caju). Cada vencimento é
+ *    um losango (cheio = vencido; vazado = a vencer); promessas de pagamento e acordos da régua de cobrança são barras da data da
+ *    ação até a data combinada. Régua de datas de SGOGantt_fabrica_ (SGO_Gantt_Layout.js): vista Semana para 30 dias; para 60 e 90
+ *    dias, a vista Mês (um rótulo por semana), para o quadro não ficar com vários metros de largura. Toque mostra documento, valor
+ *    e situação. Fonte: a lista de títulos da fotografia na memória do servidor (SGO_Financeiro_Foto.js); nenhuma chamada ao Omie.
+ *
+ * 2. PREVISÃO DE CAIXA DE 90 DIAS (tabela por semana e gráfico G2), função pura FinAg_previsao_:
+ *      saldo_previsto(d) = saldo de hoje + a receber em d × taxa − a pagar em d ± provisões internas em d
+ *    Duas curvas. OTIMISTA ("pelo vencimento"): todo a receber entra no dia da previsão (ou do vencimento) e o que venceu há até 90
+ *    dias entra hoje; vencido há mais de 90 dias fica fora. REALISTA ("pela realização"): o que vai vencer entra deslocado pelo
+ *    atraso médio dos clientes (I10) e multiplicado pela taxa observada de recebimento até 15 dias depois do vencimento; o que venceu
+ *    há até 90 dias entra pela taxa de recuperação observada (do que venceu de 91 a 365 dias atrás sem pagamento, quanto acabou
+ *    entrando); vencido há mais de 90 dias entra com zero. A pagar é igual nas duas: no vencimento (o vencido, hoje).
+ *    Saldo mínimo de segurança (FIN_SALDO_MINIMO): SEM valor por decisão do dono (é solicitado e devolvido); sem ele, não há alerta
+ *    de mínimo, só o de saldo negativo. Com ele, o dia em que a curva realista cruza o mínimo vira alerta aqui e no relatório.
+ *
+ * Sigilo: FinAg_apiAgenda passa por Omie_exigirAcesso_ (lista de sigilo + FIN_OMIE_CONSULTAR) e entra no registro de acessos.
+ */
+var FIN_AG_JANELAS = [30, 60, 90], FIN_AG_ATRAS = 7, FIN_AG_TOPO = 10, FIN_AG_PREV_DIAS = 90;
+
+function FinAg_s_(v) { return String(v === null || v === undefined ? '' : v).trim(); }
+function FinAg_br_(dia) { return FinFoto_br_(dia); }
+function FinAg_m_(v) { return FinInd_moeda_(v); }
+function FinAg_esc_(t) { return typeof RelA4_esc_ === 'function' ? RelA4_esc_(t) : FinAg_s_(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
+
+// ------------------------------------------------------------ previsão (pura)
+/**
+ * o: { hoje, saldo (R$), lista (tuplas da fotografia), taxas: { t15, recuperacao, atrasoMedio }, provisoes: [{ tipo 'R'|'P', valor, dia }],
+ *      minimo (R$ ou null), dias (90) }. Devolve { dias: [...], semanas: [...], premissas: [...], alerta, cruzaRealista, cruzaOtimista,
+ *      menorRealista, negativoRealista, totais } ou { erro }.
+ */
+function FinAg_previsao_(o) {
+  o = o || {};
+  var hoje = o.hoje, N = o.dias || FIN_AG_PREV_DIAS, saldo = o.saldo;
+  if (saldo === null || saldo === undefined || !isFinite(saldo)) return { erro: 'a fotografia não tem o saldo em contas (a leitura do resumo do Omie falhou); a previsão parte dele' };
