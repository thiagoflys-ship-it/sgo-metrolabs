+    '<dt>Quem recebe o aviso</dt><dd>' + esc(c.destinos && c.destinos.length ? c.destinos.join('; ') : 'ninguém da lista de sigilo está configurado') + (c.padrao ? ' (padrão: o dono e a Diretoria da lista de sigilo)' : '') + (c.ignorados && c.ignorados.length ? '. Ignorados: ' + c.ignorados.join('; ') : '') + '.<span class="omie-dica">Só aparecem pessoas da lista de sigilo do Financeiro. Quem sair da lista deixa de receber sozinho.</span></dd>' +
