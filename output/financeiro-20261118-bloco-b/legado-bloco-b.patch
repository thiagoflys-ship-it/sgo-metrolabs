+    if (palavras.length < 2) continue;
+    if (palavras.every(function (w) { return FIN_IA_VOCABULARIO.indexOf(w) >= 0; })) continue;
+    var trecho = palavras.join(' ');
+    if (ctxTxt.indexOf(trecho) >= 0) continue;
+    out.push(trecho);
+  }
+  return out;
+}
+
+// ------------------------------------------------------------ contexto pseudonimizado
+/**
+ * d: os dados do relatório (FinRel_dados_). Devolve { texto (o que vai à IA), mapa: { 'Cliente 01': 'Nome real' } }. Nunca leva
+ * documento, CNPJ, CPF, e-mail, telefone nem nome de colaborador.
+ */
+function FinIa_contexto_(d) {
+  var mapa = {}, L = [], nCli = 0, nForn = 0, porNome = {};
+  var codigoCli = function (nome) { if (porNome['C:' + nome]) return porNome['C:' + nome]; var c = FinIa_codigo_('Cliente', ++nCli); porNome['C:' + nome] = c; mapa[c] = nome; return c; };
+  var codigoForn = function (nome) { if (porNome['F:' + nome]) return porNome['F:' + nome]; var c = FinIa_codigo_('Fornecedor', ++nForn); porNome['F:' + nome] = c; mapa[c] = nome; return c; };
+  L.push('Semana analisada: ' + d.semana.rotulo + ' (semana ' + d.semana.numero + ').' + (d.parcial ? ' Relatório PARCIAL: a semana ainda não terminou.' : ''));
+  L.push('Fotografia usada: ' + d.fotoBr + '.');
+  L.push('Nota de saúde financeira: ' + (d.saude.nota === null ? 'não calculada' : d.saude.nota + ' de 100 (' + d.saude.faixa + ')') + (d.saudeAnterior ? '; na semana anterior: ' + d.saudeAnterior.nota + ' (' + d.saudeAnterior.faixa + ')' : '') + '.');
+  (d.saude.criterios || []).forEach(function (c) { L.push('Critério ' + c.codigo + ' ' + c.nome + ': ' + (c.calculado ? c.pontos.toString().replace('.', ',') + ' de ' + c.peso + ' pontos. ' + c.explicacao : 'não calculado (' + c.motivo + ').')); });
+  L.push('Indicadores (fotografia atual; entre parênteses, a do início da semana):');
+  FIN_IND_DEF.forEach(function (def) {
+    var x = d.ind[def.c] || {}, a = d.indInicio ? d.indInicio[def.c] : null;
