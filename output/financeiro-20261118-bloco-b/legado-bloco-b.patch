+function FinCob_titulo_(x) { return { nat: x[0], id: Number(x[1]), cli: Number(x[2]), venc: x[3], aberto: (Number(x[4]) || 0) / 100, pago: (Number(x[5]) || 0) / 100, pagoEm: x[6] || '', doc: x[7] || '', parcela: x[8] || '', cat: x[9] || '', prev: x[10] || '' }; }
