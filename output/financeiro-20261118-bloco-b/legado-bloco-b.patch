+  if (t15 === null) { t15 = 1; premissas.push('Não houve títulos vencidos entre 16 e 90 dias atrás para medir quanto entra no prazo: a curva realista usa 100 % para o que vai vencer.'); }
+  else premissas.push('Do que venceu entre 16 e 90 dias atrás, ' + pct(t15) + ' foi recebido até 15 dias depois do vencimento: a curva realista aplica essa taxa ao que vai vencer.');
