+    NOTA: d.saude.nota === null ? '' : d.saude.nota, FAIXA: d.saude.faixa, CRITERIOS_JSON: JSON.stringify((d.saude.criterios || []).map(function (k) { return { codigo: k.codigo, pontos: k.pontos, peso: k.peso, calculado: k.calculado }; })),
