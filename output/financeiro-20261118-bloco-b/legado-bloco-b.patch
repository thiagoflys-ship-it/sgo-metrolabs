+/** Texto do aviso: sem nenhum valor; com LINK_NOTA, só a faixa da nota. */
+function FinRel_mensagem_(rel, cfg) {
+  var numero = FinRel_s_(rel.NUMERO), de = FinRel_br_(FinRel_s_(rel.DE).slice(0, 10)).slice(0, 5), ate = FinRel_br_(FinRel_s_(rel.ATE).slice(0, 10));
