+  });
+  L.push('Recebido na semana: ' + FinInd_moeda_(d.semanaCaixa.recebido) + '; pago na semana: ' + FinInd_moeda_(d.semanaCaixa.pago) + (d.semanaCaixa.motivo ? ' (' + d.semanaCaixa.motivo + ')' : '') + '.');
+  if (d.aging) L.push('Envelhecimento do a receber: a vencer ' + FinIa_reais_(d.aging.aVencer) + '; vencido de 1 a 30 dias ' + FinIa_reais_(d.aging.ate30) + '; de 31 a 90 dias ' + FinIa_reais_(d.aging.de31a90) + '; acima de 90 dias ' + FinIa_reais_(d.aging.mais90) + '.');
+  if (d.topVencidos.length) L.push('Maiores clientes com valor vencido (até 15): ' + d.topVencidos.slice(0, 15).map(function (c) { return codigoCli(c.nome) + ' ' + FinIa_reais_(c.valor); }).join('; ') + '.');
+  L.push('Promessas de pagamento quebradas na régua de cobrança: ' + d.cobranca.quebradas + '; títulos aguardando a decisão da Diretoria: ' + d.cobranca.diretoria + '.');
+  if (d.previsao && !d.previsao.erro) L.push('Previsão de caixa de 90 dias: ' + d.previsao.alerta + ' Saldo previsto ao fim de 90 dias: otimista ' + FinIa_reais_(d.previsao.dias[d.previsao.dias.length - 1].otimista) + ', realista ' + FinIa_reais_(d.previsao.dias[d.previsao.dias.length - 1].realista) + '.');
+  if (d.pagar30.length) L.push('A pagar nos próximos 30 dias por categoria (dados do Omie): <<<DADOS ' + d.pagar30.slice(0, 10).map(function (c) { return c.categoria + ' ' + FinIa_reais_(c.valor); }).join('; ') + ' DADOS>>>.');
+  if (d.pagarVencidos.length) L.push('Contas a pagar vencidas (até 10): ' + d.pagarVencidos.slice(0, 10).map(function (p) { return codigoForn(p.fornecedor) + ' ' + FinIa_reais_(p.valor) + ' vencida em ' + p.vencBr; }).join('; ') + '.');
+  if (d.meses.length) L.push('Recebido e pago por mês (regime de caixa): ' + d.meses.map(function (m) { return m.rotulo + ': recebido ' + FinIa_reais_(m.recebido) + ', pago ' + FinIa_reais_(m.pago); }).join('; ') + '.');
