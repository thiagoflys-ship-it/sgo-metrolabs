+      dataPrometida: FinCob_s_(a.DATA_PROMETIDA).slice(0, 10), valorPrometido: Number(a.VALOR_PROMETIDO) || 0, obs: FinCob_s_(a.OBS), porId: FinCob_s_(a.POR_ID), porNome: FinCob_s_(a.POR_NOME),
