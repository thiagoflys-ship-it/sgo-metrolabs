+var FIN_IA_CHAVES = ['aconteceu', 'preocupa', 'fazer', 'caixa', 'recebimentos', 'pagamentos', 'resultado', 'conclusao'];
+var FIN_IA_NOMES_CHAVES = { aconteceu: 'o que aconteceu na semana', preocupa: 'o que preocupa', fazer: 'o que fazer', caixa: 'caixa', recebimentos: 'recebimentos e cobrança', pagamentos: 'pagamentos', resultado: 'resultado', conclusao: 'conclusão' };
+// palavras com maiúscula que não são nome de pessoa nem de empresa (vocabulário do relatório e começo de frase)
+var FIN_IA_VOCABULARIO = ('A O As Os Ao Aos À Às No Na Nos Nas Em De Da Do Das Dos Para Pela Pelo Pelas Pelos Com Sem Por Se Já Há Mas E Ou Que Como Até Após Sobre Entre Esta Este Estas Estes Nesta Neste Essa Esse Isso Isto Uma Um ' +
+  'Diretoria Financeiro Financeira Omie SGO Caju Saudável Atenção Alerta Crítica Cliente Clientes Fornecedor Fornecedores Painel Régua Cobrança Cobranças Agenda Indicadores Lançamentos Baixas Conciliação Bancária ' +
+  'Provisões Relatório Relatórios Semana Semanal Saúde Nota Caixa Recebimentos Pagamentos Resultado Conclusão Recomendação Recomendações Prioridade Promessa Promessas Acordo Acordos Previsão Saldo Mínimo Margem ' +
+  'Inadimplência Cobertura Concentração Disciplina Operacional Fôlego Compromissos Viagem Viagens Prestação Contas Depósito Recarga Chaves Senhas Regras Ficha Brasil Real Reais Janeiro Fevereiro Março Abril Maio Junho ' +
+  'Julho Agosto Setembro Outubro Novembro Dezembro Segunda Terça Quarta Quinta Sexta Sábado Domingo Também Ainda Hoje Contudo Portanto Além Assim Logo Neste Nesse Nessa Esta Cabe Vale Convém Recomenda Recomendamos Sugere Sugerimos Priorizar Manter Acompanhar Revisar Cobrar Registrar').split(/\s+/);
