--- cand19/JS_Financeiro_Agenda.html	1969-12-31 21:00:00.000000000 -0300
+++ cand20/JS_Financeiro_Agenda.html	2026-11-18 07:12:57.085644300 -0300
@@ -0,0 +1,87 @@
+<script>
+/*
+ * Painel financeiro > Agenda financeira (Bloco B da onda 3 do Financeiro, E7, 18/11/2026).
+ * Servidor: SGO_Financeiro_Agenda.js (FinAg_apiAgenda). O Gantt e o gráfico da previsão vêm prontos do servidor (SVG, já
+ * escapado lá), a partir da fotografia diária: a aba não chama o Omie. Toque num losango ou numa barra mostra o detalhe abaixo do
+ * quadro. Guia e explicação dos campos: JS_Omie_Ajuda.html (OMIE_GUIAS.agenda e OMIE_DICAS.finAgJanela).
+ */
+var FIN_AG_TELA = { geracao: 0, ultimo: null };
+function FinAgTela_esc_(v) { return typeof CadUI_esc_ === 'function' ? CadUI_esc_(v) : String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+function FinAgTela_rpc_(nome, dados, ok, erro) {
+  var g = FIN_AG_TELA.geracao, sessao = SGO_getSessionId(), pedido = typeof OMIE_TELA !== 'undefined' ? OMIE_TELA.pedido : null;
+  function atual() { return g === FIN_AG_TELA.geracao && sessao === SGO_getSessionId() && (typeof OMIE_TELA === 'undefined' || pedido === OMIE_TELA.pedido); }
+  google.script.run.withSuccessHandler(function (r) { if (!atual()) return; if (!r || !r.ok) { (erro || FinAgTela_aviso_)(r && r.mensagem || 'Não foi possível concluir. Tente de novo.', r); return; } ok(r); })
+    .withFailureHandler(function () { if (atual()) (erro || FinAgTela_aviso_)('A comunicação com o servidor foi interrompida. Nada foi alterado; abra a aba de novo.'); })[nome](sessao, dados || {});
+}
+function FinAgTela_aviso_(m) { var e = document.getElementById('finAgAviso'); if (e) e.textContent = m || ''; }
+function FinAgTela_render_() {
+  var c = document.getElementById('omieCorpo'); if (!c) return;
+  FIN_AG_TELA.geracao++;
+  c.innerHTML = '<section class="fin-ag"><h3>Agenda financeira</h3>' +
+    '<p class="fin-ag-intro">O que vence a receber e a pagar nos próximos dias, por cliente e por categoria, e a previsão do saldo de caixa dos próximos 90 dias. Tudo vem da fotografia diária do Omie (feita a partir das 06:00, só leitura); a aba não consulta o Omie a cada toque.</p>' +
+    '<form class="omie-barra" onsubmit="event.preventDefault();FinAgTela_carregar_()"><label for="finAgJanela">Período do quadro<select class="cadx-input" id="finAgJanela" name="finAgJanela" onchange="FinAgTela_carregar_()"><option value="30">Próximos 30 dias</option><option value="60" selected>Próximos 60 dias</option><option value="90">Próximos 90 dias</option></select></label></form>' +
+    '<p id="finAgAviso" class="fin-ind-aviso" role="status" aria-live="polite"></p><div id="finAgCorpo">' + (typeof CadUI_esqueleto_ === 'function' ? CadUI_esqueleto_(4) : '<p>Carregando…</p>') + '</div></section>';
+  FinAgTela_carregar_();
+}
+function FinAgTela_carregar_() {
+  var sel = document.getElementById('finAgJanela'), corpo = document.getElementById('finAgCorpo'); if (!corpo) return;
+  FinAgTela_aviso_('Montando a agenda…');
+  FinAgTela_rpc_('FinAg_apiAgenda', { dias: sel ? Number(sel.value) : 60 }, function (r) { FinAgTela_aviso_(''); FIN_AG_TELA.ultimo = r; FinAgTela_desenhar_(r); },
+    function (m) { FinAgTela_aviso_(''); corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="alert"><strong>A agenda financeira não abriu.</strong><p>' + FinAgTela_esc_(m) + '</p></div>'; });
+}
+function FinAgTela_desenhar_(r) {
+  var esc = FinAgTela_esc_, corpo = document.getElementById('finAgCorpo'); if (!corpo) return;
+  if (r.semLista) {
+    corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="status"><strong>A agenda está sem os títulos.</strong><p>' + esc(r.semLista) + '</p><p><button type="button" class="cadx-btn" id="finAgPedirFoto" onclick="FinAgTela_pedirFoto_()">Pedir nova fotografia</button></p></div>';
+    return;
+  }
+  var h = '<div class="vg-faixa is-neutra" role="status"><b>Fotografia de ' + esc(r.foto.concluidaEm) + '.</b> Quadro de ' + esc(r.gantt.inicio) + ' a ' + esc(r.gantt.fim) + ' (a semana anterior aparece para os vencidos recentes). Losango cheio = vencido; vazado = a vencer; barra amarela = promessa de pagamento; barra roxa = acordo. Toque num item para ver o detalhe.</div>';
+  h += '<h4 class="fin-ind-sub">Quem paga e a quem pagar</h4>' + r.gantt.html + '<div id="finAgDetalhe" class="fin-ag-detalhe" role="status" aria-live="polite"><p>Toque num losango ou numa barra para ver os documentos, os valores e a situação.</p></div>';
+  var p = r.previsao || {};
+  h += '<h4 class="fin-ind-sub">Previsão de caixa dos próximos 90 dias</h4>';
+  if (p.erro) h += '<div class="cadx-vazio bc-vazio" role="status"><p>' + esc(p.erro) + '</p></div>';
+  else {
+    h += '<div class="vg-faixa ' + (p.abaixo || p.negativo ? 'is-alerta' : 'is-neutra') + '" role="status">' + esc(p.alerta) + '</div>' +
+      '<div class="fin-ind-graf fin-ag-graf">' + p.svg + '</div>' +
+      '<details class="fin-ag-premissas" open><summary>Como a previsão é feita</summary><ul>' + (p.premissas || []).map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>' + (p.foraDaConta ? '<p>' + esc(p.foraDaConta) + '</p>' : '') + '<p>Saldo de partida: ' + esc(p.saldoTxt) + '. Saldo mínimo de segurança: ' + esc(p.minimoTxt) + '.</p></details>' +
+      '<div class="fin-ag-tabela" role="region" aria-label="Previsão por semana" tabindex="0"><table class="fin-ag-tab"><thead><tr><th>Semana</th><th>Entra (otimista)</th><th>Entra (realista)</th><th>Sai</th><th>Provisões</th><th>Saldo otimista</th><th>Saldo realista</th></tr></thead><tbody>' +
+      (p.semanas || []).map(function (s) { return '<tr class="' + (s.abaixo || s.negativo ? 'is-alerta' : '') + '"><td>' + esc(s.periodo) + '</td><td>' + esc(s.entraOtimista) + '</td><td>' + esc(s.entraRealista) + '</td><td>' + esc(s.sai) + '</td><td>' + esc(s.provisao) + '</td><td>' + esc(s.otimista) + '</td><td><b>' + esc(s.realista) + '</b></td></tr>'; }).join('') +
+      '</tbody></table></div>';
+  }
+  corpo.innerHTML = h;
+  var trilho = corpo.querySelector('.fin-ag-trilho');
+  if (trilho) trilho.addEventListener('click', function (ev) {
+    var alvo = ev.target && ev.target.closest ? ev.target.closest('[data-ag]') : null; if (!alvo) return;
+    var d = (r.gantt.detalhes || [])[Number(alvo.getAttribute('data-ag'))]; if (!d) return;
+    var box = document.getElementById('finAgDetalhe');
+    if (box) box.innerHTML = '<p><b>' + esc(d.titulo) + '</b></p><ul>' + d.linhas.map(function (l) { return '<li>' + esc(l) + '</li>'; }).join('') + '</ul>';
+  });
+}
+function FinAgTela_pedirFoto_() {
+  var b = document.getElementById('finAgPedirFoto'); if (b) b.disabled = true;
+  FinAgTela_rpc_('Fin_apiFotoPedir', {}, function (r) { FinAgTela_aviso_(r.mensagem); }, function (m) { FinAgTela_aviso_(m); if (b) b.disabled = false; });
+}
+</script>
+<style>
+  #omieTela .fin-ag-intro, #omieTela .fin-ag p, #omieTela .fin-ag li { text-align:justify; line-height:1.5; }
+  #omieTela .fin-ag-gantt { display:grid; grid-template-columns:minmax(120px, 26%) minmax(0, 1fr); border:1px solid var(--bc-line, #cbd5e1); border-radius:10px; overflow:hidden; background:var(--bc-surface, #fff); }
+  #omieTela .fin-ag-rotulos { border-right:1px solid var(--bc-line, #cbd5e1); min-width:0; }
+  #omieTela .fin-ag-rot { box-sizing:border-box; padding:2px 8px; display:flex; flex-direction:column; justify-content:center; font-size:12.5px; line-height:1.15; overflow:hidden; border-bottom:1px solid #eef1f4; }
+  #omieTela .fin-ag-rot span { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
+  #omieTela .fin-ag-rot small { font-size:10.5px; color:var(--bc-muted, #64748b); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
+  #omieTela .fin-ag-rot.is-grupo { background:#e9eef5; font-weight:700; font-size:12px; }
+  #omieTela .fin-ag-rot.is-cab { background:#f3f5f7; font-size:11.5px; color:var(--bc-muted, #475569); }
+  #omieTela .fin-ag-trilho { overflow-x:auto; min-width:0; }
+  #omieTela .fin-ag-trilho svg { display:block; max-width:none; }
+  #omieTela .fin-ag-detalhe { border:1px dashed var(--bc-line, #cbd5e1); border-radius:8px; padding:8px 12px; margin:10px 0 0; font-size:13px; }
+  #omieTela .fin-ag-detalhe ul { margin:4px 0 0 18px; padding:0; }
+  #omieTela .fin-ag-graf { margin:10px 0; }
+  #omieTela .fin-ag-premissas { margin:8px 0 12px; font-size:13px; }
+  #omieTela .fin-ag-premissas ul { margin:6px 0 0 18px; padding:0; }
+  #omieTela .fin-ag-tabela { overflow-x:auto; max-width:100%; }
+  #omieTela .fin-ag-tabela table { width:100%; border-collapse:collapse; font-size:12.5px; }
+  #omieTela .fin-ag-tabela th, #omieTela .fin-ag-tabela td { padding:5px 8px; border-bottom:1px solid var(--bc-line, #e2e8f0); text-align:right; white-space:nowrap; }
+  #omieTela .fin-ag-tabela th:first-child, #omieTela .fin-ag-tabela td:first-child { text-align:left; }
+  #omieTela .fin-ag-tabela tr.is-alerta td { background:#fdecec; }
+  @media (max-width:700px) { #omieTela .fin-ag-gantt { grid-template-columns:minmax(104px, 34%) minmax(0, 1fr); } }
+</style>
diff -ruN cand19/JS_Financeiro_Cobranca.html cand20/JS_Financeiro_Cobranca.html
--- cand19/JS_Financeiro_Cobranca.html	1969-12-31 21:00:00.000000000 -0300
+++ cand20/JS_Financeiro_Cobranca.html	2026-11-18 07:12:20.288185300 -0300
@@ -0,0 +1,182 @@
+<script>
+/*
+ * Painel financeiro > Régua de cobrança (Bloco B da onda 3 do Financeiro, E6, 18/11/2026).
+ * Servidor: SGO_Financeiro_Cobranca.js (FinCob_apiQuadro, FinCob_apiHistorico, FinCob_apiAcao). O quadro é de LEITURA: ninguém
+ * arrasta cartão; a etapa é calculada pelo sistema a partir da fotografia diária do Omie e das ações registradas aqui. Toque no
+ * cartão abre o painel do título, com o histórico, as ações e os atalhos. Nada é gravado no Omie por esta aba. Guia e explicação
+ * dos campos: JS_Omie_Ajuda.html (OMIE_GUIAS.regua e OMIE_DICAS.reg*).
+ */
+var FIN_COB_TELA = { geracao: 0, ultimo: null, titulo: null, max: 40 };
+function FinCobTela_esc_(v) { return typeof CadUI_esc_ === 'function' ? CadUI_esc_(v) : String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+function FinCobTela_rpc_(nome, dados, ok, erro) {
+  var g = FIN_COB_TELA.geracao, sessao = SGO_getSessionId(), pedido = typeof OMIE_TELA !== 'undefined' ? OMIE_TELA.pedido : null;
+  function atual() { return g === FIN_COB_TELA.geracao && sessao === SGO_getSessionId() && (typeof OMIE_TELA === 'undefined' || pedido === OMIE_TELA.pedido); }
+  google.script.run.withSuccessHandler(function (r) { if (!atual()) return; if (!r || !r.ok) { (erro || FinCobTela_aviso_)(r && r.mensagem || 'Não foi possível concluir. Tente de novo.', r); return; } ok(r); })
+    .withFailureHandler(function () { if (atual()) (erro || FinCobTela_aviso_)('A comunicação com o servidor foi interrompida. Nada foi alterado; toque em "Atualizar o quadro" ou abra a aba de novo.'); })[nome](sessao, dados || {});
+}
+function FinCobTela_aviso_(m) { var e = document.getElementById('finCobAviso'); if (e) e.textContent = m || ''; }
+
+function FinCobTela_render_() {
+  var c = document.getElementById('omieCorpo'); if (!c) return;
+  FIN_COB_TELA.geracao++; FIN_COB_TELA.titulo = null;
+  c.innerHTML = '<section class="fin-cob"><h3>Régua de cobrança</h3>' +
+    '<p class="fin-cob-intro">Os títulos a receber vencidos e a vencer, por etapa da cobrança. A etapa é calculada pelo sistema a partir da fotografia diária do Omie e das ações registradas aqui: ninguém arrasta cartão. Toque no cartão para ver o histórico e registrar o que foi feito. Nada é enviado ao cliente nem gravado no Omie por esta aba.</p>' +
+    '<form class="omie-barra" onsubmit="event.preventDefault();FinCobTela_filtrar_()"><label for="finCobBusca">Buscar no quadro<input class="cadx-input" id="finCobBusca" name="finCobBusca" type="search" autocomplete="off" oninput="FinCobTela_filtrar_()" placeholder="Cliente ou documento"></label>' +
+    '<button type="button" class="cadx-btn" onclick="FinCobTela_carregar_(\'\')">Atualizar o quadro</button></form>' +
+    '<p id="finCobAviso" class="fin-ind-aviso" role="status" aria-live="polite"></p><div id="finCobCorpo">' + (typeof CadUI_esqueleto_ === 'function' ? CadUI_esqueleto_(4) : '<p>Carregando…</p>') + '</div><div id="finCobPainel"></div></section>';
+  FinCobTela_carregar_();
+}
+/** depois: mensagem que fica na faixa quando o quadro terminar de carregar (ex.: "Ação registrada…"). */
+function FinCobTela_carregar_(depois) {
+  var corpo = document.getElementById('finCobCorpo'); if (!corpo) return;
+  depois = typeof depois === 'string' ? depois : '';
+  FinCobTela_aviso_(depois || 'Lendo a régua de cobrança…');
+  FinCobTela_rpc_('FinCob_apiQuadro', {}, function (r) { FinCobTela_aviso_(depois); FIN_COB_TELA.ultimo = r; FinCobTela_desenhar_(r); if (FIN_COB_TELA.titulo) FinCobTela_abrirTitulo_(FIN_COB_TELA.titulo, true); },
+    function (m) { FinCobTela_aviso_(''); corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="alert"><strong>A régua de cobrança não abriu.</strong><p>' + FinCobTela_esc_(m) + '</p></div>'; });
+}
+function FinCobTela_cartao_(k) {
+  var esc = FinCobTela_esc_;
+  return '<button type="button" class="fin-cob-card' + (k.destaque ? ' is-destaque' : '') + (k.proximaVencida ? ' is-lembrete' : '') + '" data-tit="' + esc(k.id) + '" data-busca="' + esc((k.cliente + ' ' + k.documento).toLowerCase()) + '" onclick="FinCobTela_abrirTitulo_(' + Number(k.id) + ')">' +
+    '<span class="fin-cob-cli">' + esc(k.cliente) + '</span><span class="fin-cob-doc">Documento ' + esc(k.documento + (k.parcela ? '/' + k.parcela : '')) + ' · venc. ' + esc(k.vencimentoBr) + '</span>' +
+    '<span class="fin-cob-valor">' + esc(k.etapa === 'RECEBIDO' ? 'Recebido ' + (k.recebidoTxt || '') : k.saldoTxt) + '</span>' +
+    (k.atrasoTxt ? '<span class="fin-cob-linha">' + esc(k.atrasoTxt) + '</span>' : '') +
+    '<span class="fin-cob-linha">Atraso médio do cliente (12 meses): ' + esc(k.atrasoMedioTxt) + '</span>' +
+    (k.promessa && (k.etapa === 'PROMESSA' || k.etapa === 'PROMESSA_QUEBRADA') ? '<span class="fin-cob-linha">Prometido para ' + esc(k.promessa.dataBr) + ': ' + esc(k.promessa.valorTxt) + '</span>' : '') +
+    (k.decisao ? '<span class="fin-cob-linha"><b>Decisão da Diretoria:</b> ' + esc(k.decisao.nome) + ' (' + esc(k.decisao.emBr) + ')</span>' : '') +
+    (k.proximaBr ? '<span class="fin-cob-linha' + (k.proximaVencida ? ' is-alerta' : '') + '">Próxima ação: ' + esc(k.proximaBr) + '</span>' : '') +
+    '<span class="fin-cob-ult">' + esc(k.ultima ? 'Última ação: ' + k.ultima.acao + ' por ' + k.ultima.por + ' em ' + k.ultima.emBr : 'Nenhuma ação registrada') + '</span>' +
+    (k.motivo ? '<span class="fin-cob-motivo">' + esc(k.motivo) + '</span>' : '') + '</button>';
+}
+function FinCobTela_desenhar_(r) {
+  var esc = FinCobTela_esc_, corpo = document.getElementById('finCobCorpo'); if (!corpo) return;
+  var faixa = [];
+  if (r.foto) faixa.push('<b>Fotografia de ' + esc(r.foto.concluidaEm) + '.</b>' + (r.foto.deHoje === false ? ' A fotografia de hoje ainda não saiu: os saldos são os desta.' : ''));
+  if (r.execucao) faixa.push('Execução da cobrança (vencidos com ação nos últimos 7 dias): <b>' + esc(r.execucao.texto) + '</b>' + (r.execucao.detalhe ? ' (' + esc(r.execucao.detalhe) + ')' : r.execucao.motivo ? ' (' + esc(r.execucao.motivo) + ')' : '') + '.');
+  faixa.push('Regras em vigor: "a vencer" com ' + esc(r.cfg.aVencer) + ' dias de antecedência; sem nova ação por ' + esc(r.cfg.contato) + ' dias, volta a "Vencido sem contato"; promessa com ' + esc(r.cfg.tolerancia) + ' dia(s) útil(eis) de tolerância. Mudam em Chaves e senhas > Regras do Financeiro.');
+  faixa.push(r.podeRegistrar ? 'Você pode registrar ações.' : 'Você vê o quadro, mas não registra ações (falta a caixa "Registrar ações da régua de cobrança"; peça ao responsável pelo sistema).');
+  var h = '<div class="vg-faixa is-neutra fin-cob-faixa" role="status">' + faixa.join(' ') + '</div>';
+  if (r.externaAviso) h += '<div class="vg-faixa is-alerta" role="status">' + esc(r.externaAviso) + '</div>';
+  if (r.semLista) {
+    corpo.innerHTML = h + '<div class="cadx-vazio bc-vazio" role="status"><strong>O quadro está sem os títulos.</strong><p>' + esc(r.semLista) + '</p><p><button type="button" class="cadx-btn" id="finCobPedirFoto" onclick="FinCobTela_pedirFoto_()">Pedir nova fotografia</button></p></div>';
+    return;
+  }
+  h += '<div class="fin-cob-quadro" role="list" aria-label="Etapas da cobrança">' + (r.colunas || []).map(function (col) {
+    var l = (r.cartoes || []).filter(function (k) { return k.etapa === col.id; });
+    return '<section class="fin-cob-col" role="listitem" data-etapa="' + esc(col.id) + '"><header><h4>' + esc(col.nome) + '</h4><span class="fin-cob-qtd">' + esc(col.qtd + (col.totalTxt ? ' · ' + col.totalTxt : '')) + '</span></header>' +
+      '<div class="fin-cob-cards">' + (l.length ? l.slice(0, FIN_COB_TELA.max).map(FinCobTela_cartao_).join('') + (l.length > FIN_COB_TELA.max ? '<p class="fin-cob-mais">E mais ' + (l.length - FIN_COB_TELA.max) + ' título(s): use a busca acima.</p>' : '') : '<p class="fin-cob-vazio">Nenhum título nesta etapa.</p>') + '</div></section>';
+  }).join('') + '</div>';
+  corpo.innerHTML = h;
+  FinCobTela_filtrar_();
+}
+function FinCobTela_filtrar_() {
+  var b = document.getElementById('finCobBusca'), q = b ? String(b.value || '').trim().toLowerCase() : '';
+  document.querySelectorAll('#finCobCorpo .fin-cob-card').forEach(function (el) { el.style.display = !q || (el.getAttribute('data-busca') || '').indexOf(q) >= 0 ? '' : 'none'; });
+}
+function FinCobTela_pedirFoto_() {
+  var b = document.getElementById('finCobPedirFoto'); if (b) b.disabled = true;
+  FinCobTela_rpc_('Fin_apiFotoPedir', {}, function (r) { FinCobTela_aviso_(r.mensagem); }, function (m) { FinCobTela_aviso_(m); if (b) b.disabled = false; });
+}
+
+// ------------------------------------------------------------ painel do título
+function FinCobTela_fechar_() { FIN_COB_TELA.titulo = null; var p = document.getElementById('finCobPainel'); if (p) p.innerHTML = ''; }
+function FinCobTela_opcoes_(l, vazio) { return (vazio ? '<option value="">' + FinCobTela_esc_(vazio) + '</option>' : '') + (l || []).map(function (o) { return '<option value="' + FinCobTela_esc_(o[0]) + '">' + FinCobTela_esc_(o[1]) + '</option>'; }).join(''); }
+function FinCobTela_abrirTitulo_(id, recarga) {
