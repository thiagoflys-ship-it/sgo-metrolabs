+    SGO_DATA.update(EMAIL_ABA_CONTATOS, r.ID, { STATUS: 'EXCLUIDO', ATUALIZADO_EM: new Date().toISOString() });
+    return { id: Email_s_(r.ID) };
+  });
+}
+function Email_apiContatoFavorito(sessionId, payload) {
+  return Email_resposta_(function () {
+    var eu = Email_eu_(sessionId), p = payload || {}, r = Email_contatoMeu_(eu, p.id);
+    SGO_DATA.update(EMAIL_ABA_CONTATOS, r.ID, { FAVORITO: p.favorito ? 'SIM' : 'NAO', ATUALIZADO_EM: new Date().toISOString() });
+    return { id: Email_s_(r.ID), favorito: !!p.favorito };
+  });
+}
+/** Liga ou desliga a coleta automática (só da própria pessoa). */
+function Email_apiContatosPrefs(sessionId, payload) {
+  return Email_resposta_(function () {
+    var eu = Email_eu_(sessionId), p = payload || {};
+    var props = PropertiesService.getScriptProperties(), t = {};
+    try { t = JSON.parse(props.getProperty(EMAIL_CONTATOS_PREF_PROP) || '{}') || {}; } catch (e) { t = {}; }
+    t[eu.id] = { coletar: p.coletar !== false };
+    props.setProperty(EMAIL_CONTATOS_PREF_PROP, JSON.stringify(t));
+    return { prefs: Email_contatosPrefs_(eu.id) };
+  });
+}
+/**
+ * Depois de um envio pela caixa pessoal: conta o uso (recentes primeiro nas sugestões) e, com a coleta ligada, guarda os
+ * endereços novos como contato "Guardado ao enviar". Endereço excluído pela pessoa não volta sozinho. Nunca lança erro.
+ */
+function Email_coletarDestinatarios_(eu, msg) {
+  try {
+    var lista = Email_enderecosDe_([msg.para, msg.cc, msg.cco].join(';')).filter(function (x) { return x.email !== eu.email; }).slice(0, EMAIL_CONTATOS_COLETA_MAX);
+    if (!lista.length) return 0;
+    var coletar = Email_contatosPrefs_(eu.id).coletar, meus = Email_contatosLinhas_(eu.id), porEmail = {}, agora = new Date().toISOString(), novos = 0;
+    meus.forEach(function (r) { porEmail[Email_s_(r.EMAIL).toLowerCase()] = r; });
+    var ativos = meus.filter(Email_contatoAtivo_).length;
+    Email_garantirAbaContatos_();
+    lista.forEach(function (x) {
+      var r = porEmail[x.email];
+      if (r) {
+        if (!Email_contatoAtivo_(r)) return;
+        SGO_DATA.update(EMAIL_ABA_CONTATOS, r.ID, { USOS: (Number(r.USOS) || 0) + 1, ULTIMO_USO: agora });
+        return;
+      }
+      if (!coletar || ativos >= EMAIL_CONTATOS_MAX) return;
+      SGO_DATA.insert(EMAIL_ABA_CONTATOS, { USUARIO_ID: eu.id, NOME: x.nome || x.email.split('@')[0], EMAIL: x.email, EMPRESA: '', TELEFONE: '', OBS: '', FAVORITO: 'NAO', ORIGEM: 'AUTOMATICO',
+        USOS: 1, ULTIMO_USO: agora, STATUS: 'ATIVO', ATUALIZADO_EM: agora });
+      ativos++; novos++;
+    });
+    return novos;
+  } catch (e) { return 0; }
+}
+/** A conta usada no envio é a caixa pessoal da pessoa? (envio por caixa compartilhada não coleta contato pessoal) */
+function Email_contaEhPessoal_(eu, conta) {
+  try { var s = Email_chamar_(eu, 'situacao'); return !!(s && s.pessoal && (!conta || s.pessoal.id === conta)); } catch (e) { return false; }
+}
