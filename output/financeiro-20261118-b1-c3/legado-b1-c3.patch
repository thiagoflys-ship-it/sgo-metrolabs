+    (a.lidoEm ? 'Realizado lido do Omie em ' + a.lidoEm + '.' : 'O realizado deste mês ainda não foi lido do Omie: toque em "Ler o realizado deste mês no Omie".') + (a.naoLidos.length ? ' Meses do ano sem realizado lido (fora do acumulado): ' + a.naoLidos.join(', ') + '.' : '')) + '</p>';
+  if (!a.linhas.length) { alvo.innerHTML = h + '<div class="cadx-vazio bc-vazio">Nada para comparar neste mês.</div>'; return; }
+  var t = a.totais;
+  h += '<div class="fin-orc-kpis"><div><span>Despesa orçada no mês</span><strong>' + esc(FinOrcTela_moeda_(t.despesaOrcado)) + '</strong></div><div><span>Despesa realizada no mês</span><strong>' + esc(t.despesaRealizado === null ? 'não lida' : FinOrcTela_moeda_(t.despesaRealizado)) + '</strong></div><div><span>Desvio acumulado no ano (despesa)</span><strong>' + esc(FinOrcTela_moeda_(t.despesaAcRealizado - t.despesaAcOrcado)) + '</strong></div></div>';
