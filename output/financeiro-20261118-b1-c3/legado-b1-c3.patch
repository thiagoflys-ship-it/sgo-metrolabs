diff -ruN cand23/SGO_Financeiro_ContaCorrente.js cand24/SGO_Financeiro_ContaCorrente.js
--- cand23/SGO_Financeiro_ContaCorrente.js	1969-12-31 21:00:00.000000000 -0300
+++ cand24/SGO_Financeiro_ContaCorrente.js	2026-11-18 11:17:46.798020900 -0300
@@ -0,0 +1,97 @@
+/**
+ * Painel financeiro > Lançamentos e baixas > Lançamento avulso na conta corrente (pendência da onda 1, 18/11/2026).
+ * Especificação: output/financeiro-20261116/especialistas/ESPEC_FINANCEIRO.md, seção 6, item 7 ("Transferência entre contas e
+ * lançamentos avulsos de conta corrente: tarifa bancária, rendimento, aporte"), e ESPEC_ONDA2_FINANCEIRO.md, seção 5.
+ *
+ * Método do Omie (documentação pública financas/contacorrentelancamentos/, conferida em 18/11/2026): IncluirLancCC, com
+ *   cCodIntLanc (código de integração, até 20 caracteres), cabecalho { nCodCC, dDtLanc (dd/mm/aaaa), nValorLanc },
+ *   detalhes { cCodCateg, cTipo, cNumDoc, cObs }, transferencia { nCodCCDestino }; resposta nCodLanc, cCodIntLanc, cCodStatus ("0" =
+ *   sucesso), cDesStatus. Também existem AlterarLancCC, ExcluirLancCC, ConsultaLancCC e ListarLancCC (não usados aqui).
+ * [A CONFIRMAR NA 1ª OPERAÇÃO] (a documentação não diz):
+ *   1. o sentido do lançamento: o SGO+ envia nValorLanc sempre positivo e conta que o Omie decide saída ou entrada pela categoria
+ *      (despesa = saída; receita = entrada). A documentação não tem campo de débito ou crédito na inclusão;
+ *   2. na transferência: se o Omie cria sozinho a entrada na conta de destino e se a categoria é exigida (o SGO+ só envia categoria
+ *      se a pessoa escolher uma de transferência);
+ *   3. se o cCodIntLanc repetido é recusado (o SGO+ não depende disso: o mesmo envio é barrado por 24 horas pela prévia).
+ * Enquanto não for confirmado, a prévia mostra essas linhas e a gravação no Omie segue a chave geral (desligada até a primeira
+ * operação acompanhada).
+ *
+ * Caminho: o mesmo de todas as gravações do Painel (OmieOps_apiPrevia / OmieOps_apiConfirmar em SGO_Omie_Operacoes.js): prévia com
+ * token de uso único, confirmação, trava de envio repetido, "Envios a conferir" e a trilha FIN_OMIE_OPERACOES (ação LANCAMENTO_CC).
+ * Não passa pela lista de aprovação de pagamentos (B1): registra o que o banco já fez (tarifa, rendimento) ou uma transferência entre
+ * contas da própria empresa, não o pagamento de uma conta a pagar. Caixa: FIN_OMIE_LANCAR.
+ */
+var FIN_LCC_TIPOS = { SAIDA: 'Saída da conta (tarifa, juros, IOF)', ENTRADA: 'Entrada na conta (rendimento, aporte, devolução)', TRANSFERENCIA: 'Transferência entre contas da empresa' };
+var FIN_LCC_DOCS = { TRA: 'Transferência', DEB: 'Débito em conta', CRE: 'Crédito em conta', TED: 'TED', DOC: 'DOC', DIN: 'Dinheiro', '99999': 'Outros' };
+var FIN_LCC_CAMINHO = 'financas/contacorrentelancamentos/';
+var FIN_LCC_A_CONFIRMAR = 'A confirmar na 1ª operação acompanhada: o SGO+ envia o valor positivo e o Omie decide saída ou entrada pela categoria (despesa = saída; receita = entrada). Depois do primeiro envio, confira o extrato da conta no Omie.';
+
+function FinLcc_s_(v, max) { return typeof OmieOps_texto_ === 'function' ? OmieOps_texto_(v, max) : String(v == null ? '' : v).trim().slice(0, max || 200); }
+/** Categoria conferida no Omie (ConsultarCategoria) para o tipo do lançamento. */
+function FinLcc_conferirCategoria_(tipo, codigo) {
+  var c = Omie_requisitar_('geral/categorias/', 'ConsultarCategoria', { codigo: codigo }) || {};
+  var nome = FinLcc_s_(c.descricao);
+  if (!nome) OmieOps_erro_('Não foi possível conferir a categoria ' + codigo + ' no Omie. Atualize a lista de categorias e escolha de novo. Nada foi preparado.');
+  if (c.conta_inativa === 'S' || c.inativo === 'S') OmieOps_erro_('A categoria "' + nome + '" está inativa no Omie. Nada foi preparado; escolha uma categoria ativa.');
+  if (c.totalizadora === 'S') OmieOps_erro_('A categoria "' + nome + '" é um grupo e não recebe lançamento. Nada foi preparado; escolha uma categoria de lançamento.');
+  if (tipo === 'SAIDA' && (c.conta_despesa !== 'S' || c.transferencia === 'S')) OmieOps_erro_('A categoria "' + nome + '" não é de despesa. Saída da conta (tarifa, juros, IOF) entra em categoria de despesa. Nada foi preparado; escolha outra categoria.');
+  if (tipo === 'ENTRADA' && (c.conta_receita !== 'S' || c.transferencia === 'S')) OmieOps_erro_('A categoria "' + nome + '" não é de receita. Entrada na conta (rendimento, aporte) entra em categoria de receita. Nada foi preparado; escolha outra categoria.');
+  if (tipo === 'TRANSFERENCIA' && c.transferencia !== 'S') OmieOps_erro_('A categoria "' + nome + '" não é de transferência entre contas. Na transferência, escolha uma categoria de transferência ou deixe a categoria vazia. Nada foi preparado.');
+  return nome;
+}
+function FinLcc_conta_(id) {
+  var c = Omie_requisitar_('geral/contacorrente/', 'ConsultarContaCorrente', { nCodCC: id }) || {};
+  var nome = FinLcc_s_(c.descricao);
+  if (!nome) OmieOps_erro_('Não foi possível conferir a conta corrente ' + id + ' no Omie. Atualize a lista e escolha de novo. Nada foi preparado.');
+  if (c.inativo === 'S') OmieOps_erro_('A conta corrente "' + nome + '" está inativa no Omie. Nada foi preparado.');
+  return nome;
+}
+/**
+ * Monta a operação (chamada por OmieOps_preparar_ quando acao = 'avulso'). d: { tipoLanc, contaId, contaDestinoId, data, valor,
+ * categoria, tipoDoc, documento, observacao, referencia }. Lê no Omie a categoria e as contas (sem gravar nada).
+ */
+function FinLcc_preparar_(d) {
+  d = d || {};
+  var tipo = FinLcc_s_(d.tipoLanc, 20).toUpperCase();
+  if (!FIN_LCC_TIPOS[tipo]) OmieOps_erro_('Escolha o tipo do lançamento: saída, entrada ou transferência entre contas. Nada foi preparado.');
+  // valor em reais com vírgula (1.250,00) também é aceito, além do número do campo da tela
+  var bruto = typeof d.valor === 'string' && d.valor.indexOf(',') >= 0 && typeof OmieRegras_dinheiro_ === 'function' ? OmieRegras_dinheiro_(d.valor) : d.valor;
+  var conta = OmieOps_id_(d.contaId), data = OmieOps_data_(d.data), valor = OmieOps_num_(bruto, 'um valor'), cat = FinLcc_s_(d.categoria, 20), ref = FinLcc_s_(d.referencia, 20);
+  if (!/^[0-9A-Za-z._\-]{4,20}$/.test(ref)) OmieOps_erro_('Informe a referência única do lançamento (de 4 a 20 letras, números, ponto, hífen ou sublinhado; ex.: LCC-20261118-01). Ela impede o lançamento em dobro. Nada foi preparado.');
+  if (tipo !== 'TRANSFERENCIA' && !cat) OmieOps_erro_('Escolha a categoria do lançamento (despesa na saída; receita na entrada). Nada foi preparado.');
+  var docTipo = FinLcc_s_(d.tipoDoc, 5) || (tipo === 'TRANSFERENCIA' ? 'TRA' : tipo === 'SAIDA' ? 'DEB' : 'CRE');
+  if (!FIN_LCC_DOCS[docTipo]) OmieOps_erro_('Escolha o tipo de documento da lista. Nada foi preparado.');
+  var destino = 0, nomeDestino = '';
+  if (tipo === 'TRANSFERENCIA') {
+    destino = OmieOps_id_(d.contaDestinoId);
+    if (destino === conta) OmieOps_erro_('A conta de destino é a mesma de origem. Nada foi preparado; escolha outra conta de destino.');
+  }
+  var nomeConta = FinLcc_conta_(conta), nomeCat = cat ? FinLcc_conferirCategoria_(tipo, cat) : '';
+  if (destino) nomeDestino = FinLcc_conta_(destino);
+  var param = { cCodIntLanc: ref, cabecalho: { nCodCC: conta, dDtLanc: data, nValorLanc: valor }, detalhes: { cTipo: docTipo, cNumDoc: FinLcc_s_(d.documento, 20), cObs: OmieOps_obs_(d.observacao) } };
+  if (cat) param.detalhes.cCodCateg = cat;
+  if (destino) param.transferencia = { nCodCCDestino: destino };
+  var efeito = tipo === 'SAIDA' ? OmieOps_moeda_(valor) + ' saem da conta "' + nomeConta + '" no Omie.' : tipo === 'ENTRADA' ? OmieOps_moeda_(valor) + ' entram na conta "' + nomeConta + '" no Omie.' :
+    OmieOps_moeda_(valor) + ' saem de "' + nomeConta + '" e entram em "' + nomeDestino + '" no Omie (a mesma empresa: o resultado do mês não muda).';
+  var resumo = [['Tipo', FIN_LCC_TIPOS[tipo]], ['Conta corrente', nomeConta]];
+  if (destino) resumo.push(['Conta de destino', nomeDestino]);
+  resumo.push(['Data', data], ['Valor', OmieOps_moeda_(valor)], ['Categoria', nomeCat || 'Sem categoria (transferência)'], ['Documento', FIN_LCC_DOCS[docTipo] + (param.detalhes.cNumDoc ? ' nº ' + param.detalhes.cNumDoc : '')],
+    ['Observação', param.detalhes.cObs], ['Referência única', ref], ['Efeito', efeito + ' Não movimenta o banco: só registra no Omie o que o banco já fez ou fará.'],
+    ['A confirmar', FIN_LCC_A_CONFIRMAR + (destino ? ' Na transferência, confira também se a entrada apareceu na conta de destino.' : '')]);
+  return { acao: 'avulso', tipo: 'cc', caminho: FIN_LCC_CAMINHO, call: 'IncluirLancCC', param: param, resumo: resumo, anterior: null, snapshot: '', consultaEm: 0,
+    trilha: { documento: (param.detalhes.cNumDoc || ref).slice(0, 60), valor: valor, data: data, conta: String(conta) }, tipoLanc: tipo };
+}
+/** Categorias do Omie para o tipo do avulso. payload: { tipoLanc, pagina }. */
+function OmieLcc_apiCategorias(sessionId, payload) {
+  return OmieOps_resposta_(function () {
+    Omie_exigirAcesso_(sessionId); var p = payload || {}, tipo = FinLcc_s_(p.tipoLanc, 20).toUpperCase();
+    if (!FIN_LCC_TIPOS[tipo]) OmieOps_erro_('Escolha o tipo do lançamento.');
+    var todas = typeof OmieRegras_categoriasOmie_ === 'function' ? OmieRegras_categoriasOmie_() : [];
+    return { itens: todas.filter(function (c) {
+      if (!c || c.totalizadora === 'S' || c.conta_inativa === 'S' || c.inativo === 'S' || c.nao_exibir === 'S') return false;
+      if (tipo === 'TRANSFERENCIA') return c.transferencia === 'S';
+      if (c.transferencia === 'S') return false;
+      return tipo === 'SAIDA' ? c.conta_despesa === 'S' : c.conta_receita === 'S';
+    }).map(function (c) { return { id: String(c.codigo), nome: FinLcc_s_(c.descricao, 160) }; }), tipos: FIN_LCC_TIPOS, docs: FIN_LCC_DOCS };
+  });
+}
