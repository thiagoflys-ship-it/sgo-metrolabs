+  corpo.querySelectorAll('[data-orc-tirar]').forEach(function (b) { b.onclick = function () { FinOrcTela_chamar_('OmieOrc_apiSalvar', { versaoId: p.id, remover: [b.getAttribute('data-orc-tirar')] }, b); }; });
+}
+function FinOrcTela_chamar_(nome, dados, botao) {
