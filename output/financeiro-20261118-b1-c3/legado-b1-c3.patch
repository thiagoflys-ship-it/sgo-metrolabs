+    return '<tr class="' + (l.desfavoravel ? 'is-ruim' : '') + '"><td data-r="Categoria">' + esc(l.descricao + (l.semOrcamento ? ' (sem orçamento)' : '')) + '</td><td data-r="Orçado" class="num">' + esc(FinOrcTela_moeda_(l.orcado)) + '</td><td data-r="Realizado" class="num">' + esc(l.realizado === null ? 'não lido' : FinOrcTela_moeda_(l.realizado)) + '</td>' +
