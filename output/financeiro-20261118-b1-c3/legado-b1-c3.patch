+    return FinPagTela_item_(x, '<div class="fin-pag-acoes">' + (r.podeEnviar ? '<button type="button" class="cadx-btn cadx-btn-primario" data-pag-baixa="' + esc(x.titulo) + '">Registrar a baixa</button>' : '') + (x.podeRetirar && r.podeEnviar ? '<button type="button" class="cadx-btn" data-pag-acao="retirar" data-pag="' + esc(x.id) + '">Retirar da lista</button>' : '') + '</div><div data-pag-form="' + esc(x.id) + '"></div>');
+  }).join('') + '</div>';
+  // 4. montar a lista do dia (Financeiro)
+  if (r.podeEnviar) {
