+        return '<div class="fin-pag-cand' + (t.podeEnviar ? '' : ' is-bloq') + '"><label for="' + id + '"><input type="checkbox" id="' + id + '" name="finPagSel" value="' + esc(t.id) + '"' + (t.marcado ? ' checked' : '') + (t.podeEnviar ? '' : ' disabled') + '> <strong>' + esc(t.documento + (t.fornecedor ? ' · ' + t.fornecedor : '')) + '</strong></label>' +
+          '<p>' + esc('Vencimento ' + t.vencimento + (t.vencido ? ' (vencido)' : '') + ' · ' + t.valorTxt + ' · ' + t.origemNome) + '</p>' + (t.dispensado ? '<p class="fin-pag-nota">Dispensa aprovação: a baixa já está liberada.</p>' : '') + (t.texto ? '<p class="fin-pag-sit">' + esc(t.texto) + '</p>' : '') + '</div>';
