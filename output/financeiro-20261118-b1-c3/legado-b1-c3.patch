+    if (acao === 'retirar') { bts[0].disabled = true; FinPagTela_rpc_('OmiePag_apiRetirar', { item: id, motivo: mot }, function (r) { FinPagTela_carregar_(r.mensagem); }, function (m) { bts[0].disabled = false; FinPagTela_aviso_(m, 'erro'); }); return; }
+    FinPagTela_decidir_({ decisao: acao, itens: [id], motivo: mot, adiarPara: acao === 'adiar' ? document.getElementById(did).value : '' }, bts[0]);
+  };
+  try { document.getElementById(mid).focus(); } catch (e) {}
+}
+/** Abre Lançamentos e baixas com a baixa do título aprovado (a conta a pagar). */
