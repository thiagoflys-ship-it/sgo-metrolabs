+    var leitor = new FileReader(); leitor.onload = function () { enviar(String(leitor.result || '')); }; leitor.onerror = function () { FinOrcTela_aviso_('O navegador não conseguiu ler o arquivo. Cole o conteúdo no campo.', 'erro'); }; leitor.readAsText(arq.files[0], 'UTF-8'); return;
