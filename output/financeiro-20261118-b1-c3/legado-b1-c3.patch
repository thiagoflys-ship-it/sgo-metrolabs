diff -ruN cand23/JS_Financeiro_ContaCorrente.html cand24/JS_Financeiro_ContaCorrente.html
--- cand23/JS_Financeiro_ContaCorrente.html	1969-12-31 21:00:00.000000000 -0300
+++ cand24/JS_Financeiro_ContaCorrente.html	2026-11-18 11:08:22.895058800 -0300
@@ -0,0 +1,58 @@
+<script>
+/*
+ * Painel financeiro > Lançamentos e baixas > "Lançamento avulso na conta" (pendência da onda 1, 18/11/2026). Servidor:
+ * SGO_Financeiro_ContaCorrente.js (FinLcc_preparar_, OmieLcc_apiCategorias), pelo mesmo caminho das outras gravações
+ * (OmieOps_apiPrevia e OmieOps_apiConfirmar, com acao = 'avulso'). O formulário usa o id omieOpsForm para reaproveitar a prévia,
+ * a confirmação e a alçada de Lançamentos e baixas (JS_Omie_Operacoes.html). Campos: JS_Omie_Ajuda.html (chaves "ops-avulso:").
+ */
+function FinLccTela_ref_() {
+  var d = new Date(), z = function (n) { return ('0' + n).slice(-2); };
+  return 'LCC-' + d.getFullYear() + z(d.getMonth() + 1) + z(d.getDate()) + '-' + Math.random().toString(36).slice(2, 6).toUpperCase();
+}
+function FinLccTela_form_() {
+  if (typeof OMIE_OPS_UI === 'undefined') return;
+  OMIE_OPS_UI.geracao++; OMIE_OPS_UI.token = ''; OMIE_OPS_UI.acao = 'avulso'; OMIE_OPS_UI.id = 0; OMIE_OPS_UI.apoios = {};
+  var editor = document.getElementById('omieOpsEditor'); if (!editor) return;
+  var esc = typeof OmieOps_esc_ === 'function' ? OmieOps_esc_ : function (v) { return String(v == null ? '' : v); };
+  if (typeof OmieOps_aviso_ === 'function') OmieOps_aviso_('');
+  var hoje = new Date(), iso = hoje.getFullYear() + '-' + ('0' + (hoje.getMonth() + 1)).slice(-2) + '-' + ('0' + hoje.getDate()).slice(-2);
+  editor.innerHTML = '<section class="chvx-grupo fin-lcc" style="padding:16px;margin-top:16px"><h3>Lançamento avulso na conta corrente</h3>' +
+    '<p class="fin-lcc-intro">Para registrar no Omie o que o banco já fez e não tem título: tarifa bancária, juros ou IOF (saída), rendimento, aporte ou devolução (entrada) e transferência entre contas da própria empresa. Não serve para pagar fornecedor nem receber de cliente: esses são baixas de títulos. A prévia mostra o que será enviado; nada é gravado no Omie antes de "Confirmar no Omie".</p>' +
+    '<form id="omieOpsForm" onsubmit="event.preventDefault();OmieOps_previa_()"><div class="fin-lcc-grade">' +
+    '<label class="cadx-campo">Tipo do lançamento<select class="cadx-input" name="tipoLanc" id="finLccTipo" required><option value="SAIDA">Saída da conta (tarifa, juros, IOF)</option><option value="ENTRADA">Entrada na conta (rendimento, aporte, devolução)</option><option value="TRANSFERENCIA">Transferência entre contas da empresa</option></select></label>' +
+    '<label class="cadx-campo">Conta corrente<select class="cadx-input" name="contaId" id="finLccConta" required><option value="">Carregando contas…</option></select></label>' +
+    '<label class="cadx-campo" id="finLccDestinoCampo" hidden>Conta de destino<select class="cadx-input" name="contaDestinoId" id="finLccDestino"><option value="">Carregando contas…</option></select></label>' +
+    '<label class="cadx-campo">Data<input class="cadx-input" type="date" name="data" value="' + iso + '" required></label>' +
+    '<label class="cadx-campo">Valor (R$)<input class="cadx-input" type="number" name="valor" step="0.01" min="0.01" required></label>' +
+    '<label class="cadx-campo">Categoria<select class="cadx-input" name="categoria" id="finLccCat"><option value="">Carregando categorias…</option></select></label>' +
+    '<label class="cadx-campo">Tipo de documento<select class="cadx-input" name="tipoDoc"><option value="">Conforme o tipo do lançamento</option><option value="DEB">Débito em conta</option><option value="CRE">Crédito em conta</option><option value="TRA">Transferência</option><option value="TED">TED</option><option value="DOC">DOC</option><option value="DIN">Dinheiro</option><option value="99999">Outros</option></select></label>' +
+    '<label class="cadx-campo">Número do documento (opcional)<input class="cadx-input" type="text" name="documento" maxlength="20"></label>' +
+    '<label class="cadx-campo">Referência única do lançamento<input class="cadx-input" type="text" name="referencia" maxlength="20" required value="' + esc(FinLccTela_ref_()) + '"></label>' +
+    '</div><label class="cadx-campo">Observação<textarea class="cadx-input" name="observacao" maxlength="1000"></textarea></label>' +
+    '<div class="omie-acoes"><button class="cadx-btn cadx-btn-primario" id="omieOpsPrever" type="submit">Conferir prévia</button> <button type="button" class="cadx-btn" onclick="OmieOps_fechar_()">Fechar</button></div></form><div id="omieOpsPrevia"></div></section>';
+  document.getElementById('finLccTipo').onchange = FinLccTela_tipo_;
+  OmieOps_rpc_('OmieOps_apiApoios', { tipo: 'contas', pagina: 1 }, function (r) {
+    ['finLccConta', 'finLccDestino'].forEach(function (id) {
+      var s = document.getElementById(id); if (!s) return;
+      s.innerHTML = '<option value="">Selecione…</option>' + r.itens.map(function (i) { return '<option value="' + esc(i.id) + '">' + esc(i.nome) + '</option>'; }).join('');
+    });
+  }, function (m) { OmieOps_aviso_(m); });
+  FinLccTela_tipo_();
+  try { editor.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (_) {}
+}
+function FinLccTela_tipo_() {
+  var t = document.getElementById('finLccTipo'), cat = document.getElementById('finLccCat'), dest = document.getElementById('finLccDestinoCampo'), sel = document.getElementById('finLccDestino'); if (!t || !cat) return;
+  var transf = t.value === 'TRANSFERENCIA';
+  if (dest) dest.hidden = !transf; if (sel) sel.required = transf;
+  cat.required = !transf; cat.innerHTML = '<option value="">Carregando categorias…</option>';
+  OmieOps_rpc_('OmieLcc_apiCategorias', { tipoLanc: t.value }, function (r) {
+    var c = document.getElementById('finLccCat'); if (!c || document.getElementById('finLccTipo').value !== t.value) return;
+    c.innerHTML = '<option value="">' + (transf ? 'Sem categoria (o Omie usa a de transferência)' : 'Selecione…') + '</option>' + r.itens.map(function (i) { return '<option value="' + OmieOps_esc_(i.id) + '">' + OmieOps_esc_(i.nome) + '</option>'; }).join('');
+  }, function (m) { OmieOps_aviso_(m); });
+}
+</script>
+<style>
+  #omieTela .fin-lcc-intro { text-align:justify; line-height:1.5; }
+  #omieTela .fin-lcc-grade { display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap:12px; }
+  #omieTela .fin-lcc-grade [hidden] { display:none; }
+</style>
diff -ruN cand23/JS_Financeiro_Orcamento.html cand24/JS_Financeiro_Orcamento.html
--- cand23/JS_Financeiro_Orcamento.html	1969-12-31 21:00:00.000000000 -0300
+++ cand24/JS_Financeiro_Orcamento.html	2026-11-18 11:26:10.978449900 -0300
@@ -0,0 +1,196 @@
+<script>
+/*
+ * Painel financeiro > Orçamento anual (Onda C do Financeiro, C3, 18/11/2026). Servidor: SGO_Financeiro_Orcamento.js (OmieOrc_apiTela,
+ * OmieOrc_apiCategorias, OmieOrc_apiNovo, OmieOrc_apiSalvar, OmieOrc_apiImportar, OmieOrc_apiEnviar, OmieOrc_apiRetirar, OmieOrc_apiDecidir,
+ * OmieOrc_apiAcompanhar). O SGO+ é a fonte do orçamento; o Omie não recebe orçamento pela API (só leitura do realizado).
+ * As células da grade não ganham uma explicação cada uma: apontam (aria-describedby) para a explicação única acima da grade.
+ * Guia e campos: JS_Omie_Ajuda.html (OMIE_GUIAS.orcamento).
+ */
+var FIN_ORC_TELA = { geracao: 0, ano: 0, dados: null, mes: '', originais: {} };
+function FinOrcTela_esc_(v) { return typeof CadUI_esc_ === 'function' ? CadUI_esc_(v) : String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+function FinOrcTela_rpc_(nome, dados, ok, erro) {
+  var g = FIN_ORC_TELA.geracao, sessao = SGO_getSessionId(), pedido = typeof OMIE_TELA !== 'undefined' ? OMIE_TELA.pedido : null;
+  function atual() { return g === FIN_ORC_TELA.geracao && sessao === SGO_getSessionId() && (typeof OMIE_TELA === 'undefined' || pedido === OMIE_TELA.pedido); }
+  google.script.run.withSuccessHandler(function (r) { if (!atual()) return; if (!r || !r.ok) { (erro || FinOrcTela_aviso_)(r && r.mensagem || 'Não foi possível concluir. Tente de novo.'); return; } ok(r); })
+    .withFailureHandler(function () { if (atual()) (erro || FinOrcTela_aviso_)('A comunicação com o servidor foi interrompida. Atualize a tela antes de repetir.'); })[nome](sessao, dados || {});
+}
+function FinOrcTela_aviso_(m, tipo) { var e = document.getElementById('finOrcAviso'); if (!e) return; e.textContent = m || ''; e.className = 'fin-orc-aviso' + (m && tipo ? ' is-' + tipo : ''); }
+function FinOrcTela_moeda_(n) { return n === null || n === undefined || n === '' || !isFinite(Number(n)) ? '' : Number(n).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }); }
+function FinOrcTela_num_(n) { return n === null || n === undefined || n === '' ? '' : Number(n).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
+function FinOrcTela_render_() {
+  var c = document.getElementById('omieCorpo'); if (!c) return;
+  FIN_ORC_TELA.geracao++;
+  var hoje = new Date();
+  if (!FIN_ORC_TELA.ano) FIN_ORC_TELA.ano = hoje.getFullYear();
+  if (!FIN_ORC_TELA.mes) FIN_ORC_TELA.mes = hoje.getFullYear() + '-' + ('0' + (hoje.getMonth() + 1)).slice(-2);
+  c.innerHTML = '<section class="fin-orc"><h3>Orçamento anual</h3>' +
+    '<p class="fin-orc-intro">O orçamento da empresa fica no SGO+, por categoria do plano de contas do Omie e por mês, com versão e motivo. O Financeiro prepara (em branco, por planilha, copiando o ano anterior ou partindo do realizado do ano anterior) e envia; o dono do sistema ou a Diretoria aprova a versão vigente. O acompanhamento compara o orçado com o realizado lido do Omie e mostra o desvio, que também aparece em Indicadores e no relatório semanal. O Omie não recebe orçamento pela API (ela só permite ler): se quiser o mesmo orçamento no Omie, use a planilha da versão vigente.</p>' +
+    '<div class="cadx-faixa bc-faixa fin-orc-barra"><label for="finOrcAno">Ano<select class="cadx-input" id="finOrcAno"><option value="' + FIN_ORC_TELA.ano + '">' + FIN_ORC_TELA.ano + '</option></select></label><button type="button" class="cadx-btn" onclick="FinOrcTela_trocarAno_()">Abrir o ano</button></div>' +
+    '<p id="finOrcAviso" class="fin-orc-aviso" role="status" aria-live="polite"></p><div id="finOrcCorpo">' + (typeof CadUI_esqueleto_ === 'function' ? CadUI_esqueleto_(3) : '<p>Carregando…</p>') + '</div>' +
+    '<h4 class="fin-orc-sub">Acompanhamento: orçado × realizado</h4><div class="omie-barra fin-orc-barra"><label for="finOrcMes">Mês<input class="cadx-input" type="month" id="finOrcMes" value="' + FinOrcTela_esc_(FIN_ORC_TELA.mes) + '"></label><button type="button" class="cadx-btn" onclick="FinOrcTela_acompanhar_(false)">Ver</button><button type="button" class="cadx-btn" onclick="FinOrcTela_acompanhar_(true)">Ler o realizado deste mês no Omie</button></div><div id="finOrcAcomp"></div></section>';
+  FinOrcTela_carregar_();
+  FinOrcTela_acompanhar_(false);
+}
+function FinOrcTela_trocarAno_() { var s = document.getElementById('finOrcAno'); if (s) FIN_ORC_TELA.ano = Number(s.value) || FIN_ORC_TELA.ano; FinOrcTela_carregar_(); }
+function FinOrcTela_carregar_(msg) {
+  FinOrcTela_aviso_('Lendo o orçamento…');
+  FinOrcTela_rpc_('OmieOrc_apiTela', { ano: FIN_ORC_TELA.ano }, function (r) { FIN_ORC_TELA.dados = r; FinOrcTela_desenhar_(r); FinOrcTela_aviso_(msg || '', msg ? 'ok' : ''); },
+    function (m) { FinOrcTela_aviso_(''); var corpo = document.getElementById('finOrcCorpo'); if (corpo) corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="alert"><strong>O orçamento não abriu.</strong><p>' + FinOrcTela_esc_(m) + '</p></div>'; });
+}
+function FinOrcTela_grade_(v, editavel) {
+  var esc = FinOrcTela_esc_, meses = FIN_ORC_TELA.dados.meses;
+  if (!v.linhas.length) return '<p class="fin-orc-nota">Nenhuma categoria ainda. ' + (editavel ? 'Inclua categorias abaixo ou importe uma planilha.' : '') + '</p>';
+  FIN_ORC_TELA.originais = {};
+  return '<p class="fin-orc-nota" id="finOrcGradeDica">Cada célula é o valor orçado da categoria no mês, em reais (ex.: 1.250,00). Vazio = sem orçamento naquele mês. Despesas e receitas usam as categorias do plano de contas do Omie.' + (editavel ? ' Grave para guardar o que mudou; só as células alteradas são enviadas.' : '') + '</p>' +
+    '<div class="fin-orc-grade"><table><thead><tr><th>Categoria</th>' + meses.map(function (m) { return '<th>' + esc(m) + '</th>'; }).join('') + '<th>Total</th>' + (editavel ? '<th></th>' : '') + '</tr></thead><tbody>' + v.linhas.map(function (l) {
+      return '<tr><th scope="row">' + esc(l.codigo + ' · ' + l.descricao) + '<br><span class="fin-orc-nat">' + esc(l.natureza) + '</span></th>' + l.meses.map(function (x, i) {
+        var val = FinOrcTela_num_(x);
+        if (editavel) { FIN_ORC_TELA.originais[l.codigo + '|' + (i + 1)] = val; return '<td data-r="' + esc(meses[i]) + '"><input class="cadx-input fin-orc-cel" inputmode="decimal" data-omie-dica="1" aria-describedby="finOrcGradeDica" aria-label="' + esc(l.descricao + ', ' + meses[i]) + '" data-cod="' + esc(l.codigo) + '" data-mes="' + (i + 1) + '" value="' + esc(val) + '"></td>'; }
+        return '<td class="num" data-r="' + esc(meses[i]) + '">' + esc(val) + '</td>';
+      }).join('') + '<td class="num" data-r="Total"><strong>' + esc(FinOrcTela_num_(l.total)) + '</strong></td>' + (editavel ? '<td><button type="button" class="cadx-btn fin-orc-tirar" data-orc-tirar="' + esc(l.codigo) + '">Retirar</button></td>' : '') + '</tr>';
+    }).join('') + '</tbody></table></div>';
+}
+function FinOrcTela_cab_(v) {
+  var esc = FinOrcTela_esc_;
+  return '<p><strong>' + esc('Versão ' + v.versao + ' de ' + v.ano + ' · ' + v.situacaoNome) + '</strong></p><p class="fin-orc-nota">' + esc('Preparada por ' + v.preparadaPor + ' em ' + v.preparadaEm + ' · ponto de partida: ' + v.origem + '. ' + (v.origemDetalhe || '') +
+    (v.motivo ? ' Motivo: ' + v.motivo + '.' : '') + (v.decididaPor ? ' Decidida por ' + v.decididaPor + ' em ' + v.decididaEm + (v.motivoDecisao ? ': ' + v.motivoDecisao : '') + '.' : '') + ' Total de despesas ' + v.totalDespesa + '; de receitas ' + v.totalReceita + '.') + '</p>' +
+    (v.aguarda ? '<p class="fin-orc-sit">' + esc(v.aguarda) + '</p>' : '');
+}
+function FinOrcTela_desenhar_(r) {
+  var esc = FinOrcTela_esc_, corpo = document.getElementById('finOrcCorpo'); if (!corpo) return;
+  var sel = document.getElementById('finOrcAno');
+  if (sel) { sel.innerHTML = r.anos.map(function (a) { return '<option value="' + a + '"' + (a === r.ano ? ' selected' : '') + '>' + a + '</option>'; }).join(''); }
+  var h = '<h4 class="fin-orc-sub">' + esc('Versão vigente de ' + r.ano) + '</h4>';
+  if (r.vigente) {
+    h += '<div class="fin-orc-caixa is-vigente">' + FinOrcTela_cab_(r.vigente) + '<details><summary>Ver os valores da versão vigente</summary>' + FinOrcTela_grade_(r.vigente, false) + '</details>';
+    if (typeof OMIE_CSV !== 'undefined' && typeof OmieGest_botaoCsv_ === 'function') {
+      OMIE_CSV.orcamento = { cab: ['Código', 'Categoria'].concat(r.meses).concat(['Total']), linhas: r.vigente.linhas.map(function (l) { return [l.codigo, l.descricao].concat(l.meses.map(function (x) { return x === null ? '' : (typeof OmieGest_csvNum_ === 'function' ? OmieGest_csvNum_(x) : x); })).concat([typeof OmieGest_csvNum_ === 'function' ? OmieGest_csvNum_(l.total) : l.total]); }) };
+      h += OmieGest_botaoCsv_('orcamento', 'orcamento-' + r.ano + '-v' + r.vigente.versao + '.csv');
+    }
+    h += '</div>';
+  } else h += '<p class="fin-orc-nota">' + esc('Não há orçamento aprovado para ' + r.ano + '. Enquanto não houver, o acompanhamento, os Indicadores e o relatório semanal não comparam com o orçado do SGO+.') + '</p>';
+  h += '<h4 class="fin-orc-sub">Em preparação</h4>';
+  var p = r.preparo;
+  if (!p) {
+    h += '<p class="fin-orc-nota">Nenhuma versão em preparação.</p>';
+    if (r.podeEditar) h += '<div class="fin-orc-caixa"><label class="cadx-campo" for="finOrcPartida">Ponto de partida da nova versão<select class="cadx-input" id="finOrcPartida"><option value="VAZIO">Em branco</option>' + (r.temAnterior ? '<option value="COPIA_ANO_ANTERIOR">Cópia da versão vigente de ' + (r.ano - 1) + '</option>' : '') + '<option value="REALIZADO_ANO_ANTERIOR">' + esc('Realizado de ' + (r.ano - 1) + ' (lido do Omie)') + '</option>' + (r.vigente ? '<option value="COPIA_VIGENTE">Revisão da versão vigente de ' + r.ano + '</option>' : '') + '</select></label><div class="fin-orc-acoes"><button type="button" class="cadx-btn cadx-btn-primario" id="finOrcNovo">Criar rascunho</button></div></div>';
+  } else if (p.situacao === 'RASCUNHO') {
+    h += '<div class="fin-orc-caixa">' + FinOrcTela_cab_(p) + (r.podeEditar ? FinOrcTela_grade_(p, true) +
+      '<div class="fin-orc-acoes"><button type="button" class="cadx-btn cadx-btn-primario" id="finOrcGravar">Gravar o rascunho</button></div>' +
+      '<div class="fin-orc-linha"><label class="cadx-campo" for="finOrcNovaCat">Incluir categoria<select class="cadx-input" id="finOrcNovaCat"><option value="">Toque em "Carregar categorias"</option></select></label><div class="fin-orc-acoes"><button type="button" class="cadx-btn" id="finOrcCarregarCat">Carregar categorias</button><button type="button" class="cadx-btn" id="finOrcIncluir">Incluir</button></div></div>' +
+      '<details class="fin-orc-csv"><summary>Importar planilha (CSV)</summary><p class="fin-orc-nota">Uma linha por categoria: código da categoria no Omie; descrição (opcional); janeiro a dezembro, separados por ponto e vírgula, com vírgula nos centavos. Célula vazia mantém o valor que já está no rascunho.</p>' +
+      '<label class="cadx-campo" for="finOrcArquivo">Arquivo da planilha<input class="cadx-input" type="file" id="finOrcArquivo" accept=".csv,.txt,text/csv"></label><label class="cadx-campo" for="finOrcCsv">Ou cole aqui o conteúdo<textarea class="cadx-input" id="finOrcCsv" name="finOrcCsv" rows="4"></textarea></label><div class="fin-orc-acoes"><button type="button" class="cadx-btn" id="finOrcImportar">Importar no rascunho</button></div></details>' +
+      '<label class="cadx-campo" for="finOrcMotivo">Motivo da versão<textarea class="cadx-input" id="finOrcMotivo" name="finOrcMotivo" maxlength="600"></textarea></label>' +
+      '<div class="fin-orc-acoes"><button type="button" class="cadx-btn cadx-btn-primario" id="finOrcEnviar">Enviar para aprovação</button><button type="button" class="cadx-btn" id="finOrcDescartar">Descartar o rascunho</button></div>' : FinOrcTela_grade_(p, false)) + '</div>';
+  } else {
+    h += '<div class="fin-orc-caixa is-aguardando">' + FinOrcTela_cab_(p) + FinOrcTela_grade_(p, false);
+    if (p.podeDecidir) h += '<label class="cadx-campo" for="finOrcMotivoDecisao">Motivo da decisão (obrigatório para recusar)<textarea class="cadx-input" id="finOrcMotivoDecisao" name="finOrcMotivoDecisao" maxlength="600"></textarea></label><div class="fin-orc-acoes"><button type="button" class="cadx-btn cadx-btn-primario" id="finOrcAprovar">Aprovar como vigente</button><button type="button" class="cadx-btn" id="finOrcRecusar">Recusar</button></div>';
+    else if (p.meu || r.podeEditar) h += (p.meu ? '<p class="fin-orc-nota">Você preparou esta versão: outra pessoa (o dono ou a Diretoria) aprova.</p>' : '') + (r.podeEditar ? '<div class="fin-orc-acoes"><button type="button" class="cadx-btn" id="finOrcRetirar">Retirar da aprovação para ajustar</button></div>' : '');
+    h += '</div>';
+  }
+  if (r.versoes.length) h += '<details class="fin-orc-hist"><summary>' + esc('Todas as versões de ' + r.ano + ' (' + r.versoes.length + ')') + '</summary><ul>' + r.versoes.map(function (v) { return '<li>' + esc('Versão ' + v.versao + ' · ' + v.situacaoNome + ' · preparada por ' + v.preparadaPor + ' em ' + v.preparadaEm + (v.decididaPor ? ' · decidida por ' + v.decididaPor + ' em ' + v.decididaEm : '') + (v.motivo ? ' · ' + v.motivo : '') + (v.motivoDecisao ? ' · decisão: ' + v.motivoDecisao : '')) + '</li>'; }).join('') + '</ul></details>';
+  corpo.innerHTML = h;
+  var liga = function (id, fn) { var b = document.getElementById(id); if (b) b.onclick = function () { fn(b); }; };
+  liga('finOrcNovo', function (b) { FinOrcTela_chamar_('OmieOrc_apiNovo', { ano: r.ano, partida: document.getElementById('finOrcPartida').value }, b); });
