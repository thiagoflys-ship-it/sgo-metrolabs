+var FIN_ORC_SITUACOES = { RASCUNHO: 'Em preparação', AGUARDANDO: 'Aguardando aprovação', VIGENTE: 'Vigente', SUBSTITUIDA: 'Substituída por versão mais nova', RECUSADA: 'Recusada', DESCARTADA: 'Descartada' };
