+  FinOrcTela_rpc_('OmieOrc_apiAcompanhar', { mes: m.value, ler: !!ler }, function (r) { FinOrcTela_desenharAcomp_(r); }, function (msg) { alvo.innerHTML = '<p class="fin-orc-nota" role="alert">' + FinOrcTela_esc_(msg) + '</p>'; });
