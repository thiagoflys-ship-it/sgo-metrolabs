+  return (v < 0 ? '-' : '') + 'R$ ' + s[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + s[1];
+}
+function FinOrc_pct_(v) { return v === null || !isFinite(v) ? '' : (Math.round(v * 10) / 10).toFixed(1).replace('.', ',') + ' %'; }
+/** "1.234,56", "1234,5", "1234.56", número -> número com 2 casas; vazio -> null; inválido -> NaN. */
+function FinOrc_dinheiro_(v) {
