diff -ruN cand23/JS_Financeiro_Pagamentos.html cand24/JS_Financeiro_Pagamentos.html
--- cand23/JS_Financeiro_Pagamentos.html	1969-12-31 21:00:00.000000000 -0300
+++ cand24/JS_Financeiro_Pagamentos.html	2026-11-18 11:10:58.242615400 -0300
@@ -0,0 +1,152 @@
+<script>
+/*
+ * Painel financeiro > Aprovação de pagamentos (Onda B do Financeiro, B1, 18/11/2026). Servidor: SGO_Financeiro_Pagamentos.js (OmiePag_apiTela,
+ * OmiePag_apiEnviar, OmiePag_apiDecidir, OmiePag_apiRetirar). O Financeiro monta e envia a lista "a pagar hoje"; o dono ou a Diretoria aprova
+ * em lote, num toque, ou recusa ou adia item por item com motivo. A baixa de conta a pagar (Lançamentos e baixas) só é preparada depois.
+ * Guia e campos: JS_Omie_Ajuda.html (OMIE_GUIAS.pagamentos).
+ */
+var FIN_PAG_TELA = { geracao: 0, aVencer: false, dados: null };
+function FinPagTela_esc_(v) { return typeof CadUI_esc_ === 'function' ? CadUI_esc_(v) : String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+function FinPagTela_rpc_(nome, dados, ok, erro) {
+  var g = FIN_PAG_TELA.geracao, sessao = SGO_getSessionId(), pedido = typeof OMIE_TELA !== 'undefined' ? OMIE_TELA.pedido : null;
+  function atual() { return g === FIN_PAG_TELA.geracao && sessao === SGO_getSessionId() && (typeof OMIE_TELA === 'undefined' || pedido === OMIE_TELA.pedido); }
+  google.script.run.withSuccessHandler(function (r) { if (!atual()) return; if (!r || !r.ok) { (erro || FinPagTela_aviso_)(r && r.mensagem || 'Não foi possível concluir. Tente de novo.'); return; } ok(r); })
+    .withFailureHandler(function () { if (atual()) (erro || FinPagTela_aviso_)('A comunicação com o servidor foi interrompida. Atualize a lista antes de repetir.'); })[nome](sessao, dados || {});
+}
+function FinPagTela_aviso_(m, tipo) { var e = document.getElementById('finPagAviso'); if (!e) return; e.textContent = m || ''; e.className = 'fin-pag-aviso' + (m && tipo ? ' is-' + tipo : ''); }
+function FinPagTela_render_() {
+  var c = document.getElementById('omieCorpo'); if (!c) return;
+  FIN_PAG_TELA.geracao++;
+  c.innerHTML = '<section class="fin-pag"><h3>Aprovação de pagamentos</h3>' +
+    '<p class="fin-pag-intro">Por decisão do dono, toda conta a pagar é aprovada antes de ser paga. O Financeiro monta a lista do dia (as contas vencidas e as que vencem hoje, mais as que escolher) e envia; o dono do sistema ou a Diretoria aprova a lista num toque, ou recusa ou adia item por item, com o motivo. Só depois da aprovação a baixa (o registro do pagamento no Omie) fica liberada em Lançamentos e baixas. Nada aqui paga no banco nem grava no Omie.</p>' +
+    '<div class="cadx-faixa bc-faixa fin-pag-barra"><label for="finPagMostrar">Contas para a lista<select class="cadx-input" id="finPagMostrar"><option value="">Vencidas e de hoje</option><option value="1"' + (FIN_PAG_TELA.aVencer ? ' selected' : '') + '>Também as que vencem em até 30 dias</option></select></label><button type="button" class="cadx-btn" onclick="FinPagTela_atualizar_()">Atualizar</button></div>' +
+    '<p id="finPagAviso" class="fin-pag-aviso" role="status" aria-live="polite"></p><div id="finPagCorpo">' + (typeof CadUI_esqueleto_ === 'function' ? CadUI_esqueleto_(3) : '<p>Carregando…</p>') + '</div></section>';
+  FinPagTela_carregar_();
+}
+function FinPagTela_atualizar_() { var s = document.getElementById('finPagMostrar'); FIN_PAG_TELA.aVencer = !!(s && s.value); FinPagTela_carregar_(); }
+function FinPagTela_carregar_(msg) {
+  FinPagTela_aviso_('Lendo as contas a pagar no Omie e a lista de aprovação…');
+  FinPagTela_rpc_('OmiePag_apiTela', { aVencer: FIN_PAG_TELA.aVencer }, function (r) { FIN_PAG_TELA.dados = r; FinPagTela_desenhar_(r); FinPagTela_aviso_(msg || '', msg ? 'ok' : ''); },
+    function (m) { FinPagTela_aviso_(''); var corpo = document.getElementById('finPagCorpo'); if (corpo) corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="alert"><strong>A aprovação de pagamentos não abriu.</strong><p>' + FinPagTela_esc_(m) + '</p></div>'; });
+}
+function FinPagTela_item_(x, acoes) {
+  var esc = FinPagTela_esc_;
+  return '<article class="fin-pag-item is-' + esc(String(x.situacao || '').toLowerCase()) + '" data-pag-item="' + esc(x.id) + '"><div class="fin-pag-cab"><strong>' + esc((x.documento || 'título ' + x.titulo) + (x.fornecedor ? ' · ' + x.fornecedor : '')) + '</strong><span class="fin-pag-valor">' + esc(x.valorTxt) + '</span></div>' +
+    '<p>' + esc('Vencimento ' + x.vencimento + (x.vencido ? ' (vencido)' : '') + ' · ' + x.origem + (x.pagoTxt ? ' · pago até agora ' + x.pagoTxt : '')) + '</p>' +
+    '<p class="fin-pag-sit">' + esc(x.texto) + '</p>' + (x.obs ? '<p class="fin-pag-nota">' + esc('Observação de quem enviou: ' + x.obs) + '</p>' : '') + (acoes || '') + '</article>';
+}
+function FinPagTela_desenhar_(r) {
+  var esc = FinPagTela_esc_, corpo = document.getElementById('finPagCorpo'); if (!corpo) return;
+  var h = '';
+  if (r.dispensa) h += '<p class="fin-pag-nota">' + esc('Contas com valor abaixo de ' + r.dispensa + ' dispensam aprovação (Chaves e senhas > Regras do Financeiro).') + '</p>';
+  // 1. para a decisão do dono ou da Diretoria
+  if (r.podeDecidir) {
+    var meus = r.aguardando.filter(function (x) { return x.podeDecidir; });
+    h += '<h4 class="fin-pag-sub">Para a sua aprovação</h4>';
+    if (!meus.length) h += '<p class="fin-pag-nota">Nenhum pagamento aguardando a sua aprovação.' + (r.aguardando.length ? ' Os que aguardam foram enviados por você: outra pessoa decide.' : '') + '</p>';
+    else h += '<div class="fin-pag-lote"><p><strong>' + esc(meus.length + ' pagamento(s) aguardando, total ' + r.totalAguardando + '.') + '</strong> Confira a lista; para recusar ou adiar um item, use o botão do item. "Aprovar todos" aprova de uma vez os que sobrarem.</p>' +
+      '<button type="button" class="cadx-btn cadx-btn-primario" id="finPagAprovarTodos">Aprovar todos (' + meus.length + ')</button></div>' +
+      '<div class="fin-pag-lista">' + meus.map(function (x) { return FinPagTela_item_(x, '<div class="fin-pag-acoes"><button type="button" class="cadx-btn" data-pag-acao="aprovar" data-pag="' + esc(x.id) + '">Aprovar só este</button><button type="button" class="cadx-btn" data-pag-acao="recusar" data-pag="' + esc(x.id) + '">Recusar</button><button type="button" class="cadx-btn" data-pag-acao="adiar" data-pag="' + esc(x.id) + '">Adiar</button></div><div data-pag-form="' + esc(x.id) + '"></div>'); }).join('') + '</div>';
+  }
+  // 2. aguardando (visão de quem enviou)
+  var outros = r.aguardando.filter(function (x) { return !x.podeDecidir; });
+  if (outros.length || !r.podeDecidir) {
+    h += '<h4 class="fin-pag-sub">Aguardando aprovação</h4>';
+    h += !outros.length ? '<p class="fin-pag-nota">Nenhum pagamento aguardando aprovação.</p>' : '<p class="fin-pag-nota">' + esc('Quem aprova: ' + r.aprovadores + '. Enquanto aguarda, a baixa destes títulos fica travada em Lançamentos e baixas.') + '</p><div class="fin-pag-lista">' + outros.map(function (x) {
+      return FinPagTela_item_(x, x.podeRetirar && r.podeEnviar ? '<div class="fin-pag-acoes"><button type="button" class="cadx-btn" data-pag-acao="retirar" data-pag="' + esc(x.id) + '">Retirar da lista</button></div><div data-pag-form="' + esc(x.id) + '"></div>' : '');
+    }).join('') + '</div>';
+  }
+  // 3. aprovados: liberados para a baixa
