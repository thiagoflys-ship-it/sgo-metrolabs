+}
+function FinOrcTela_gravar_(botao) {
+  var p = FIN_ORC_TELA.dados && FIN_ORC_TELA.dados.preparo; if (!p) return;
+  var alt = [];
+  document.querySelectorAll('.fin-orc-cel').forEach(function (e) { var k = e.getAttribute('data-cod') + '|' + e.getAttribute('data-mes'); if (String(e.value).trim() !== String(FIN_ORC_TELA.originais[k] || '')) alt.push({ codigo: e.getAttribute('data-cod'), mes: Number(e.getAttribute('data-mes')), valor: String(e.value).trim() }); });
+  if (!alt.length) { FinOrcTela_aviso_('Nenhum valor foi mudado. Nada foi gravado.', 'erro'); return; }
