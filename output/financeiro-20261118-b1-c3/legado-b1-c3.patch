+  FinOrcTela_rpc_('OmieOrc_apiCategorias', {}, function (r) {
+    var s = document.getElementById('finOrcNovaCat'); if (!s) return;
+    s.innerHTML = '<option value="">Escolha a categoria</option>' + r.itens.map(function (c) { return '<option value="' + FinOrcTela_esc_(c.codigo) + '">' + FinOrcTela_esc_(c.codigo + ' · ' + c.descricao + ' (' + c.natureza + ')') + '</option>'; }).join('');
+    FinOrcTela_aviso_(''); botao.disabled = false;
+  }, function (m) { botao.disabled = false; FinOrcTela_aviso_(m, 'erro'); });
+}
+function FinOrcTela_importar_(versaoId, botao) {
+  var arq = document.getElementById('finOrcArquivo'), txt = document.getElementById('finOrcCsv');
+  var enviar = function (texto) { if (!String(texto || '').trim()) { FinOrcTela_aviso_('Escolha o arquivo da planilha ou cole o conteúdo.', 'erro'); return; } FinOrcTela_chamar_('OmieOrc_apiImportar', { versaoId: versaoId, texto: texto }, botao); };
+  if (arq && arq.files && arq.files[0]) {
