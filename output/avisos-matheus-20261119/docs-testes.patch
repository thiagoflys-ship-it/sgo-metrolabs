+  assert.equal(L({ esperaMinutos: '45' }).prazoMinutos, 45, 'configurável');
+  const r = ok(amb.api('s_dora', 'regras', {}));
+  assert.equal(r.delegado.regra.esperaMinutos, 0);
+  const g = r.regras;
