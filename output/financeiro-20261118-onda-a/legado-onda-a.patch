+<script>
+/*
+ * Painel financeiro > Contas fixas (Onda A do Financeiro, A1, 18/11/2026). Servidor: SGO_Financeiro_ContasFixas.js (OmieFix_apiTela,
+ * OmieFix_apiSalvar, OmieFix_apiPreparar, OmieFix_apiOcorrencia, OmieFix_apiResumo). O lançamento no Omie é sempre o da aba Lançamentos
+ * e baixas (prévia e confirmação): esta tela só prepara o formulário. Guia e explicação dos campos: JS_Omie_Ajuda.html (OMIE_GUIAS.fixas).
+ */
+var FIN_FIX_TELA = { geracao: 0, dados: null, abertoOc: '' };
+function FinFixTela_esc_(v) { return typeof CadUI_esc_ === 'function' ? CadUI_esc_(v) : String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+function FinFixTela_rpc_(nome, dados, ok, erro) {
+  var g = FIN_FIX_TELA.geracao, sessao = SGO_getSessionId(), pedido = typeof OMIE_TELA !== 'undefined' ? OMIE_TELA.pedido : null;
+  function atual() { return g === FIN_FIX_TELA.geracao && sessao === SGO_getSessionId() && (typeof OMIE_TELA === 'undefined' || pedido === OMIE_TELA.pedido); }
+  google.script.run.withSuccessHandler(function (r) { if (!atual()) return; if (!r || !r.ok) { (erro || FinFixTela_aviso_)(r && r.mensagem || 'Não foi possível concluir. Tente de novo.'); return; } ok(r); })
+    .withFailureHandler(function () { if (atual()) (erro || FinFixTela_aviso_)('A comunicação com o servidor foi interrompida. Nada foi alterado; abra a aba de novo.'); })[nome](sessao, dados || {});
+}
+function FinFixTela_aviso_(m, tipo) { var e = document.getElementById('finFixAviso'); if (!e) return; e.textContent = m || ''; e.className = 'fin-fix-aviso' + (m && tipo ? ' is-' + tipo : ''); }
+function FinFixTela_render_() {
+  var c = document.getElementById('omieCorpo'); if (!c) return;
+  FIN_FIX_TELA.geracao++; FIN_FIX_TELA.abertoOc = '';
+  c.innerHTML = '<section class="fin-fix"><h3>Contas fixas</h3>' +
+    '<p class="fin-fix-intro">Despesas que se repetem todo mês (aluguel, internet, softwares, contador, seguros). O cadastro fica no SGO+; o lançamento no Omie é sempre feito pela aba Lançamentos e baixas, com a prévia de sempre. ' +
+    'Cada conta do mês aparece em "Para lançar" alguns dias antes do vencimento, e "Preparar lançamento" abre o novo lançamento já preenchido. Nada vai ao Omie sem a sua confirmação. A conta que chega ao vencimento sem ser lançada vira pendência só para a lista de sigilo do Financeiro.</p>' +
+    '<p id="finFixAviso" class="fin-fix-aviso" role="status" aria-live="polite"></p><div id="finFixCorpo">' + (typeof CadUI_esqueleto_ === 'function' ? CadUI_esqueleto_(3) : '<p>Carregando…</p>') + '</div></section>';
+  FinFixTela_carregar_();
+}
+function FinFixTela_carregar_(msg) {
+  FinFixTela_rpc_('OmieFix_apiTela', {}, function (r) { FIN_FIX_TELA.dados = r; FinFixTela_desenhar_(r); FinFixTela_aviso_(msg || '', msg ? 'ok' : ''); },
+    function (m) { var corpo = document.getElementById('finFixCorpo'); if (corpo) corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="alert"><strong>As contas fixas não abriram.</strong><p>' + FinFixTela_esc_(m) + '</p></div>'; });
+}
+function FinFixTela_ocChave_(o) { return o.fixaId + '|' + o.competencia; }
+function FinFixTela_desenhar_(r) {
+  var esc = FinFixTela_esc_, corpo = document.getElementById('finFixCorpo'); if (!corpo) return;
+  var h = '<h4 class="fin-fix-sub">Para lançar</h4>';
+  if (!r.fixas.length) h += '<div class="cadx-vazio bc-vazio" role="status"><strong>Nenhuma conta fixa cadastrada.</strong><p>A lista começa vazia: o sistema não traz contas nem valores prontos. Cadastre abaixo, em "Cadastro das contas fixas", as despesas que se repetem todo mês, com o fornecedor do Omie, a categoria, a conta, o dia e o valor (ou "valor varia").</p></div>';
+  else if (!r.paraLancar.length) h += '<p class="fin-fix-nota">Nada para lançar agora. Cada conta do mês aparece aqui ' + esc(r.antecedencia) + ' dias antes do vencimento.</p>';
+  else h += '<div class="fin-fix-cartoes">' + r.paraLancar.map(function (o, k) {
+    var chave = FinFixTela_ocChave_(o);
+    return '<article class="fin-fix-oc' + (o.dias <= 0 ? ' is-vencida' : '') + '"><div class="fin-fix-oc-cab"><strong>' + esc(o.descricao) + '</strong><span class="fin-fix-selo">' + esc(o.competenciaBr) + '</span></div>' +
+      '<p class="fin-fix-oc-linha">' + esc(o.fornecedor) + '</p><p class="fin-fix-oc-linha"><b>' + esc(o.valorTxt) + '</b> · vencimento ' + esc(o.vencimentoBr) + ' (' + esc(o.prazo) + ')</p>' +
+      (r.podeEditar ? '<div class="fin-fix-oc-acoes"><button type="button" class="cadx-btn cadx-btn-primario" data-fix-preparar="' + esc(chave) + '">Preparar lançamento</button>' +
+        '<button type="button" class="cadx-btn" data-fix-mais="' + esc(chave) + '" data-fix-acao="LANCADA_DIRETO">Já lancei direto no Omie</button><button type="button" class="cadx-btn" data-fix-mais="' + esc(chave) + '" data-fix-acao="DISPENSAR">Dispensar este mês</button></div>' +
+        '<div class="fin-fix-oc-form" id="finFixOcForm' + k + '" data-fix-form="' + esc(chave) + '" hidden></div>' : '<p class="fin-fix-nota">Você vê, mas não lança: falta a caixa "Lançar, alterar e baixar títulos no Omie".</p>') + '</article>';
+  }).join('') + '</div>';
+  h += '<h4 class="fin-fix-sub">Próximos vencimentos (90 dias)</h4>' + (r.proximas.length ? FinFixTela_tabela_(['Conta', 'Mês', 'Vencimento', 'Valor'], r.proximas.map(function (o) { return [o.descricao, o.competenciaBr, o.vencimentoBr, o.valorTxt]; }))
+    : '<p class="fin-fix-nota">Nenhum vencimento previsto nos próximos 90 dias além dos que estão para lançar.</p>');
+  h += '<h4 class="fin-fix-sub">Lançadas e dispensadas (mês passado e este)</h4>' + (r.feitas.length ? '<div class="fin-fix-lista"><table><thead><tr><th>Conta</th><th>Mês</th><th>Situação</th><th>Detalhe</th><th></th></tr></thead><tbody>' + r.feitas.map(function (o) {
+    var det = o.situacao === 'LANCADA' ? (o.forma === 'OMIE_DIRETO' ? 'Lançada direto no Omie, registrada por ' + o.lancadaPor + ' em ' + o.lancadaEm + (o.motivo ? ': ' + o.motivo : '') : 'Lançada pelo SGO+ por ' + o.lancadaPor + ' em ' + o.lancadaEm + (o.titulo ? ' · título ' + o.titulo + ' no Omie' : '') + (o.valorLancadoTxt ? ' · ' + o.valorLancadoTxt : ''))
+      : 'Dispensada por ' + o.dispensadaPor + ' em ' + o.dispensadaEm + ': ' + o.motivo;
+    return '<tr><td data-r="Conta">' + esc(o.descricao) + '</td><td data-r="Mês">' + esc(o.competenciaBr) + '</td><td data-r="Situação">' + esc(o.situacaoNome) + '</td><td data-r="Detalhe">' + esc(det) + '</td><td data-r="Ações">' +
+      (o.podeDesfazer && r.podeEditar ? '<button type="button" class="cadx-btn" data-fix-mais="' + esc(FinFixTela_ocChave_(o)) + '" data-fix-acao="DESFAZER">Desfazer</button><div class="fin-fix-oc-form" data-fix-form="' + esc(FinFixTela_ocChave_(o)) + '" hidden></div>' : '') + '</td></tr>';
+  }).join('') + '</tbody></table></div>' : '<p class="fin-fix-nota">Nenhuma conta lançada ou dispensada no mês passado nem neste.</p>');
+  h += '<h4 class="fin-fix-sub">Cadastro das contas fixas</h4>' + (r.podeEditar ? '<p><button type="button" class="cadx-btn" id="finFixNova" onclick="FinFixTela_form_(null)">Nova conta fixa</button></p>' : '') + '<div id="finFixFormArea"></div>' +
+    (r.fixas.length ? '<div class="fin-fix-lista"><table><thead><tr><th>Conta</th><th>Fornecedor</th><th>Dia</th><th>Valor</th><th>Período</th><th>Situação</th><th></th></tr></thead><tbody>' + r.fixas.map(function (f) {
+      return '<tr><td data-r="Conta">' + esc(f.descricao) + '<br><span class="cadx-sub">' + esc(f.categoriaNome + ' · ' + f.contaNome) + '</span></td><td data-r="Fornecedor">' + esc(f.fornecedorNome) + '</td><td data-r="Dia">' + esc(f.dia) + '</td><td data-r="Valor">' + esc(f.valorTxt) + '</td>' +
+        '<td data-r="Período">' + esc(f.inicioBr + (f.fimBr ? ' a ' + f.fimBr : ' em diante')) + '</td><td data-r="Situação">' + esc(f.situacao) + '</td><td data-r="Ações">' + (r.podeEditar ? '<button type="button" class="cadx-btn" data-fix-alterar="' + esc(f.id) + '">Alterar</button>' : '') + '</td></tr>';
+    }).join('') + '</tbody></table></div>' : '<p class="fin-fix-nota">Nenhuma conta fixa cadastrada ainda.</p>');
+  if (r.historico.length) h += '<details class="fin-fix-hist"><summary>Histórico de alterações (últimas 30)</summary><ul>' + r.historico.map(function (x) {
+    return '<li><b>' + esc(x.em + ' · ' + x.por + ' · ' + x.acao + ' · ' + x.conta) + '</b>' + (x.antes ? '<br>Antes: ' + esc(x.antes) : '') + (x.depois ? '<br>Depois: ' + esc(x.depois) : '') + (x.motivo ? '<br>Motivo: ' + esc(x.motivo) : '') + '</li>';
+  }).join('') + '</ul></details>';
+  corpo.innerHTML = h;
+  corpo.querySelectorAll('[data-fix-preparar]').forEach(function (b) { b.onclick = function () { FinFixTela_preparar_(b.getAttribute('data-fix-preparar'), b); }; });
+  corpo.querySelectorAll('[data-fix-mais]').forEach(function (b) { b.onclick = function () { FinFixTela_ocForm_(b.getAttribute('data-fix-mais'), b.getAttribute('data-fix-acao')); }; });
+  corpo.querySelectorAll('[data-fix-alterar]').forEach(function (b) { b.onclick = function () { FinFixTela_form_(r.fixas.filter(function (f) { return f.id === b.getAttribute('data-fix-alterar'); })[0] || null); }; });
+}
+function FinFixTela_tabela_(cols, linhas) {
+  var esc = FinFixTela_esc_;
+  return '<div class="fin-fix-lista"><table><thead><tr>' + cols.map(function (c) { return '<th>' + esc(c) + '</th>'; }).join('') + '</tr></thead><tbody>' + linhas.map(function (l) { return '<tr>' + l.map(function (v, i) { return '<td data-r="' + esc(cols[i]) + '">' + esc(v) + '</td>'; }).join('') + '</tr>'; }).join('') + '</tbody></table></div>';
+}
+// Dispensar, "já lancei direto no Omie" e desfazer: um campo de motivo aberto dentro do próprio cartão
+function FinFixTela_ocForm_(chave, acao) {
+  var alvo = Array.prototype.filter.call(document.querySelectorAll('[data-fix-form]'), function (x) { return x.getAttribute('data-fix-form') === chave; })[0]; if (!alvo) return;
+  var rot = { DISPENSAR: ['Por que esta conta não será paga neste mês', 'Confirmar a dispensa'], LANCADA_DIRETO: ['O que você conferiu no Omie', 'Registrar como já lançada'], DESFAZER: ['Por que está desfazendo', 'Desfazer'] }[acao];
+  var id = 'finFixMotivoOc' + Math.random().toString(36).slice(2, 7);
+  alvo.hidden = false;
+  alvo.innerHTML = '<label class="cadx-campo" for="' + id + '">' + rot[0] + '<textarea class="cadx-input" id="' + id + '" name="finFixMotivoOc" maxlength="300" data-fix-acao-campo="' + acao + '"></textarea></label>' +
+    '<div class="fin-fix-oc-acoes"><button type="button" class="cadx-btn cadx-btn-primario">' + rot[1] + '</button><button type="button" class="cadx-btn">Cancelar</button></div>';
+  var bts = alvo.querySelectorAll('button');
+  bts[1].onclick = function () { alvo.hidden = true; alvo.innerHTML = ''; };
+  bts[0].onclick = function () {
+    var p = chave.split('|'); bts[0].disabled = true;
+    FinFixTela_rpc_('OmieFix_apiOcorrencia', { fixaId: p[0], competencia: p[1], acao: acao, motivo: document.getElementById(id).value }, function (r) { FinFixTela_carregar_(r.mensagem); }, function (m) { bts[0].disabled = false; FinFixTela_aviso_(m, 'erro'); });
+  };
+  try { document.getElementById(id).focus(); } catch (e) {}
+}
+// "Preparar lançamento": abre Lançamentos e baixas com o novo lançamento preenchido (a confirmação no Omie é lá, com a prévia)
+function FinFixTela_preparar_(chave, botao) {
+  var p = chave.split('|'); if (botao) botao.disabled = true; FinFixTela_aviso_('Preparando o lançamento…');
+  FinFixTela_rpc_('OmieFix_apiPreparar', { fixaId: p[0], competencia: p[1] }, function (r) {
+    var esc = FinFixTela_esc_;
+    OMIE_OPS_UI.tipo = 'pagar'; OMIE_OPS_UI.semListaUmaVez = true;
+    OmieTela_abrir_('lancamentos');
+    OmieOps_form_('criar', 0, r.previo);
+    var ed = document.getElementById('omieOpsEditor'); if (!ed) return;
+    ed.insertAdjacentHTML('afterbegin', '<section class="omie-ped-aviso fin-fix-aviso-lanc"><h4>Conta fixa: ' + esc(r.conta.descricao) + ' (' + esc(r.conta.competenciaBr) + ')</h4><p>O lançamento abaixo veio preenchido do cadastro da conta fixa: fornecedor, documento, ' +
+      (r.conta.variavel ? '' : 'valor, ') + 'vencimento, categoria e conta corrente (' + esc(r.conta.contaNome) + '). ' + (r.conta.variavel ? '<b>O valor desta conta varia: digite o valor deste mês, conforme a fatura.</b> ' : '') +
+      'Confira cada campo, toque em "Conferir prévia" e depois em "Confirmar no Omie". A referência única (FIX-…) impede lançar o mesmo mês duas vezes; confirmado no Omie, o mês sai de "Para lançar" sozinho.</p></section>');
+  }, function (m) { if (botao) botao.disabled = false; FinFixTela_aviso_(m, 'erro'); });
+}
+// Cadastro e alteração (fornecedor pela busca do Omie; categoria e conta pelas listas do Omie)
+function FinFixTela_form_(f) {
+  var area = document.getElementById('finFixFormArea'); if (!area) return;
+  f = f || {}; var esc = FinFixTela_esc_, editar = !!f.id;
+  if (typeof OMIE_OPS_UI !== 'undefined') { OMIE_OPS_UI.tipo = 'pagar'; OMIE_OPS_UI.apoios = {}; }
+  var campo = function (nome, rotulo, tipo, valor, extra) { return '<label class="cadx-campo" for="' + nome + '">' + rotulo + '<input class="cadx-input" id="' + nome + '" name="' + nome + '" type="' + tipo + '" value="' + esc(valor == null ? '' : valor) + '"' + (extra || '') + '></label>'; };
+  area.innerHTML = '<section class="chvx-grupo fin-fix-form"><h4>' + (editar ? 'Alterar a conta fixa' : 'Nova conta fixa') + '</h4><form id="omieFixForm" onsubmit="event.preventDefault();FinFixTela_salvar_()" data-fix-id="' + esc(f.id || '') + '"><div class="fin-fix-grade">' +
+    campo('fixDescricao', 'Descrição', 'text', f.descricao, ' maxlength="120" required') +
+    (typeof OmieCad_campoPessoa_ === 'function' ? OmieCad_campoPessoa_('Fornecedor no Omie', f.fornecedorId, f.fornecedorNome) : '') +
+    (typeof OmieOps_select_ === 'function' ? OmieOps_select_('categorias', 'categoria', 'Categoria de despesa', f.categoria, f.categoriaNome) + OmieOps_select_('contas', 'contaId', 'Conta corrente', f.contaId, f.contaNome) : '') +
+    campo('fixDia', 'Dia do vencimento', 'number', f.dia || '', ' min="1" max="31" step="1" required') +
+    '<label class="cadx-campo" for="fixValorTipo">Valor<select class="cadx-input" id="fixValorTipo" name="fixValorTipo" onchange="FinFixTela_tipoValor_()"><option value="FIXO">Valor fixo</option><option value="VARIAVEL">Valor varia — confirmar no mês</option></select></label>' +
+    campo('fixValor', 'Valor fixo (R$)', 'text', f.valor ? String(f.valor.toFixed ? f.valor.toFixed(2) : f.valor).replace('.', ',') : '', ' inputmode="decimal" placeholder="0,00" maxlength="16"') +
+    campo('fixInicio', 'Início (mês)', 'month', f.inicio || '', ' required') + campo('fixFim', 'Fim (mês, se houver)', 'month', f.fim || '', '') +
+    '</div><label class="cadx-campo" for="fixObs">Observação<textarea class="cadx-input" id="fixObs" name="fixObs" maxlength="300">' + esc(f.observacao || '') + '</textarea></label>' +
+    (editar ? '<label class="cadx-campo" for="fixMotivo">Motivo da alteração<textarea class="cadx-input" id="fixMotivo" name="fixMotivo" maxlength="300" required></textarea></label>' : '') +
+    '<div class="fin-fix-oc-acoes"><button type="submit" class="cadx-btn cadx-btn-primario" id="finFixGravar">' + (editar ? 'Gravar a alteração' : 'Cadastrar a conta fixa') + '</button><button type="button" class="cadx-btn" onclick="FinFixTela_fecharForm_()">Cancelar</button></div></form><div id="omieCadArea"></div></section>';
+  var sel = document.getElementById('fixValorTipo'); if (sel) sel.value = f.valorTipo === 'VARIAVEL' ? 'VARIAVEL' : 'FIXO';
+  FinFixTela_tipoValor_();
+  ['categorias', 'contas'].forEach(function (t) { if (document.getElementById('omieOps_' + t) && typeof OmieOps_apoio_ === 'function') OmieOps_apoio_(t); });
+  try { area.scrollIntoView({ behavior: 'smooth', block: 'start' }); document.getElementById('fixDescricao').focus({ preventScroll: true }); } catch (e) {}
+}
+function FinFixTela_tipoValor_() { var s = document.getElementById('fixValorTipo'), v = document.getElementById('fixValor'); if (!s || !v) return; var fixo = s.value === 'FIXO'; v.disabled = !fixo; v.required = fixo; if (!fixo) v.value = ''; }
+function FinFixTela_fecharForm_() { var a = document.getElementById('finFixFormArea'); if (a) a.innerHTML = ''; }
+function FinFixTela_salvar_() {
+  var form = document.getElementById('omieFixForm'); if (!form || !form.reportValidity()) return;
+  var val = function (n) { var e = form.querySelector('[name="' + n + '"]'); return e ? e.value : ''; };
+  var texto = function (id) { var s = document.getElementById(id); return s && s.selectedIndex >= 0 && s.value ? s.options[s.selectedIndex].textContent : ''; };
+  var esc = document.querySelector('#omieCadEscolhido strong');
+  var d = { id: form.getAttribute('data-fix-id') || '', descricao: val('fixDescricao'), fornecedorId: val('pessoaId'), fornecedorNome: esc ? esc.textContent : '', categoria: val('categoria'), categoriaNome: texto('omieOps_categorias'),
+    contaId: val('contaId'), contaNome: texto('omieOps_contas'), dia: val('fixDia'), valorTipo: val('fixValorTipo'), valor: val('fixValor'), inicio: val('fixInicio'), fim: val('fixFim'), observacao: val('fixObs'), motivo: val('fixMotivo') };
+  if (!d.fornecedorId) { FinFixTela_aviso_('Escolha o fornecedor: digite o CNPJ ou parte do nome, toque em Buscar e depois em "Usar este". Se ele não estiver no Omie, use "Cadastrar no Omie".', 'erro'); var bb = document.getElementById('omieCadBusca'); if (bb) bb.focus(); return; }
+  var b = document.getElementById('finFixGravar'); if (b) b.disabled = true; FinFixTela_aviso_('Gravando…');
+  FinFixTela_rpc_('OmieFix_apiSalvar', d, function (r) { FinFixTela_carregar_(r.mensagem); }, function (m) { if (b) b.disabled = false; FinFixTela_aviso_(m, 'erro'); });
+}
+// Faixa em Lançamentos e baixas: quantas contas fixas estão para lançar (sem valores). Sem a função no servidor, nada aparece.
+function FinFixTela_faixa_() {
+  var alvo = document.getElementById('omieFixFaixa'); if (!alvo) return;
+  google.script.run.withSuccessHandler(function (r) {
+    var a = document.getElementById('omieFixFaixa'); if (a !== alvo || !r || !r.ok || !r.paraLancar) return;
+    a.innerHTML = '<div class="vg-faixa ' + (r.vencidas ? 'is-alerta' : 'is-info') + '" role="status"><b>' + r.paraLancar + (r.paraLancar === 1 ? ' conta fixa para lançar' : ' contas fixas para lançar') + (r.vencidas ? ', ' + r.vencidas + ' já no vencimento' : '') + '.</b> O lançamento sai preenchido a partir do cadastro. <button type="button" class="cadx-btn" onclick="OmieTela_abrir_(\'fixas\')">Abrir Contas fixas</button></div>';
+  }).withFailureHandler(function () {}).OmieFix_apiResumo(SGO_getSessionId(), {});
+}
+</script>
+<style>
+  #omieTela .fin-fix-intro, #omieTela .fin-fix p, #omieTela .fin-fix li { text-align:justify; line-height:1.5; }
+  #omieTela .fin-fix-sub { margin:18px 0 8px; }
+  #omieTela .fin-fix-nota { font-size:13px; color:var(--bc-muted, #475569); }
+  #omieTela .fin-fix-aviso { min-height:1em; margin:0 0 8px; }
+  #omieTela .fin-fix-aviso.is-erro { color:#9b1c1c; font-weight:600; }
