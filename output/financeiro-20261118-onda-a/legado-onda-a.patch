+++ cand23/SGO_Financeiro_ContasFixas.js	2026-11-18 09:56:13.838262900 -0300
@@ -0,0 +1,376 @@
+/**
+ * Painel financeiro > Contas fixas (Onda A do Financeiro, item A1, 18/11/2026).
+ * Especificação: output/financeiro-20261116/especialistas/ESPEC_ONDA2_FINANCEIRO.md, seção 5 (A1) e seção 1.6 (Gantt e previsão).
+ *
+ * O QUE É: cadastro LOCAL (no SGO+) das despesas que se repetem todo mês (aluguel, internet, softwares, contador, seguros), com o
+ * fornecedor, a categoria e a conta corrente do Omie, o dia do vencimento e o valor fixo ou "valor varia — confirmar no mês", e o
+ * mês de início e de fim. A tela começa VAZIA: nenhuma conta real nem valor vem cadastrado (decisão do dono: não inventar dados).
+ *
+ * TODO MÊS: a rotina do Financeiro (FinFix_rodada_, chamada por Ges_rodada_, a mesma das outras rotinas do Painel; sem cron novo)
+ * prepara a conta do mês quando faltam FIN_FIX_ANTECEDENCIA dias para o vencimento (situação PREPARADA). Preparar não grava nada no
+ * Omie: a conta aparece em "Para lançar" e, ao tocar em "Preparar lançamento", abre a aba Lançamentos e baixas com o novo lançamento
+ * já preenchido (fornecedor, documento, valor, vencimento, categoria, conta e a referência única FIX-<conta>-<AAAAMM>). A Wanessa
+ * confere a prévia e confirma; só a confirmação grava no Omie, com as regras de sempre (prévia, alçadas, trilha). O mês da conta
+ * fixa vira LANCADA sozinho quando o Omie confirma (FinFix_registrarLancado_, chamado por OmieOps_apiConfirmar).
+ * Também: "Já lancei direto no Omie" (com o que foi conferido) e "Dispensar este mês" (com o motivo), e desfazer as duas.
+ *
+ * PENDÊNCIA: a conta do mês que chega ao vencimento sem ser lançada vira pendência só para a lista de sigilo do Financeiro (as
+ * pessoas do Financeiro da lista; sem ninguém, a Diretoria da lista), só com a contagem, sem descrição nem valor.
+ *
+ * AGENDA E PREVISÃO: as contas fixas ainda não lançadas entram no Gantt da Agenda financeira e na previsão de caixa de 90 dias
+ * (FinFix_paraPrevisao_, usada por SGO_Financeiro_Agenda.js). Valor variável aparece no Gantt sem valor e fica fora da soma da
+ * previsão (a tela diz quantas ficaram fora). Depois de lançada, a conta já está no Omie e entra pela fotografia (sem contar duas vezes).
+ *
+ * SIGILO: tudo passa por Omie_exigirAcesso_ (lista de sigilo + caixa). Cadastrar, alterar e mexer no mês: FIN_OMIE_LANCAR.
+ * Tabelas: FIN_CONTAS_FIXAS (cadastro; alteração campo a campo, nunca o registro inteiro por cima), FIN_CONTAS_FIXAS_HIST (antes,
+ * depois e motivo de cada mudança) e FIN_FIXAS_MES (uma linha por conta e mês, a partir da preparação).
+ */
+var FIN_FIX_ABA = 'FIN_CONTAS_FIXAS', FIN_FIX_HIST_ABA = 'FIN_CONTAS_FIXAS_HIST', FIN_FIX_MES_ABA = 'FIN_FIXAS_MES';
+var FIN_FIX_COLUNAS = ['ID', 'DESCRICAO', 'FORNECEDOR_ID', 'FORNECEDOR_NOME', 'CATEGORIA', 'CATEGORIA_NOME', 'CONTA_ID', 'CONTA_NOME', 'DIA', 'VALOR_TIPO', 'VALOR', 'INICIO', 'FIM', 'OBSERVACAO',
+  'CRIADO_POR_ID', 'CRIADO_POR_NOME', 'CRIADO_EM', 'ATUALIZADO_POR_NOME', 'ATUALIZADO_EM'];
+var FIN_FIX_HIST_COLUNAS = ['ID', 'FIXA_ID', 'EM', 'POR_ID', 'POR_NOME', 'ACAO', 'ANTES', 'DEPOIS', 'MOTIVO'];
+var FIN_FIX_MES_COLUNAS = ['ID', 'FIXA_ID', 'COMPETENCIA', 'VENCIMENTO', 'VALOR_PREVISTO', 'SITUACAO', 'PREPARADA_EM', 'REFERENCIA', 'TITULO_OMIE', 'VALOR_LANCADO', 'FORMA',
+  'LANCADA_EM', 'LANCADA_POR_ID', 'LANCADA_POR_NOME', 'MOTIVO', 'DISPENSADA_POR_NOME', 'DISPENSADA_EM', 'ATUALIZADO_EM'];
+var FIN_FIX_ANTECEDENCIA = 10;  // dias antes do vencimento em que a conta do mês fica preparada para lançar
+var FIN_FIX_ATRAS_MESES = 3;    // meses para trás que a tela e as pendências consideram
+var FIN_FIX_FUSO = 'America/Sao_Paulo';
+var FIN_FIX_SITUACOES = { PREVISTA: 'Prevista', PREPARADA: 'Para lançar', LANCADA: 'Lançada', DISPENSADA: 'Dispensada neste mês' };
+var FIN_FIX_CAMPOS = { DESCRICAO: 'Descrição', FORNECEDOR_NOME: 'Fornecedor', CATEGORIA_NOME: 'Categoria', CONTA_NOME: 'Conta corrente', DIA: 'Dia do vencimento', VALOR_TIPO: 'Valor', VALOR: 'Valor fixo', INICIO: 'Início', FIM: 'Fim', OBSERVACAO: 'Observação' };
+
+// ------------------------------------------------------------ apoio
+function FinFix_s_(v, max) { return String(v === null || v === undefined ? '' : v).replace(/\s+/g, ' ').trim().slice(0, max || 300); }
+function FinFix_erro_(texto) { var e = new Error(texto); e.omieOpsPublica = true; throw e; }
+function FinFix_letras_(t) { return FinFix_s_(t, 2000).replace(/[^A-Za-zÀ-ÿ]/g, '').length; }
+function FinFix_hoje_(q) { return Utilities.formatDate(q || new Date(), FIN_FIX_FUSO, 'yyyy-MM-dd'); }
+function FinFix_mes_(dia) { return FinFix_s_(dia).slice(0, 7); }
+function FinFix_mesSomar_(mes, n) { var a = +mes.slice(0, 4), m = +mes.slice(5, 7) - 1 + n; a += Math.floor(m / 12); m = ((m % 12) + 12) % 12; return a + '-' + ('0' + (m + 1)).slice(-2); }
+function FinFix_mesBr_(mes) { var m = /^(\d{4})-(\d{2})$/.exec(FinFix_s_(mes)); return m ? m[2] + '/' + m[1] : ''; }
+function FinFix_br_(dia) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(FinFix_s_(dia)); return m ? m[3] + '/' + m[2] + '/' + m[1] : ''; }
+function FinFix_somarDias_(dia, n) { var m = /^(\d{4})-(\d{2})-(\d{2})/.exec(FinFix_s_(dia)); return m ? new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]) + n * 864e5).toISOString().slice(0, 10) : ''; }
+function FinFix_brHora_(iso) { var d = new Date(iso); if (!iso || isNaN(d.getTime())) return ''; try { return Utilities.formatDate(d, FIN_FIX_FUSO, 'dd/MM/yyyy HH:mm'); } catch (e) { return ''; } }
+function FinFix_moeda_(n) {
+  if (n === null || n === undefined || n === '' || !isFinite(Number(n))) return '';
+  if (typeof OmieOps_moeda_ === 'function') return OmieOps_moeda_(n);
+  var v = Math.round(Number(n) * 100) / 100, s = Math.abs(v).toFixed(2).split('.');
+  return (v < 0 ? '-' : '') + 'R$ ' + s[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + s[1];
+}
+/** "1.234,56", "R$ 1234,5", "1234.56" ou número -> número com 2 casas; inválido -> NaN. */
+function FinFix_dinheiro_(v) {
+  if (typeof v === 'number') return isFinite(v) ? Math.round(v * 100) / 100 : NaN;
+  var t = String(v === null || v === undefined ? '' : v).replace(/R\$/gi, '').replace(/\s+/g, '');
+  if (!t) return NaN;
+  if (t.indexOf(',') >= 0) t = t.replace(/\./g, '').replace(',', '.');
+  if (!/^\d+(\.\d{1,2})?$/.test(t)) return NaN;
+  return Math.round(Number(t) * 100) / 100;
+}
+/** Vencimento do mês: o dia cadastrado ou, em mês mais curto, o último dia do mês. */
+function FinFix_vencimento_(mes, dia) {
+  var a = +mes.slice(0, 4), m = +mes.slice(5, 7), ultimo = new Date(Date.UTC(a, m, 0)).getUTCDate(), d = Math.min(Math.max(1, Number(dia) || 1), ultimo);
+  return mes + '-' + ('0' + d).slice(-2);
+}
+function FinFix_garantir_() {
+  if (typeof CertCal_garantirTabela_ === 'function') {
+    CertCal_garantirTabela_(FIN_FIX_ABA, FIN_FIX_COLUNAS);
+    CertCal_garantirTabela_(FIN_FIX_HIST_ABA, FIN_FIX_HIST_COLUNAS);
+    CertCal_garantirTabela_(FIN_FIX_MES_ABA, FIN_FIX_MES_COLUNAS);
+    try { SGO_DATA._headersCache = {}; SGO_DATA._headerMapCache = {}; } catch (e) {}
+  }
+}
+function FinFix_ler_(aba) { try { return SGO_DATA.getDB().getSheetByName(aba) ? SGO_DATA.getAll(aba) : []; } catch (e) { return []; } }
+function FinFix_eu_(s) { s = s || {}; return { id: FinFix_s_(s.userId || s.id, 80), nome: FinFix_s_(s.nome || s.usuario, 80) }; }
+function FinFix_resposta_(fn) {
+  try { return Object.assign({ ok: true }, fn()); }
+  catch (e) { return { ok: false, mensagem: e && e.omieOpsPublica ? e.message : 'Não foi possível concluir: ' + FinFix_s_(e && e.message, 160) + '. Nada foi alterado; tente de novo.' }; }
+}
+function FinFix_referencia_(fixaId, mes) { return 'FIX-' + FinFix_s_(fixaId, 40) + '-' + mes.replace('-', ''); }
+function FinFix_documento_(fixaId, mes) { return ('FX' + mes.replace('-', '') + '-' + FinFix_s_(fixaId).replace(/[^0-9A-Za-z]/g, '').slice(0, 4).toUpperCase()).slice(0, 20); }
+
+// ------------------------------------------------------------ cadastro
+function FinFix_fixas_() { return FinFix_ler_(FIN_FIX_ABA).slice().sort(function (a, b) { return (Number(a.DIA) || 0) - (Number(b.DIA) || 0) || FinFix_s_(a.DESCRICAO).localeCompare(FinFix_s_(b.DESCRICAO)); }); }
+function FinFix_fixa_(id) { var f = FinFix_fixas_().filter(function (x) { return FinFix_s_(x.ID) === FinFix_s_(id); })[0]; if (!f) FinFix_erro_('Conta fixa não encontrada. Atualize a tela. Nada foi alterado.'); return f; }
+function FinFix_variavel_(f) { return FinFix_s_(f.VALOR_TIPO).toUpperCase() === 'VARIAVEL'; }
+function FinFix_valorPrevisto_(f) { if (FinFix_variavel_(f)) return null; var v = Number(f.VALOR); return v > 0 ? Math.round(v * 100) / 100 : null; }
+/** Confere e normaliza o formulário. Erro público com o quê, por quê e o que fazer. */
+function FinFix_validar_(d) {
+  d = d || {};
+  var o = { DESCRICAO: FinFix_s_(d.descricao, 120), FORNECEDOR_ID: FinFix_s_(d.fornecedorId, 20), FORNECEDOR_NOME: FinFix_s_(d.fornecedorNome, 160), CATEGORIA: FinFix_s_(d.categoria, 20),
+    CATEGORIA_NOME: FinFix_s_(d.categoriaNome, 120), CONTA_ID: FinFix_s_(d.contaId, 20), CONTA_NOME: FinFix_s_(d.contaNome, 120), DIA: FinFix_s_(d.dia, 2), VALOR_TIPO: FinFix_s_(d.valorTipo, 10).toUpperCase(),
+    VALOR: '', INICIO: FinFix_s_(d.inicio, 7), FIM: FinFix_s_(d.fim, 7), OBSERVACAO: FinFix_s_(d.observacao, 300) };
+  if (FinFix_letras_(o.DESCRICAO) < 3) FinFix_erro_('Escreva a descrição da conta fixa (ex.: "Aluguel da sede", "Internet do escritório"). Nada foi gravado.');
+  if (!/^\d{1,15}$/.test(o.FORNECEDOR_ID) || Number(o.FORNECEDOR_ID) < 1) FinFix_erro_('Escolha o fornecedor no Omie: digite o CNPJ ou parte do nome, toque em Buscar e depois em "Usar este". Sem o fornecedor do Omie, a conta não pode ser lançada. Nada foi gravado.');
+  if (!/^[0-9A-Za-z.\-]{1,20}$/.test(o.CATEGORIA)) FinFix_erro_('Escolha a categoria de despesa do Omie (toque em "Carregar cadastros" se a lista estiver vazia). Nada foi gravado.');
+  if (!/^\d{1,15}$/.test(o.CONTA_ID) || Number(o.CONTA_ID) < 1) FinFix_erro_('Escolha a conta corrente de onde a conta costuma ser paga. Nada foi gravado.');
+  if (!/^\d{1,2}$/.test(o.DIA) || Number(o.DIA) < 1 || Number(o.DIA) > 31) FinFix_erro_('Informe o dia do vencimento, de 1 a 31 (em mês mais curto vale o último dia do mês). Nada foi gravado.');
+  o.DIA = String(Number(o.DIA));
+  if (o.VALOR_TIPO !== 'FIXO' && o.VALOR_TIPO !== 'VARIAVEL') FinFix_erro_('Escolha se o valor é fixo ou se varia e é confirmado todo mês. Nada foi gravado.');
+  if (o.VALOR_TIPO === 'FIXO') {
+    var v = FinFix_dinheiro_(d.valor);
+    if (!(v > 0) || v > 999999999) FinFix_erro_('Informe o valor fixo da conta (ex.: 1.250,00). Se o valor muda todo mês, escolha "Valor varia — confirmar no mês". Nada foi gravado.');
+    o.VALOR = v;
