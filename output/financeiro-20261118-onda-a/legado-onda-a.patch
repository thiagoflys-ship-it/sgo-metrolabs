+  if (r.meses.length) h += '<label for="finFechMes">Mês <select class="cadx-input" id="finFechMes" onchange="FIN_FECH_TELA.competencia=this.value;FinFechTela_carregar_()">' + r.meses.map(function (m) { return '<option value="' + esc(m.competencia) + '"' + (r.atual && r.atual.competencia === m.competencia ? ' selected' : '') + '>' + esc(m.nome + (m.situacao === 'FECHADO' ? ' (fechado)' : ' (aberto)')) + '</option>'; }).join('') + '</select></label>';
