+/* ---------------- Aditivo de recarga em viagem (19/11/2026) ----------------
+ * Durante a viagem apareceu um gasto fora do orçamento (peça, usinagem, hotel a mais): o técnico pede aqui um aditivo de recarga no
+ * cartão Caju. Vai NA HORA para os sócios (Viagem_api, ações aditivo* do SGO+); não fica na fila do aparelho porque depende da decisão
+ * deles: sem sinal, o app diz o que fazer. A mesma tela existe no SGO+ (Depósito de viagem > Aditivos de recarga).
+ */
+const ADT = { ctx: null, erro: "" };
+async function telaAditivo() {
+  ADT.erro = "";
+  if (navigator.onLine === false) return `<div class="aviso alerta"><p><strong>Sem internet agora.</strong> O aditivo vai na hora para os sócios, por isso precisa de sinal.</p><p>O que fazer: procure sinal (ou o Wi-Fi do cliente) e toque em "Tentar de novo". Se for urgente e não houver sinal, ligue para o seu gestor.</p></div><button type="button" class="bt primario" data-acao="irAditivo">Tentar de novo</button><button type="button" class="bt" data-acao="irDia">Voltar ao Meu dia</button>`;
+  let r;
+  try { r = await chamar("Viagem_api", [E.sessao.sessionId, "aditivoContexto", {}]); }
+  catch (e) { return `<div class="aviso erro"><p>Não foi possível abrir os aditivos: ${esc(e.message || e)}</p><p>O que fazer: confira o sinal e tente de novo.</p></div><button type="button" class="bt primario" data-acao="irAditivo">Tentar de novo</button><button type="button" class="bt" data-acao="irDia">Voltar ao Meu dia</button>`; }
+  if (!r || r.ok !== true) return `<div class="aviso erro"><p>${esc((r && r.message) || "O servidor não respondeu.")}</p></div><button type="button" class="bt" data-acao="irDia">Voltar ao Meu dia</button>`;
+  ADT.ctx = r;
+  return htmlAditivo();
+}
+function htmlAditivo(msg) {
+  const c = ADT.ctx || {}, vs = c.viagens || [], meus = (c.aditivos || []).filter((a) => (a.grupos || []).indexOf("meus") >= 0);
+  const op = (lista, atual) => lista.map(([v, t]) => `<option value="${esc(v)}"${v === atual ? " selected" : ""}>${esc(t)}</option>`).join("");
+  const cartao = (a) => `<div class="cartao-adt"><p><strong>${esc(a.numero)}</strong> · ${esc(a.situacaoNome)}${a.urgente && a.aberto ? " · parado aguardando" : ""}</p>
+    <p class="fraco pequeno">${esc(a.categoriaNome)}${a.valorTxt ? " · " + esc(a.valorTxt) : ""}${a.valorAprovadoTxt && a.valorAprovadoTxt !== a.valorTxt ? " · aprovado " + esc(a.valorAprovadoTxt) : ""} · ${esc(a.viagem.numero)} (${esc(a.viagem.destino)})</p>
+    <p class="adt-andamento">${esc(a.andamento)}</p>
+    ${a.info && a.situacao === "INFORMACAO" ? `<p class="aviso alerta">${esc(a.info.por)} pediu: ${esc(a.info.texto)}</p>` : ""}
+    ${a.acoes && a.acoes.complementar && a.acoes.complementar.pode ? `<button type="button" class="bt ${a.situacao === "INFORMACAO" ? "primario" : ""}" data-acao="aditivoResponder" data-adt="${esc(a.id)}">${a.situacao === "INFORMACAO" ? "Responder aos sócios" : "Complementar"}</button>` : ""}
+    ${a.acoes && a.acoes.cancelar && a.acoes.cancelar.pode ? `<button type="button" class="bt" data-acao="aditivoCancelar" data-adt="${esc(a.id)}">Cancelar o aditivo</button>` : ""}</div>`;
+  let h = `<p class="fraco">Apareceu na viagem um gasto fora do orçamento (peça, usinagem, hotel a mais)? Peça aqui um aditivo de recarga no cartão Caju. Um dos sócios decide; aprovado, o Financeiro carrega o valor e você recebe o aviso no celular.</p>`;
