+    return h + `<button type="button" class="bt" data-acao="irDia">Voltar ao Meu dia</button>`;
+  }
+  const urg = c.urgencias || {}, pol = c.politica || {};
+  h += `<h2>Pedir aditivo</h2><form id="fAditivo" novalidate>
+    <label class="rotulo" for="adV">Viagem</label><select class="campo" id="adV">${op(vs.map((v) => [v.id, v.numero + " · " + v.destino + " · " + v.saida + " a " + v.chegada]), vs[0].id)}</select>
+    <p class="fraco pequeno">O crédito vai para o cartão Caju do responsável pelo dinheiro da viagem (${esc(vs[0].responsavel)}).</p>
+    <label class="rotulo" for="adCat">Categoria</label><select class="campo" id="adCat"><option value="">Escolha</option>${op(c.categorias || [], "")}</select>
+    <label class="rotulo" for="adValor">Valor (R$)</label><input class="campo" id="adValor" inputmode="decimal" placeholder="Ex.: 350,00">
+    <label class="rotulo" for="adJust">Para que é</label><textarea class="campo" id="adJust" rows="4" maxlength="1500" placeholder="Ex.: ${esc(c.exemplo || "")}"></textarea>
