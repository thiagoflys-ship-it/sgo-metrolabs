+    <input class="campo" id="adFoto" type="file" accept="image/*">
+    ${ADT.erro ? `<div class="aviso erro" id="adErro"><p>${esc(ADT.erro)}</p></div>` : ""}
+    <button type="submit" class="bt primario">Enviar aos sócios</button></form>
+    <button type="button" class="bt" data-acao="irDia">Voltar ao Meu dia</button>`;
+  return h;
+}
+/** Lê a foto (reduzida no aparelho) como base64 para o pedido. */
+async function fotoAditivo(input) {
+  const f = input && input.files && input.files[0];
+  if (!f) return null;
+  const r = await comprimirFoto(f, "Aditivo de recarga · " + new Date().toLocaleString("pt-BR"));
+  const b64 = await new Promise((ok, falha) => { const rd = new FileReader(); rd.onload = () => ok(String(rd.result || "").replace(/^data:[^,]*,/, "")); rd.onerror = () => falha(new Error("O celular não conseguiu ler a foto. Tire de novo.")); rd.readAsDataURL(r.blob); });
+  return { nome: "aditivo-" + Date.now() + ".jpg", tipo: "image/jpeg", base64: b64 };
+}
+async function enviarAditivo(form) {
+  const v = (id) => { const el = $(id); return el ? el.value : ""; };
+  const urg = (form.querySelector('input[name="adUrg"]:checked') || {}).value || "";
+  const btn = form.querySelector('button[type="submit"]'); if (btn) { btn.disabled = true; btn.textContent = "Enviando..."; }
+  try {
+    if (navigator.onLine === false) throw new Error("sem internet agora. Procure sinal e toque em Enviar de novo; o que você escreveu continua na tela.");
+    const foto = await fotoAditivo($("adFoto"));
+    const r = await chamar("Viagem_api", [E.sessao.sessionId, "aditivoPedir", { viagemId: v("adV"), categoria: v("adCat"), valor: v("adValor"), justificativa: v("adJust"), urgencia: urg, repassar: v("adRep"), vinculoRef: v("adRef"), foto }], { prazoMs: 90000 });
+    if (!r || r.ok !== true) throw new Error((r && r.message) || "o servidor não confirmou.");
+    ADT.ctx = r.contexto; ADT.erro = "";
+    if (rotaAtual().tela === "aditivo") $("tela").innerHTML = htmlAditivo(r.message);
+    try { window.scrollTo(0, 0); } catch (e) { /* segue */ }
+  } catch (e) {
+    const m = String((e && e.message) || e);
+    const el = $("adErro") || (() => { const d = document.createElement("div"); d.className = "aviso erro"; d.id = "adErro"; form.insertBefore(d, btn); return d; })();
+    el.innerHTML = `<p>${esc(/^Não foi possível/.test(m) ? m : "Não foi possível enviar: " + m)}</p>`;
+    if (btn) { btn.disabled = false; btn.textContent = "Enviar aos sócios"; }
+  }
+}
+async function acaoAditivo(id, acao, dados) {
+  const r = await chamar("Viagem_api", [E.sessao.sessionId, acao, Object.assign({ id }, dados)], { prazoMs: 90000 });
