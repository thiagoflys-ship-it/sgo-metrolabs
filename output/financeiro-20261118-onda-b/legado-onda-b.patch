diff --git a/cand25/JS_Financeiro_Espelho.html b/cand25/JS_Financeiro_Espelho.html
new file mode 100644
index 0000000..749296d
--- /dev/null
+++ b/cand25/JS_Financeiro_Espelho.html
@@ -0,0 +1,160 @@
+<script>
+/*
+ * Painel financeiro > Compras e Caju no Omie (Onda B do Financeiro, B2, B3 e B4, 18/11/2026). Servidor: SGO_Financeiro_Espelho.js
+ * (OmieEsp_apiTela, OmieEsp_apiPreparar, OmieEsp_apiItem, OmieEsp_apiConferir, OmieEsp_apiResumo). O lançamento no Omie é sempre o da
+ * aba Lançamentos e baixas (prévia e confirmação): esta tela só prepara o formulário e mostra o que bate e o que não bate com o Omie.
+ * Guia e explicação dos campos: JS_Omie_Ajuda.html (OMIE_GUIAS.espelho).
+ */
+var FIN_ESP_TELA = { geracao: 0, dados: null, grupo: '' };
+function FinEspTela_esc_(v) { return typeof CadUI_esc_ === 'function' ? CadUI_esc_(v) : String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
+function FinEspTela_rpc_(nome, dados, ok, erro) {
+  var g = FIN_ESP_TELA.geracao, sessao = SGO_getSessionId(), pedido = typeof OMIE_TELA !== 'undefined' ? OMIE_TELA.pedido : null;
+  function atual() { return g === FIN_ESP_TELA.geracao && sessao === SGO_getSessionId() && (typeof OMIE_TELA === 'undefined' || pedido === OMIE_TELA.pedido); }
+  google.script.run.withSuccessHandler(function (r) { if (!atual()) return; if (!r || !r.ok) { (erro || FinEspTela_aviso_)(r && r.mensagem || 'Não foi possível concluir. Tente de novo.'); return; } ok(r); })
+    .withFailureHandler(function () { if (atual()) (erro || FinEspTela_aviso_)('A comunicação com o servidor foi interrompida. Nada foi alterado; abra a aba de novo.'); })[nome](sessao, dados || {});
+}
+function FinEspTela_aviso_(m, tipo) { var e = document.getElementById('finEspAviso'); if (!e) return; e.textContent = m || ''; e.className = 'fin-esp-aviso' + (m && tipo ? ' is-' + tipo : ''); }
+function FinEspTela_render_() {
+  var c = document.getElementById('omieCorpo'); if (!c) return;
+  FIN_ESP_TELA.geracao++;
+  c.innerHTML = '<section class="fin-esp"><h3>Compras e Caju no Omie</h3>' +
+    '<p class="fin-esp-intro">O SGO+ é o registro principal e o Omie é o espelho. Aqui aparecem as compras faturadas e por boleto já conferidas em Compras, as faturas dos cartões da empresa fechadas na conciliação e as cargas pagas ao Caju (viagens e Recarga Caju, com a taxa de serviço em separado). ' +
+    '"Preparar lançamento" abre a aba Lançamentos e baixas com a conta a pagar preenchida; nada vai ao Omie sem a sua prévia e a sua confirmação, e a referência única impede lançar duas vezes. O pagamento continua passando pela Aprovação de pagamentos (só o dono ou a Diretoria aprovam).</p>' +
+    '<div class="cadx-faixa bc-faixa"><label>Mostrar <select id="finEspGrupo" class="cadx-input"><option value="">Tudo</option><option value="compras">Compras faturadas e por boleto</option><option value="faturas">Faturas dos cartões</option><option value="caju">Cargas do Caju</option></select></label> ' +
+    '<button type="button" class="cadx-btn" id="finEspAtualizar">Atualizar</button> <button type="button" class="cadx-btn" id="finEspConferir">Conferir com o Omie</button></div>' +
+    '<p id="finEspAviso" class="fin-esp-aviso" role="status" aria-live="polite"></p><div id="finEspCorpo">' + (typeof CadUI_esqueleto_ === 'function' ? CadUI_esqueleto_(3) : '<p>Carregando…</p>') + '</div></section>';
+  var sel = document.getElementById('finEspGrupo'); sel.value = FIN_ESP_TELA.grupo;
+  sel.onchange = function () { FIN_ESP_TELA.grupo = sel.value; FinEspTela_carregar_(); };
+  document.getElementById('finEspAtualizar').onclick = function () { FinEspTela_carregar_(); };
+  document.getElementById('finEspConferir').onclick = FinEspTela_conferir_;
+  FinEspTela_carregar_();
+}
+function FinEspTela_carregar_(msg) {
+  FinEspTela_rpc_('OmieEsp_apiTela', { grupo: FIN_ESP_TELA.grupo }, function (r) { FIN_ESP_TELA.dados = r; FinEspTela_desenhar_(r); FinEspTela_aviso_(msg || '', msg ? 'ok' : ''); },
+    function (m) { var corpo = document.getElementById('finEspCorpo'); if (corpo) corpo.innerHTML = '<div class="cadx-vazio bc-vazio" role="alert"><strong>A lista não abriu.</strong><p>' + FinEspTela_esc_(m) + '</p></div>'; });
+}
+function FinEspTela_selo_(x) { return '<span class="fin-esp-selo fin-esp-selo-' + FinEspTela_esc_(x.grupo) + '">' + FinEspTela_esc_(x.tipoNome) + '</span>'; }
+function FinEspTela_tabela_(cols, linhas) {
+  var esc = FinEspTela_esc_;
+  return '<div class="fin-esp-lista"><table><thead><tr>' + cols.map(function (c) { return '<th>' + esc(c) + '</th>'; }).join('') + '</tr></thead><tbody>' + linhas.map(function (l) {
+    return '<tr>' + l.map(function (v, i) { return '<td data-r="' + esc(cols[i]) + '">' + (v && v.html !== undefined ? v.html : esc(v)) + '</td>'; }).join('') + '</tr>';
+  }).join('') + '</tbody></table></div>';
+}
