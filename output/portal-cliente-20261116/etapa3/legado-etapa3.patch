+// REGRAS (Regras do portal; mesma propriedade PCL_REGRAS, com merge e histórico em PCL_REGRAS_HIST)
+// ------------------------------------------------------------
+function PClD_regrasBrutas_() { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(PCL_REGRAS_PROP) || '{}') || {}; } catch (e) { return {}; } }
+function PClD_regras_() {
+  var g = PClD_regrasBrutas_();
+  var l = Array.isArray(g.docTiposVisiveis) ? g.docTiposVisiveis.map(PCl_up_).filter(function (t, i, a) { return PCLD_TIPOS[t] && a.indexOf(t) === i; }) : null;
