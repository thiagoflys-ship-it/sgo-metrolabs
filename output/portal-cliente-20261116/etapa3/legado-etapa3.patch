+}
+function PClD_regrasGuardadas_() { var g = PClD_regrasBrutas_(); return Object.prototype.hasOwnProperty.call(g, 'docTiposVisiveis') ? { docTiposVisiveis: g.docTiposVisiveis } : {}; }
+/** Lê do pedido de "Gravar as regras" (só o que veio muda). d.docTiposVisiveis: lista de códigos de PCLD_TIPOS. */
+function PClD_lerRegras_(d, faltam) {
+  if (!d || d.docTiposVisiveis === undefined) return {};
+  var bruto = Array.isArray(d.docTiposVisiveis) ? d.docTiposVisiveis : PCl_s_(d.docTiposVisiveis).split(',');
