+
+// ------------------------------------------------------------
+// BÁSICOS
+// ------------------------------------------------------------
+function PClD_abaDoc_() { return (SGO_CFG && SGO_CFG.SHEETS && SGO_CFG.SHEETS.DOC_DOCUMENTOS) || 'DOC_DOCUMENTOS'; }
