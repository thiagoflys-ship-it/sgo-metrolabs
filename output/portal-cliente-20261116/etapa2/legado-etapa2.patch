+  #pclTela .pclch-faixa.aviso { background: #FFF6E0; border-left-color: #C98A12; } #pclTela .pclch-faixa.erro { background: #FDECEC; border-left-color: #9B1C1C; }
+  #pclTela .pclch-galeria { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
+  #pclTela .pclch-galeria a { display: block; border: 1px solid var(--bc-line, #E2E0D8); border-radius: 6px; overflow: hidden; text-decoration: none; color: inherit; font-size: 11.5px; min-width: 0; }
+  #pclTela .pclch-galeria img { display: block; width: 100%; height: 90px; object-fit: cover; background: #f2f2f2; }
+  #pclTela .pclch-galeria span { display: block; padding: 3px 5px; overflow-wrap: anywhere; }
