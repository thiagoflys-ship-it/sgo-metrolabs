+++ b/cand19/SGO_PortalCliente_Troca.js
@@ -0,0 +1,221 @@
+/****************************************************
+ * PORTAL DO CLIENTE — ETAPA 6, TROCA DEFINITIVA (18/11/2026). Especificação: output/portal-cliente-20261116/ESPEC_PORTAL_CLIENTE.md,
+ * "Etapa 6", item 0.1 e seção 5 (o dono aceitou todas as recomendações).
+ *
+ * 1) INÍCIO DO PORTAL (item 4.1.1, ação "inicio"): saudação, situação do acesso, quatro cartões (chamados abertos, próxima visita,
+ *    vencimentos em 30 dias, documentos novos desde a entrada anterior), "O que precisa de você" e os atalhos do papel. Substitui, para a
+ *    conta de cliente, o Início da equipe (central de pendências, painel de índices e alertas).
+ * 2) UNIDADES DA EMPRESA (ação "unidades"): substitui a tela antiga Cadastros > Unidades para o cliente (só os campos públicos).
+ * 3) PONTE DO PORTAL (ação "legado", PCL_LEGADO_CLIENTE): as poucas telas antigas que continuam valendo para o cliente dentro do Portal
+ *    (prontuário por pastas e pelo QR Code, relatório do atendimento e orçamento da Assistência, relatórios de ciclo da lavadora, ajuda
+ *    e busca rápida) passam a ser chamadas pela entrada única do Portal. Lista FECHADA: função fora dela é recusada com o quê, por quê
+ *    e o que fazer. Cada função chamada pela ponte continua com as próprias travas (cliente, unidades, papel).
+ * 4) TRAVA DO LEGADO (item 0.1): com a chave ligada, exigirSessao (SGO_Auth.js) recusa a sessão CLIENTE fora das entradas que ligam
+ *    SGO_PCL_MODULO (PortalCliente_api e a trava de arquivo), no mesmo molde de SGO_REP_MODULO. A CHAVE NASCE DESLIGADA: o servidor está
+ *    em observação do portão desde 18/11/2026 00:16 e a recomendação é ligar só depois de 7 dias de observação e da revisão das funções
+ *    "fora da lista". Ligar e desligar: aba Segurança do Portal (Administrador e Diretoria, com motivo; PClS_salvar_).
+ * 5) LISTA FECHADA MÍNIMA (PCL_FUNCOES_CLIENTE_MINIMA): PortalCliente_api, o básico da sessão e o bate-papo (que já se recusa sozinho à
+ *    conta de cliente e se esconde). Preparada e escolhível na aba Segurança; nasce DESLIGADA (vale a lista de transição).
+ * 6) "PRONTO PARA LIGAR?" (PClT_prontidao_): dias de observação, funções fora da lista chamadas por clientes, o estado das duas travas
+ *    e o passo a passo para ligar e para voltar atrás.
+ * Nenhuma resposta leva Date cru.
+ ****************************************************/
+
+/** Telas do Portal que a conta de cliente usa (a casca troca as telas antigas por estas: JS_PortalCliente_Inicio.html). */
+var PCL_TELAS_CLIENTE = ['portal_cliente_inicio', 'portal_cliente_chamados', 'portal_cliente_documentos', 'portal_cliente_equipamentos', 'portal_cliente_vencimentos',
+  'portal_cliente_indicadores', 'portal_cliente_conta', 'portal_cliente_ciclos'];
+
+/** Lista fechada mínima (para quando a recusa do servidor for ligada com ela): a entrada do Portal e o básico da sessão e da segurança. */
+var PCL_FUNCOES_CLIENTE_MINIMA = [
+  'getSessaoAtual', 'validarSessao', 'logout', 'login', 'getPublicConfig', 'verificarCodigoAcesso', 'reenviarCodigoAcesso', 'trocarSenhaAcesso',
+  'pedirRedefinicaoSenha', 'abrirRedefinicaoSenha', 'codigoRedefinicaoSenha', 'concluirRedefinicaoSenha',
+  'PortalCliente_api',
+  // o bate-papo da equipe se recusa sozinho à conta de cliente ("SEM_ACESSO") e esconde o botão; recusado pelo servidor, mostraria "Sem conexão"
+  'comApi'
+];
+
+/** Mensagem da trava do legado (exigirSessao, SGO_Auth.js): o quê, por quê e o que fazer. */
+var MSG_PCL_FORA_PORTAL = 'Esta parte do SGO+ não faz parte do Portal do cliente. Por quê: o seu acesso de cliente usa só as telas do Portal ' +
+  '(Início, Chamados, Documentos técnicos, Meus equipamentos, Vencimentos e cronograma, Indicadores, Relatórios de ciclo e Minha conta e equipe). ' +
+  'O que fazer: abra o que precisa pelo menu do Portal do cliente; se algo que você usava parou de funcionar, avise a Metrolabs pela Conversa geral (Chamados > Conversa geral).';
+
+/** A trava do legado está ligada? (aba Segurança; nasce desligada). Leitura direta da propriedade, sem gravar nada. */
+function PCl_travaLegadoLigada_() {
+  try {
+    var g = JSON.parse(PropertiesService.getScriptProperties().getProperty(typeof PCL_FUNCOES_PROP !== 'undefined' ? PCL_FUNCOES_PROP : 'PCL_FUNCOES_CFG') || '{}') || {};
+    return g.travaLegado === true;
+  } catch (e) { return false; }
+}
+
+// ------------------------------------------------------------
+// PONTE DO PORTAL (ação "legado")
+// ------------------------------------------------------------
+/**
